<style>
  /* Responsive Scrolling Banner */
  .referral-container {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    width: 100vw;
    max-width: 100vw;
    margin: 0;
    background: rgba(0, 0, 0, 0.95);
    z-index: 10000;
    overflow: hidden;
    white-space: nowrap;
    text-align: center;
    will-change: transform;
    padding: 2px 0;
  }

  #scrollingText {
    display: inline-block;
    white-space: nowrap;
    color: #c0c0c0;
    font-weight: 500;
    font-size: 0.75rem; /* 12px base */
    line-height: 1.2;
  }

  /* Responsive font scaling */
  @media (min-width: 640px) { #scrollingText { font-size: 0.7125rem; } } /* 13px */
  @media (min-width: 768px) { #scrollingText { font-size: 0.675rem; } } /* 14px */
  @media (min-width: 1024px) { #scrollingText { font-size: 0.7375rem; } } /* 15px */

  .fluorescent-amount,
  .fluorescent-amount1 {
    color: #ff073a;
    font-weight: 800;
    text-shadow: 0 0 6px rgba(255, 7, 58, 0.4);
  }

  .referral-code {
    color: #19e54a;
    font-weight: 700;
    letter-spacing: 0.025em;
    text-shadow: 0 0 8px rgba(25, 229, 74, 0.6);
    font-family: 'Courier New', monospace;
  }

  /* Navbar Responsive Styles */
  .navbar {
    position: fixed;
    top: 1.2rem; 
    left: 0;
    right: 0;

    background: rgba(0, 0, 0, 0.95);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(75, 85, 99, 0.3);
    z-index: 9999;
    transition: all 0.3s ease;
  }

  .nav-content {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12rem;
  }

  .nav-left {
    flex-shrink: 0;
  }

  .nav-left a {
    font-size: 2.25rem;
    font-weight: 900;
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-center {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 1.3rem;
    flex-wrap: nowrap;
  }

  .nav-center a,
  .nav-center button {
    font-size: 1.75rem;
    font-weight: 600;
    padding: 0.375rem 0.75rem;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  @media (min-width: 768px) {
    .nav-center a,
    .nav-center button {
      font-size: 0.8125rem;
      padding: 0.3rem 1rem;
    }
  }

  /* Dropdown responsive */
  .dropdown {
    position: relative;
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 140px;
    background: rgba(17, 24, 39, 0.98);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(75, 85, 99, 0.4);
    border-radius: 0.75rem;
    padding: 0.5rem 0;
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.8);
    opacity: 0;
    visibility: hidden;
    transform: translateX(-50%) translateY(-0.5rem);
    transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 100;
    margin-top: 0.25rem;
  }

  .dropdown:hover .dropdown-menu,
  .dropdown-menu.show {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .dropdown-item {
    display: block;
    padding: 0.625rem 1rem;
    color: #d1d5db;
    font-size: 0.75rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.2s ease;
    border-radius: 0.5rem;
    margin: 0 0.25rem;
  }

  .dropdown-item:hover {
    background: rgba(75, 85, 99, 0.4);
    color: #ffffff;
    transform: translateX(4px);
  }

  .nav-right {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-shrink: 0;
  }

  .nav-right a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 0.5rem;
    transition: all 0.2s ease;
    color: #9ca3af;
  }

  .nav-right a:hover {
    background: rgba(75, 85, 99, 0.3);
    color: #ffffff;
    transform: scale(1.05);
  }

  .cart-badge {
    position: absolute;
    top: -0.375rem;
    right: -0.375rem;
    background: #ef4444;
    color: white;
    font-size: 0.625rem;
    font-weight: 800;
    width: 1.25rem;
    height: 1.25rem;
    border-radius: 9999px;
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.25rem;
    animation: pulse 2s infinite;
  }

  /* Mobile hamburger (hidden by default) */
  @media (max-width: 768px) {
    .nav-center {
      display: none;
    }
    
    .nav-left a {
      font-size: 1.125rem;
    }
    
    .nav-content {
      padding: 0.625rem 1rem;
    }
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1); }
    50% { transform: scale(1.1); }
  }

  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }
</style>

<!-- Responsive Scrolling Banner -->
<div class="referral-container">
  <div id="scrollingText"></div>
</div>

<!-- Responsive Navbar -->
<nav class="navbar">
  <div class="nav-content">
    <!-- Logo -->
    <div class="nav-left">
      <a href="/" class="text-xl md:text-2xl font-black">
        <span class="text-white">V</span><span class="text-white">X</span><span class="text-red-600">O</span>R
      </a>
    </div>

    <!-- Center Navigation -->
    <div class="nav-center">
      <a href="/home" class="text-gray-400 hover:text-white">HOME</a>
      
      <!-- Category Dropdown -->
      <div class="dropdown" x-data="{ open: false }">
        <button 
          @click="open = !open"
          class="text-gray-400 hover:text-white font-semibold tracking-wide flex items-center gap-1 group"
        >
          CATEGORY
          <i class="fa-solid fa-chevron-down text-xs group-hover:rotate-180 transition-transform duration-200"></i>
        </button>
        <div class="dropdown-menu" x-show="open" x-transition @click.outside="open = false">
          <% categories.forEach(cat => { %>
            <a href="/product?category=<%= cat.name %>" class="dropdown-item">
              <%= cat.name %>
            </a>
          <% }) %>
        </div>
      </div>

      <!-- Brand Dropdown -->
      <div class="dropdown" x-data="{ open: false }">
        <button 
          @click="open = !open"
          class="text-gray-400 hover:text-white font-semibold tracking-wide flex items-center gap-1 group"
        >
          BRAND
          <i class="fa-solid fa-chevron-down text-xs group-hover:rotate-180 transition-transform duration-200"></i>
        </button>
        <div class="dropdown-menu" x-show="open" x-transition @click.outside="open = false">
          <% brands.forEach(brand => { %>
            <a href="/product?brand=<%= brand.name %>" class="dropdown-item">
              <%= brand.name %>
            </a>
          <% }) %>
        </div>
      </div>

      <a href="/about" class="text-gray-400 hover:text-white">ABOUT</a>
      <a href="/contact" class="text-gray-400 hover:text-white">CONTACT</a>
    </div>

    <!-- Right Icons -->
    <div class="nav-right">
      <a href="/profile?section=wishlist" title="Wishlist">
        <i class="fa-solid fa-heart text-lg"></i>
      </a>
      
      <!-- Cart -->
     <a href="/cart" class="relative" title="Cart">
  <i class="fas fa-shopping-cart text-lg"></i>
  <span id="cart-count-badge" class="cart-badge" style="display: <%= (locals.cartCount && cartCount > 0) ? 'flex' : 'none' %>;">
    <%= (locals.cartCount) ? cartCount : 0 %>
  </span>
</a>
      
      <a href="/profile" title="Profile">
        <i class="fa-solid fa-user text-lg"></i>
      </a>
    </div>
  </div>
</nav>

<script>
  // 1. GLOBAL FUNCTION: Available to all other scripts
  // Call this function from your 'Add to Cart' logic: window.updateCartBadge(5);
  window.updateCartBadge = function(newCount) {
    const badge = document.getElementById('cart-count-badge');
    if (badge) {
      // Update the number text
      badge.innerText = newCount;
      
      // Show or hide the badge based on the count
      if (newCount > 0) {
        badge.style.display = 'flex';
        
        // Optional: Reset animation to draw attention
        badge.style.animation = 'none';
        badge.offsetHeight; /* Trigger reflow */
        badge.style.animation = 'pulse 2s infinite';
      } else {
        badge.style.display = 'none';
      }
    }
  };

  // 2. PAGE LOAD LOGIC
  document.addEventListener('DOMContentLoaded', () => {
    // --- Scrolling banner animation ---
    const container = document.querySelector('.referral-container');
    const scrollingText = document.getElementById('scrollingText');
    const referralCode = "<%= referralCode || 'VXOR2025' %>";
    const fluorescentAmountForReferrar = "$100";
    const fluorescentAmountForReferrered = "$50";
    
    const messages = [
      "🔒 VXOR Helmets — Certified Safety + Style for Every Rider",
      `👥 Refer & Earn! Share code <span class="referral-code">${referralCode}</span> → Get <span class="fluorescent-amount">${fluorescentAmountForReferrar}</span> per invite`,
      `🎁 New riders! Use any referral code → Instant <span class="fluorescent-amount1">${fluorescentAmountForReferrered}</span> off first helmet`,
      "🏍️ Ride Safe • Shop Smart • VXOR Has Your Back"
    ];
    
    const combinedText = messages.join('   ●   ');
    scrollingText.innerHTML = combinedText;
    
    // Responsive animation speed
    const getSpeed = () => {
      const width = window.innerWidth;
      return width < 640 ? 0.8 : width < 1024 ? 1.2 : 1.8;
    };
    
    let speed = getSpeed();
    let position = container.offsetWidth;
    
    function animate() {
      const containerWidth = container.offsetWidth;
      const textWidth = scrollingText.scrollWidth;
      
      position -= speed;
      if (position < -textWidth) {
        position = containerWidth;
      }
      
      scrollingText.style.transform = `translateX(${position}px)`;
      requestAnimationFrame(animate);
    }
    
    // Update speed on resize
    let animationFrame;
    window.addEventListener('resize', () => {
      speed = getSpeed();
      position = container.offsetWidth;
      if (animationFrame) cancelAnimationFrame(animationFrame);
    });
    
    animate();
    
    // --- Navbar scroll effect ---
    let lastScroll = 0;
    window.addEventListener('scroll', () => {
      const navbar = document.querySelector('.navbar');
      const currentScroll = window.scrollY;
      
      if (currentScroll > 100) {
        navbar.style.background = 'rgba(0, 0, 0, 0.98)';
        navbar.style.backdropFilter = 'blur(30px)';
      } else {
        navbar.style.background = 'rgba(0, 0, 0, 0.95)';
        navbar.style.backdropFilter = 'blur(20px)';
      }
      
      lastScroll = currentScroll;
    });
  });
</script>