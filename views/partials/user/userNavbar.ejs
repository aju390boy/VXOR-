<div class="bg-gray-800 text-white text-center  text-xs fixed top-0 w-full z-10 flex justify-center items-center gap-2">
  <% if (referralCode) { %>
    <span class="font-awesome  text-gray-300 uppercase tracking-wide px-2 py-1 bg-gray-800 rounded shadow-lg">
      Your Referral Code: <%= referralCode %>
    </span>
  <% } else { %>
    <span class="text-gray-400">Referral code not available</span>
  <% } %>
</div>

<nav class="flex justify-between items-center bg-black border-gray-400 py-3 px-6 fixed top-5 w-full z-[9]">
    <div class="nav-left">
        <a class="text-xl font-bold"><span class="text-white">V</span><span class="text-white">X</span><span class="text-red-600">O</span>R</a>
    </div>
    <div class="nav-center flex justify-center flex-grow gap-3">
        <a href="/user/home" class="text-gray-400 font-semibold hover:text-white transition text-sm">HOME</a>
        <a href="/user/product" class="text-gray-400 font-semibold hover:text-white transition text-sm">CATEGORY</a>
        <a href="/user/product" class="text-gray-400 font-semibold hover:text-white transition text-sm">BRAND</a>
        <a href="/user/about" class="text-gray-400 font-semibold hover:text-white transition text-sm">ABOUT</a>
        <a href="/user/contact" class="text-gray-400 font-semibold hover:text-white transition text-sm">CONTACT</a>
    </div>
    <div class="nav-right flex items-center gap-3">
       
        <a href="/user/profile?section=wishlist" class="text-lg"><i class="fa-solid fa-heart"></i></a>
      <a href="/user/cart" class="relative text-gray-300 hover:text-white">
    <i class="fas fa-shopping-cart fa-lg"></i>

    <% if (locals.cartCount && cartCount > 0) { %>
        <span id="cart-count-badge" 
              class="absolute -top-2 -right-3 bg-red-600 text-white text-xs font-bold rounded-full h-5 w-5 flex items-center justify-center">
            <%= cartCount %>
        </span>
    <% } else { %>
        <span id="cart-count-badge" 
              class="hidden absolute -top-2 -right-3 bg-red-600 text-white text-xs font-bold rounded-full h-5 w-5 items-center justify-center">
            0
        </span>
    <% } %>
</a>
        <a href="/user/profile" class="text-lg"><i class="fa-solid fa-user"></i></a>
    </div>
</nav>
