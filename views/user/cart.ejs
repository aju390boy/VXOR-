<div class="bg-gray-900 min-h-screen text-white font-sans">
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Toast Notification HTML -->
    <div id="toast-container" class="fixed top-0 left-1/2 -translate-x-1/2 mt-4 z-50">
        <div id="toast-alert" class="hidden max-w-sm w-full rounded-xl shadow-lg p-2 transition-all duration-300">
            <div class="flex items-center space-x-3">
                <!-- Success Icon -->
                <svg id="toast-icon-success" class="h-8 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <!-- Error Icon -->
                <svg id="toast-icon-error" class="hidden h-8 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <div class="flex-1">
                    <p id="toast-message" class="text-sm font-extrabold"></p>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Custom Modal for Remove Confirmation -->
    <div id="remove-modal" class="fixed inset-0 bg-gray-900 bg-opacity-75 flex items-center justify-center z-50 hidden">
        <div class="bg-gray-800 p-8 rounded-lg shadow-xl max-w-sm w-full text-center">
            <h4 class="text-xl font-bold mb-4">Remove Item?</h4>
            <p class="text-gray-400 mb-6">Are you sure you want to remove this item from your cart?</p>
            <div class="flex justify-center gap-4">
                <button id="cancel-remove-btn" class="px-6 py-2 rounded-lg text-gray-300 bg-gray-700 hover:bg-gray-600 transition-colors">Cancel</button>
                <button id="confirm-remove-btn" class="px-6 py-2 rounded-lg text-white bg-red-600 hover:bg-red-500 transition-colors">Remove</button>
            </div>
        </div>
    </div>

    <!-- Breadcrumb -->
    <div class="px-6 py-4 text-gray-400 text-sm">
        <a href="/" class="hover:text-white">HOME</a> <span class="mx-2">›</span> Cart
    </div>

    <div class="px-6 py-8 flex flex-col lg:flex-row gap-8">
        <% if (cartItems.length > 0) { %>
            <!-- Left Side: Cart Items -->
            <div class="flex-1">
                <h2 class="text-2xl font-semibold mb-6">Your cart</h2>
                <div class="border-b border-gray-700 mb-4"></div>
                
                <% cartItems.forEach(item => { %>
                    <!-- Added conditional class to disable unavailable items -->
                    <div class="flex items-center justify-between mb-6 <%= item.isAvailable ? '' : 'opacity-50' %>">
                        <!-- Product Info -->
                        <div class="flex items-center gap-4">
                            <img src="<%= item.image %>" alt="<%= item.name %>" class="w-20 h-30 object-cover rounded" />
                            <div>
                                <h3 class="text-lg font-medium"><%= item.name %></h3>
                                <p class="text-sm text-gray-400">Size: <%= item.size %></p>
                                <p class="text-sm text-gray-400">Color: <%= item.colorName %></p>
                                <!-- Added conditional message for unavailable items -->
                                <% if (!item.isAvailable) { %>
                                    <p class="text-red-500 font-bold mt-1">Unavailable</p>
                                <% } %>
                            </div>
                        </div>

                        <!-- Price & Quantity -->
                        <div class="flex items-center gap-4">
                            <span class="text-lg font-semibold">₹<%= item.price.toLocaleString() %></span>
                            <!-- New logic: only disable pointer-events on the quantity control block -->
                            <div class="flex items-center border border-gray-700 rounded <%= item.isAvailable ? '' : 'pointer-events-none' %>">
                                <!-- Decrement Button -->
                                <button
                                    class="decrease-quantity-btn px-3 py-1 hover:bg-gray-700 transition-colors duration-200"
                                    data-item-id="<%= item.id %>"
                                    data-stock="<%= item.stock %>"
                                    data-quantity="<%= item.quantity %>"
                                    <%= item.isAvailable ? '' : 'disabled' %>
                                >-</button>
                                <!-- Quantity Display -->
                                <span id="quantity-<%= item.id %>" class="px-3"><%= item.quantity %></span>
                                <!-- Increment Button -->
                                <button
                                    class="increase-quantity-btn px-3 py-1 hover:bg-gray-700 transition-colors duration-200"
                                    data-item-id="<%= item.id %>"
                                    data-stock="<%= item.stock %>"
                                    data-quantity="<%= item.quantity %>"
                                    <%= item.isAvailable ? '' : 'disabled' %>
                                >+</button>
                            </div>
                            <!-- The remove button is now always clickable -->
                            <button class="remove-from-cart-btn text-gray-400 hover:text-red-500 transition-colors duration-200" data-item-id="<%= item.id %>">✕</button>
                        </div>
                    </div>
                <% }) %>
            </div>

            <!-- Right Side: Order Summary -->
            <div class="lg:w-1/3 bg-gray-800 p-6 rounded-lg">
                <h3 class="text-xl font-semibold mb-6">Order Summary</h3>
                <div class="flex justify-between mb-4 text-gray-300">
                    <span>Subtotal</span>
                    <span>₹<%= subtotal.toLocaleString() %></span>
                </div>
                <div class="flex justify-between mb-4 text-gray-300">
                    <span>Shipping</span>
                    <span class="text-green-400">Free</span>
                </div>
                <div class="flex justify-between mb-6 text-gray-300">
                    <span>Tax</span>
                    <span>₹<%= tax.toLocaleString() %></span>
                </div>
                <div class="border-t border-gray-700 mb-6"></div>
                <div class="flex justify-between text-lg font-bold mb-6">
                    <span>Total</span>
                    <span>₹<%= total.toLocaleString() %></span>
                </div>
                <!-- Added id to the checkout button -->
                <button id="checkout-btn" class="w-full bg-purple-900 hover:bg-purple-700 py-3 rounded-lg font-semibold transition-colors">Checkout</button>
                <a href="/" class="block mt-4 text-center text-sm text-gray-400 hover:text-white">Continue Shopping</a>
            </div>
        <% } else { %>
            <!-- Empty Cart State -->
            <div class="w-full flex flex-col items-center justify-center text-center p-12">
                <img src="/images/cart.png" alt="A person pushing a shopping cart in an aisle" class="w-80 h-auto mb-6 rounded-lg shadow-lg" />
                <h2 class="text-2xl font-bold text-gray-200 mb-2">Your cart is empty!</h2>
                <p class="text-gray-400 mb-6">It looks like you haven't added any items to your cart yet. Go ahead and explore our products!</p>
                <a href="/" class="bg-purple-900 hover:bg-purple-700 text-white font-semibold py-3 px-6 rounded-lg transition-colors duration-200">Start Shopping</a>
            </div>
        <% } %>
    </div>
</div>

<style>
    @keyframes slideIn { from { transform: translateY(-100%); } to { transform: translateY(0); } }
    @keyframes fadeOut { from { opacity: 1; } to { opacity: 0; } }
    .animate-slideIn { animation: slideIn 0.3s forwards; }
    .animate-fadeOut { animation: fadeOut 0.5s 2.5s forwards; }
    
    /* Removed pointer-events from the parent div. Now it's only on the quantity control div. */
    .unavailable-item {
        opacity: 0.5;
    }
</style>

<script>
    // New JavaScript for the toast notification and checkout validation
    const toastAlert = document.getElementById('toast-alert');
    const toastMessage = document.getElementById('toast-message');
    const successIcon = document.getElementById('toast-icon-success');
    const errorIcon = document.getElementById('toast-icon-error');
    const removeModal = document.getElementById('remove-modal');
    const confirmRemoveBtn = document.getElementById('confirm-remove-btn');
    const cancelRemoveBtn = document.getElementById('cancel-remove-btn');
    let timeoutId;
    let itemIdToRemove; // Variable to store the ID of the item to be removed

    /**
     * Displays a toast alert with a message and type.
     * @param {string} type - The type of alert ('success' or 'error').
     * @param {string} message - The message to display.
     */
    function showAlert(type, message) {
        clearTimeout(timeoutId);

        toastMessage.textContent = message;
        toastAlert.classList.remove('bg-white', 'bg-green-500', 'bg-red-500');
        toastMessage.classList.remove('text-gray-900', 'text-white');
        successIcon.classList.add('hidden');
        errorIcon.classList.add('hidden');

        if (type === 'success') {
            toastAlert.classList.add('bg-green-500');
            toastMessage.classList.add('text-white');
            successIcon.classList.remove('hidden');
        } else if (type === 'error') {
            toastAlert.classList.add('bg-red-500');
            toastMessage.classList.add('text-white');
            errorIcon.classList.remove('hidden');
        }

        toastAlert.classList.remove('hidden', 'animate-fadeOut');
        void toastAlert.offsetWidth; // Trigger a reflow
        toastAlert.classList.add('animate-slideIn');

        timeoutId = setTimeout(() => {
            toastAlert.classList.add('hidden');
        }, 3000);
    }

    // Function to handle the quantity update API call
    async function updateCartQuantity(itemId, newQuantity) {
        try {
            const response = await fetch(`/user/cart/update-quantity/${itemId}`, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({ quantity: newQuantity }),
            });
            if (!response.ok) {
                console.error('Server response was not ok:', response.status, response.statusText);
                const errorData = await response.text();
                console.error('Server error response:', errorData);
                showAlert('error', 'Failed to update cart. Please try again.');
                return;
            }
            const data = await response.json();
            window.location.reload();
        } catch (error) {
            console.error('Network or parsing error:', error);
            showAlert('error', 'An unexpected error occurred. Please try again.');
        }
    }

    async function removeCartItem(itemId) {
        try {
            const response = await fetch(`/user/cart/remove-item/${itemId}`, {
                method: 'DELETE'
            });
            
            if (!response.ok) {
                console.error('Server response was not ok:', response.status, response.statusText);
                const errorData = await response.text();
                console.error('Server error response:', errorData);
                showAlert('error', 'Failed to remove item. Please try again.');
                return;
            }
            const data = await response.json();
            showAlert('success', 'Item removed from cart.');
            window.location.reload();
        } catch (error) {
            console.error('Network or parsing error:', error);
            showAlert('error', 'An unexpected error occurred. Please try again.');
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        // Parse server-side data for client-side use
        const cartItems = <%- JSON.stringify(cartItems) %>;

        const message = <%- JSON.stringify(message) %>;
        if (message && message.text) {
            showAlert(message.icon, message.text);
        }

        const increaseQuantityBtns = document.querySelectorAll('.increase-quantity-btn');
        const decreaseQuantityBtns = document.querySelectorAll('.decrease-quantity-btn');
        const removeCartItemBtns = document.querySelectorAll('.remove-from-cart-btn');
        const checkoutBtn = document.getElementById('checkout-btn');
        const MAX_QUANTITY = 5;

        // Function to check if any items in the cart are unavailable
        function checkCartForUnavailableItems() {
            return cartItems.some(item => !item.isAvailable);
        }

        // Checkout Button Click Listener
        if (checkoutBtn) {
            checkoutBtn.addEventListener('click', (event) => {
                event.preventDefault(); 
                if (checkCartForUnavailableItems()) {
                    showAlert('error', 'Please remove all unavailable items before proceeding to checkout.');
                } else {
                    window.location.href = '/user/checkout';
                }
            });
        }
    
        increaseQuantityBtns.forEach(button => {
            button.addEventListener('click', () => {
                const itemId = button.dataset.itemId;
                const quantitySpan = document.getElementById(`quantity-${itemId}`);
                const currentQuantity = parseInt(quantitySpan.textContent, 10);
                const maxStock = parseInt(button.dataset.stock, 10);
                const newQuantity = currentQuantity + 1;

                if (newQuantity <= maxStock && newQuantity <= MAX_QUANTITY) {
                    updateCartQuantity(itemId, newQuantity);
                } else {
                    showAlert('error', `Sorry, the selected quantity exceeds available stock or the maximum limit of ${MAX_QUANTITY}.`);
                }
            });
        });

        decreaseQuantityBtns.forEach(button => {
            button.addEventListener('click', () => {
                const itemId = button.dataset.itemId;
                const quantitySpan = document.getElementById(`quantity-${itemId}`);
                const currentQuantity = parseInt(quantitySpan.textContent, 10);
                const newQuantity = currentQuantity - 1;

                if (newQuantity >= 1) {
                    updateCartQuantity(itemId, newQuantity);
                } else {
                    showAlert('error', 'Quantity cannot be less than 1.');
                }
            });
        });

        removeCartItemBtns.forEach(button => {
            button.addEventListener('click', () => {
                itemIdToRemove = button.dataset.itemId;
                removeModal.classList.remove('hidden');
            });
        });

        // Event listeners for the custom removal modal
        if(confirmRemoveBtn) {
            confirmRemoveBtn.addEventListener('click', () => {
                if (itemIdToRemove) {
                    removeCartItem(itemIdToRemove);
                    removeModal.classList.add('hidden');
                }
            });
        }

        if(cancelRemoveBtn) {
            cancelRemoveBtn.addEventListener('click', () => {
                removeModal.classList.add('hidden');
                itemIdToRemove = null;
            });
        }
    });
</script>