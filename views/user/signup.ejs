<main>
    <section class="signup-container">
        <h2>SIGN UP</h2>
        <p>Please fill in the information below.</p>

        <form id="signupForm" action="/signup" method="POST">
            <input type="text" name="firstname" placeholder="First name" required autocomplete="given-name">
            <input type="text" name="lastname" placeholder="Last name" required autocomplete="family-name">
            <input type="text" name="mobile" placeholder="Mobile" required autocomplete="tel">
            <input type="email" name="email" placeholder="E-mail" required autocomplete="username">
            <input type="password" name="password" placeholder="Password" required autocomplete="new-password">
            <input type="password" name="confirmPassword" placeholder="Confirm Password" required autocomplete="new-password">
            <input type="text" name="referralCode" placeholder="Referral Code (optional)">
            <button type="submit">CREATE ACCOUNT</button>
        </form>

        <p class="login-text">Already have an account? <a href="/login">Login</a></p>
    </section>
</main>



<script type="module">
    import throttle from '/js/throttle.js';

    const signupForm = document.getElementById('signupForm');
    const handleSignupSubmit = async (event) => {
        event.preventDefault();
        const formData = new FormData(signupForm);
        const data = Object.fromEntries(formData.entries());

        const errors = [];
        if (!data.firstname || !data.lastname || !data.mobile || !data.email || !data.password || !data.confirmPassword) {
            errors.push('All fields are required.');
        }
        if (data.password !== data.confirmPassword) {
            errors.push('Passwords do not match.');
        }
        const passwordRegex = /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*()_+}{"':;?/>.<,])(.{8,})$/;
        if (data.password && !passwordRegex.test(data.password)) {
            errors.push('Password must be at least 8 characters long and include at least one uppercase letter, one lowercase letter, one number, and one special character.');
        }
        if (data.mobile && !/^\d{10}$/.test(data.mobile)) {
            errors.push('Mobile number must be 10 digits.');
        }
        if (errors.length > 0) {
            Swal.fire({
                icon: 'error',
                title: 'Validation Error!',
                html: errors.join('<br>'),
                customClass: {
                    popup: 'swal-custom-popup',
                    title: 'swal-custom-title',
                    htmlContainer: 'swal-custom-content'
                }
            });
            return; 
        }
        try {
            const response = await fetch('/signup', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });
            const result = await response.json();
            if (result.success) {
                Swal.fire({
                    icon: 'success',
                    title: 'Success!',
                    text: result.message || 'Account created successfully!',
                    showConfirmButton: false,
                    timer: 2000,
                    customClass: {
                        popup: 'swal-custom-popup',
                        title: 'swal-custom-title',
                        htmlContainer: 'swal-custom-content'
                    }
                }).then(() => {
                    if (result.redirectTo) {
                        window.location.href = result.redirectTo;
                    } else {
                        window.location.href = '/login';
                    }
                });
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: result.message || 'Something went wrong!',
                    customClass: { 
                        popup: 'swal-custom-popup',
                        title: 'swal-custom-title',
                        htmlContainer: 'swal-custom-content'
                    }
                });
            }
        } catch (error) {
            console.error('Error during signup:', error);
            Swal.fire({
                icon: 'error',
                title: 'Network Error',
                text: 'Could not connect to the server. Please try again.',
                customClass: {
                    popup: 'swal-custom-popup',
                    title: 'swal-custom-title',
                    htmlContainer: 'swal-custom-content'
                }
            });
        }
    };

    const throttledSignupHandler = throttle(handleSignupSubmit, 5000);
    signupForm.addEventListener('submit', throttledSignupHandler);

    document.addEventListener('DOMContentLoaded', () => {
        const fields = {
            firstname: { element: document.querySelector('input[name="firstname"]'), regex: /^[A-Za-z\s\-\.]+$/ },
            lastname: { element: document.querySelector('input[name="lastname"]'), regex: /^[A-Za-z\s\-\.]+$/ },
            mobile: { element: document.querySelector('input[name="mobile"]'), regex: /^\d{10}$/ },
            email: { element: document.querySelector('input[name="email"]'), regex: /^[^\s@]+@[^\s@]+\.[^\s@]+$/ },
            password: { element: document.querySelector('input[name="password"]'), regex: /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d)(?=.*[!@#$%^&*()_+}{"':;?/>.<,])(.{8,})$/ },
            confirmPassword: { element: document.querySelector('input[name="confirmPassword"]') }
        };

        function validateField(field, value) {
            if (field.regex) {
                return field.regex.test(value);
            }
            return true;
        }

        function updateFieldState(field, isValid) {
            field.element.classList.remove('valid', 'invalid');
            if (isValid) {
                field.element.classList.add('valid');
            } else {
                field.element.classList.add('invalid');
            }
        }

        Object.values(fields).forEach(field => {
            if (field.element) {
                field.element.addEventListener('input', () => {
                    const value = field.element.value.trim();
                    let isValid = validateField(field, value);

                    if (field.element.name === 'confirmPassword') {
                        const password = fields.password.element.value;
                        if (value !== password) {
                            isValid = false;
                        }
                    }

                    updateFieldState(field, isValid);
                });
            }
        });
    });
</script>

