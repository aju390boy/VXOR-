</div>



<script>
    
function openModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.remove('hidden');
            setTimeout(() => {
                const modalContent = modal.querySelector('.transform');
                if (modalContent) {
                    modalContent.classList.remove('scale-95', 'opacity-0');
                    modalContent.classList.add('scale-100', 'opacity-100');
                }
            }, 10);
        }
    }
///////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
    function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            const modalContent = modal.querySelector('.transform');
            if (modalContent) {
                modalContent.classList.remove('scale-100', 'opacity-100');
                modalContent.classList.add('scale-95', 'opacity-0');
            }
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300); 
        }
    }
    //////////////////////////////////////////////////////////////////////////////
    const toastData = <%- JSON.stringify(typeof toastMessage !== 'undefined' ? toastMessage : {}) %>;

   
    const toastContainer = document.getElementById('toast-container');
    const toastAlert = document.getElementById('toast-alert');
    const toastIconSuccess = document.getElementById('toast-icon-success');
    const toastIconError = document.getElementById('toast-icon-error');
    const toastMessageText = document.getElementById('toast-message');

    
    function showToast(icon, text) {
        toastMessageText.textContent = text;
        toastAlert.classList.remove('hidden');
        
        
        toastAlert.classList.remove('bg-green-600', 'bg-red-600');

        if (icon === 'success') {
            toastAlert.classList.add('bg-green-600');
            toastIconSuccess.classList.remove('hidden');
            toastIconError.classList.add('hidden');
        } else if (icon === 'error') {
            toastAlert.classList.add('bg-red-600');
            toastIconSuccess.classList.add('hidden');
            toastIconError.classList.remove('hidden');
        }
        
      
        setTimeout(() => {
            toastAlert.classList.add('hidden');
        }, 5000);
    }

    
    if (toastData && toastData.text) {
        showToast(toastData.icon, toastData.text);
    }
    
    
    const address = <%- JSON.stringify(typeof address !== 'undefined' ? address : null) %>;
    const cartItems = <%- JSON.stringify(typeof cartItems !== 'undefined' ? cartItems : []) %>;
    
   
    const placeOrderBtn = document.getElementById('place-order-btn');

    
    async function handlePlaceOrder() {
       
        if (placeOrderBtn.disabled) {
            console.log("Button is disabled, cannot place order.");
            return;
        }
        
        
        placeOrderBtn.disabled = true;
        placeOrderBtn.classList.add('bg-gray-500', 'cursor-not-allowed');
        placeOrderBtn.classList.remove('bg-green-600', 'hover:bg-green-700');

        try {
            
            const addressId = address ? address._id : null;
            if (!addressId) {
                console.error("Address ID not found. Cannot place order.");
                showToast('error', 'Please select a valid address.');
                return;
            }
            
            
            const response = await fetch('/user/place-order/cod', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json' 
                },
                body: JSON.stringify({
                    addressId: addressId, 
                    cartItems: cartItems
                })
            });

           
            if (response.ok) {
                const result = await response.json();
                console.log('Order placed successfully:', result);
                showToast('success', result.message || 'Order placed successfully!');
                 window.location.href = result.redirectUrl;
               
            } else {
              
                const errorData = await response.json();
                console.error('Failed to place order:', errorData);
                showToast('error', errorData.message || 'An error occurred. Please try again.');
            }
        } catch (error) {
           
            console.error('An error occurred:', error);
            showToast('error', 'Network error. Please check your connection.');
        } finally {
          
            placeOrderBtn.disabled = false;
            placeOrderBtn.classList.remove('bg-gray-500', 'cursor-not-allowed');
            placeOrderBtn.classList.add('bg-green-600', 'hover:bg-green-700');
        }
    }

   
    document.getElementById('place-order-btn').addEventListener('click', handlePlaceOrder);


    ///////////////////////////////////////
    const attachAddAddressFormListener = () => {
            const addNewAddressBtn = document.getElementById('addNewAddressBtn');
            const addAddressForm = document.getElementById('add-address-form');
            if (addNewAddressBtn) {
                addNewAddressBtn.addEventListener('click', () => {
                    openModal('addAddressModal');
                });
            }
            if (addAddressForm) {
                addAddressForm.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    document.querySelectorAll('#add-address-form .error-message').forEach(el => el.textContent = '');
                    document.querySelectorAll('#add-address-form input').forEach(input => input.classList.remove('border-red-500'));
                    const formData = new FormData(addAddressForm);
                    const data = Object.fromEntries(formData.entries());
                    try {
                        const response = await fetch('/user/profile/address/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await response.json();
                        if (response.ok) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: result.message || 'Address added successfully!',
                                 width:'400px',
                                customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                                
                            });
                            closeModal('addAddressModal');
                            addAddressForm.reset();
                            window.location.reload();
                        } else {
                            if (result.errors) {
                                for (const field in result.errors) {
                                    const errorElement = document.getElementById(`${field}Error`);
                                    if (errorElement) {
                                        errorElement.textContent = result.errors[field];
                                        addAddressForm.querySelector(`[name="${field}"]`).classList.add('border-red-500');
                                    }
                                }
                            }
                            Swal.fire({
                                icon: 'error',
                                title: 'Validation Error!',
                                text: result.message || 'Please correct the errors in the form.',
                                 width:'400px',
                                customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                            });
                        }
                    } catch (error) {
                        console.error('Error submitting add address form:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Network Error!',
                            text: 'Could not connect to server.',
                             width:'400px',
                            customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                        });
                    }
                });
            }
        };
//////////////////////////////////////////////////////////////////////////////////
const attachEditAddressFormListener = () => {
    const editAddressForm = document.getElementById('edit-address-form');
    if (editAddressForm && typeof address !== 'undefined' && address) {
        editAddressForm.addEventListener('submit', async (event) => {
            event.preventDefault(); 
            const formData = new FormData(editAddressForm);
            const data = Object.fromEntries(formData.entries());
            const addressId = address._id; 
            try {
                const response = await fetch(`/user/profile/address/edit/${addressId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: result.message || 'Address updated successfully!',
                        width: '400px',
                        customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                    });
                    setTimeout(() => {
