const attachSetDefaultListeners = () => {
    const setDefaultButtons = document.querySelectorAll('.set-default-btn');
    setDefaultButtons.forEach(button => {
        button.addEventListener('click', async () => {
            const addressId = button.dataset.addressId;

            try {
                const response = await fetch(`/user/checkout/address/set-default/${addressId}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                });
                const result = await response.json();
                if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Success!',
                        text: result.message || 'Default address updated.',
                    });
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: result.message || 'Failed to update address.',
                    });
                }
            } catch (error) {
                console.error('Error setting default address:', error);
            }
        });
    });
};
         attachAddAddressFormListener(); 
         attachEditAddressFormListener();
         attachSetDefaultListeners();

</script>