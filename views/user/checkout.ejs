    ///////////////////////////////////////
   // ==========================================
    //  SYSTEM: DYNAMIC REAL-TIME VALIDATION
    // ==========================================
    
    // 1. Strict Rules
    const validators = {
        name: {
            regex: /^[A-Za-z\s\.]{3,}$/,
            error: "Name must be at least 3 letters."
        },
        mobile: {
            regex: /^[6-9]\d{9}$/,
            error: "Enter valid 10-digit mobile number."
        },
        pincode: {
            regex: /^\d{6}$/,
            error: "Pincode must be 6 digits."
        },
        address1: {
            regex: /.+/, 
            error: "Address Line 1 is required."
        },
        city: {
            regex: /.+/,
            error: "City is required."
        },
        state: {
            regex: /.+/,
            error: "State is required."
        }
    };

    // 2. The Instant Check Function
    function validateField(input) {
        const name = input.name;
        const value = input.value.trim();
        const rule = validators[name];

        // Identify the Error Element ID based on which form we are in
        const formPrefix = input.form.id === 'edit-address-form' ? 'edit' : '';
        // If prefix exists, capitalize first letter of name (e.g., editMobileError)
        const errorId = formPrefix 
            ? `${formPrefix}${name.charAt(0).toUpperCase() + name.slice(1)}Error`
            : `${name}Error`;
            
        const errorEl = document.getElementById(errorId);

        // Skip fields we don't validate (like address2 or hidden inputs)
        if (!rule) return true;

        // CHECK VALIDITY
        const isValid = rule.regex.test(value);

        if (isValid) {
            // SCENARIO: User typed correct 10 digits -> SUDDENLY GREEN
            input.classList.remove('border-red-500', 'focus:border-red-500', 'border-gray-600');
            input.classList.add('border-green-500', 'focus:border-green-500'); 
            
            // Hide Error Message
            if (errorEl) errorEl.textContent = ""; 
        } else {
            // SCENARIO: User removed a digit -> SUDDENLY RED
            input.classList.remove('border-green-500', 'focus:border-green-500', 'border-gray-600');
            input.classList.add('border-red-500', 'focus:border-red-500');
            
            // Show Error Message
            if (errorEl) errorEl.textContent = rule.error;
        }

        return isValid;
    }

    // 3. Attach "Input" Listeners (Triggers on every keystroke)
    function attachDynamicValidation(formId) {
        const form = document.getElementById(formId);
        if (!form) return;

        const inputs = form.querySelectorAll('input');
        inputs.forEach(input => {
            // Ignore hidden fields or country
            if (input.type === 'hidden' || input.name === 'country') return;

            // EVENT: 'input' fires immediately when a character is typed or deleted
            input.addEventListener('input', () => validateField(input));
        });
    }

    // 4. Final Check on Submit
    function validateFormOnSubmit(form) {
        let isFormValid = true;
        const inputs = form.querySelectorAll('input');
        inputs.forEach(input => {
             if (input.name === 'address2' || input.type === 'hidden' || input.name === 'country') return;
             // If any field fails validation, mark form as invalid
             if (!validateField(input)) {
                 isFormValid = false;
             }
        });
        return isFormValid;
    }
    // ==========================================
    //  HELPER: PINCODE AUTO-FILL LISTENER
    // ==========================================
    function attachPincodeListener(formId) {
        const form = document.getElementById(formId);
        if (!form) return;

        const pincodeInput = form.querySelector('input[name="pincode"]');
        const cityInput = form.querySelector('input[name="city"]');
        const stateInput = form.querySelector('input[name="state"]');
        const countryInput = form.querySelector('input[name="country"]');

        if (!pincodeInput) return;

        pincodeInput.addEventListener('input', async () => {
            const pin = pincodeInput.value.trim();

            if (pin.length !== 6) {
                if(cityInput) cityInput.value = '';
                if(stateInput) stateInput.value = '';
                return;
            }

            if (/^\d{6}$/.test(pin)) {
                try {
                    if(cityInput) cityInput.placeholder = "Loading...";
                    
                    const res = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
                    const data = await res.json();

                    if (data[0].Status === "Success") {
                        const info = data[0].PostOffice[0];
                        if(cityInput) cityInput.value = info.District || "";
                        if(stateInput) stateInput.value = info.State || "";
                        if(countryInput) countryInput.value = info.Country || "India";
                        
                        // Clear error if valid
                        pincodeInput.classList.remove('border-red-500');
                        const errorEl = form.querySelector(form.id === 'edit-address-form' ? '#editPincodeError' : '#pincodeError');
                        if(errorEl) errorEl.textContent = '';
                    } else {
                        if(cityInput) cityInput.value = '';
                        if(stateInput) stateInput.value = '';
                        const errorEl = form.querySelector(form.id === 'edit-address-form' ? '#editPincodeError' : '#pincodeError');
                        if(errorEl) errorEl.textContent = 'Invalid Pincode';
                    }
                } catch (error) {
                    console.error(error);
                } finally {
                    if(cityInput) cityInput.placeholder = "";
                }
            }
        });
    }

    // ==========================================
    //  UPDATED SUBMIT LISTENERS
    // ==========================================

    const attachAddAddressFormListener = () => {
        const addNewAddressBtn = document.getElementById('addNewAddressBtn');
        const addAddressForm = document.getElementById('add-address-form');
        
        // 1. Attach Pincode Listener
        attachPincodeListener('add-address-form');
        attachDynamicValidation('add-address-form'); // <--- NEW LINE

        if (addNewAddressBtn) {
            addNewAddressBtn.addEventListener('click', () => {
                openModal('addAddressModal');
            });
        }
        if (addAddressForm) {
            addAddressForm.addEventListener('submit', async (event) => {
                event.preventDefault();
                
               // 2. CHECK ALL FIELDS ONE LAST TIME
                if (!validateFormOnSubmit(addAddressForm)) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Invalid Input',
                        text: 'Please fix the red fields before saving.',
                        toast: true, position: 'top-end', timer: 3000, showConfirmButton: false
                    });
                    return;
                }

                const formData = new FormData(addAddressForm);
                const data = Object.fromEntries(formData.entries());
                try {
                    const response = await fetch('/user/profile/address/add', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();
                    if (response.ok) {
                        Swal.fire({
                            icon: 'success', title: 'Success!',
                            text: result.message || 'Address added!',
                            width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                        });
                        closeModal('addAddressModal');
                        addAddressForm.reset();
                        window.location.reload();
                    } else {
                        Swal.fire({
                            icon: 'error', title: 'Error',
                            text: result.message || 'Failed to add address',
                            width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                        });
                    }
                } catch (error) {
                    Swal.fire({ icon: 'error', title: 'Network Error!', text: 'Could not connect.' });
                }
            });
        }
    };

    const attachEditAddressFormListener = () => {
        const editAddressForm = document.getElementById('edit-address-form');
        
        // 1. Attach Pincode Listener
        attachPincodeListener('edit-address-form');
        attachDynamicValidation('edit-address-form'); // <--- NEW LINE

        if (editAddressForm && typeof address !== 'undefined' && address) {
            editAddressForm.addEventListener('submit', async (event) => {
                event.preventDefault(); 
                
               // 2. CHECK ALL FIELDS
                if (!validateFormOnSubmit(editAddressForm)) {
                     Swal.fire({
                        icon: 'error',
                        title: 'Invalid Input',
                        text: 'Please fix the red fields.',
                        toast: true, position: 'top-end', timer: 3000, showConfirmButton: false
                    });
                    return;
                }

                const formData = new FormData(editAddressForm);
                const data = Object.fromEntries(formData.entries());
                const addressId = address._id; 
                try {
                    const response = await fetch(`/user/profile/address/edit/${addressId}`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(data)
                    });
                    const result = await response.json();
                    if (response.ok) {
                        Swal.fire({
                            icon: 'success', title: 'Success!',
                            text: result.message || 'Address updated!',
                            width: '400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                        });
                        setTimeout(() => { window.location.reload(); }, 1500);
                    } else {
                        Swal.fire({ icon: 'error', title: 'Error!', text: result.message || 'Update failed.' });
                    }
                } catch (error) {
                    console.error('Error submitting edit address form:', error);
                }
            });
        }
    };  
