<div class="bg-gray-900 min-h-screen text-white">
    <!-- toast alert -->
    <div id="toast-container" class="fixed top-0 left-1/2 -translate-x-1/2 mt-4 z-50">
        <div id="toast-alert" class="hidden max-w-sm w-full rounded-xl shadow-lg p-2 transition-all duration-300">
            <div class="flex items-center space-x-3">
                <!-- Success Icon -->
                <svg id="toast-icon-success" class="h-8 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <!-- Error Icon -->
                <svg id="toast-icon-error" class="hidden h-8 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <div class="flex-1">
                    <p id="toast-message" class="text-sm font-extrabold"></p>
                </div>
            </div>
        </div>
    </div>
    <!-- Breadcrumb -->
    <div class="px-6 py-4 text-gray-400 text-sm">
        <a href="/" class="hover:text-white">Home</a> <span class="mx-2">›</span> Checkout
    </div>
<!-- ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// -->
     <div class="px-6 py-8 flex flex-col justify-between lg:flex-row gap-8">
                <!-- Left Side: Default Address -->
              <div class=" w-[80%] ">
<!-- /////////////////adresss/////////// -->
  <div class="relative bg-gray-900 rounded-xl p-6 mb-5 bg-gradient-to-br from-gray-800 via-gray-700 to-gray-900
"
     x-data="{ isAddressDropdownOpen: false, isEditing: false }"
     @click.away="isAddressDropdownOpen = false">

    <div class="flex justify-between items-center mb-2 ">
        <h2 class="text-2xl font-bold text-white">Shipping Address</h2>
        <div class="flex items-center gap-2">
            <button id="addNewAddressBtn" type="button" class="text-sm font-medium bg-gradient-to-br from-gray-800 via-gray-700 to-gray-900 rounded-2xl px-3 py-2 hover:text-blue-300 transition-colors">
                ADD
            </button>
            <% if (address) { %>
                <button @click="isAddressDropdownOpen = !isAddressDropdownOpen" title="Change Address" class="p-2.5 bg-gradient-to-br from-gray-800 via-gray-700 to-gray-900 rounded-full hover:text-blue-300 transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                </button>
            <% } %>
        </div>
    </div>

    <% if (address) { %>
        <div x-show="!isEditing">
            <div class="text-gray-300 space-y-1 border-gray-700 pl-4">
                <p class="font-semibold text-white"><%= address.name %></p>
                <p><%= address.address1 %></p>
                <% if (address.address2 && address.address2.trim() !== '') { %><p><%= address.address2 %></p><% } %>
                <p><%= address.city %>, <%= address.state %> - <%= address.pincode %></p>
                <p class="pt-1 font-medium">Mobile: <span class="text-white"><%= address.mobile %></span></p>
            </div>
            <button @click="isEditing = true" class="text-sm font-medium ml-3 mt-1 bg-gradient-to-br from-gray-800 via-gray-700 to-gray-900 rounded-2xl p-2 hover:text-blue-300 transition-colors">
                EDIT
            </button>
        </div>

        <div x-show="isEditing" style="display: none;">
            <form id="edit-address-form" class="space-y-3 pl-4">
                <input type="text" name="name" value="<%= address.name %>" class="w-full bg-gray-700 p-2 rounded-md text-white placeholder-gray-400 focus:outline-none focus:border-blue-500">
                <input type="text" name="address1" value="<%= address.address1 %>" class="w-full bg-gray-700 p-2 rounded-md text-white placeholder-gray-400 focus:outline-none focus:border-blue-500">
                <input type="text" name="address2" value="<%= address.address2 %>" class="w-full bg-gray-700 p-2 rounded-md text-white placeholder-gray-400 focus:outline-none focus:border-blue-500">
                <div class="grid grid-cols-3 gap-2">
                    <input type="text" name="city" value="<%= address.city %>" class="bg-gray-700 p-2 rounded-md text-white placeholder-gray-400 focus:outline-none focus:border-blue-500">
                    <input type="text" name="state" value="<%= address.state %>" class="bg-gray-700 p-2 rounded-md text-white placeholder-gray-400 focus:outline-none focus:border-blue-500">
                    <input type="text" name="pincode" value="<%= address.pincode %>" class="bg-gray-700 p-2 rounded-md text-white placeholder-gray-400 focus:outline-none focus:border-blue-500">
                </div>
                <input type="tel" name="mobile" value="<%= address.mobile %>" class="w-full bg-gray-700 p-2 rounded-md text-white placeholder-gray-400 focus:outline-none focus:border-blue-500">
                
                <div class="flex items-center gap-2 pt-2">
                    <button type="submit" class="text-sm font-medium bg-blue-600 hover:bg-blue-700 rounded-2xl px-3 py-2 text-white transition-colors">
                        Save Changes
                    </button>
                    <button @click="isEditing = false" type="button" class="text-sm font-medium bg-gradient-to-br from-gray-600 to-gray-900 hover:bg-gray-700 rounded-2xl px-3 py-4 ml-2 mt-6 transition-colors">
                        Cancel
                    </button>
                </div>
            </form>
        </div>
    <% } else { %>
        <div class="text-center py-8">
             <p class="text-gray-400 mb-4">No default address found. Please add one.</p>
             <a href="/user/profile" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-2 px-5 rounded-lg transition-colors">Add New Address</a>
        </div>
    <% } %>

    <div x-show="isAddressDropdownOpen" x-transition style="display: none;" class="absolute top-16 right-6 mt-2 w-72 bg-gray-800 border border-gray-700 rounded-lg shadow-xl z-10">
    <div class="p-2 max-h-64 overflow-y-auto">
        <% if (allAddresses && allAddresses.length > 0) { %>
            <% allAddresses.forEach(addr => { %>
                 <% if (!addr.isDefault) { %>
                <div class="block w-full text-left p-3 rounded-md transition-colors <% if (address && addr._id.toString() === address._id.toString()) { %>bg-blue-600/30 text-white<% } else { %>hover:bg-gray-700 text-gray-300<% } %>">
                    <p class="font-semibold"><%= addr.name %></p>
                    
                    
                    <button 
                        type="button"
                        class="set-default-btn bg-gradient-to-br from-purple-900 to-purple-600 p-2 rounded-md text-xs font-bold text-blue-400 hover:text-blue-300 mt-2" 
                        data-address-id="<%= addr._id %>">
                        Set as Default
                    </button>
                </div>
                 <% } %>
            <% }); %>
        <% } else { %>
            <p class="text-center text-sm text-gray-400 p-4">No other addresses saved.</p>
        <% } %>
    </div>
</div>
</div>
   <!-- //////////end address////// -->

    <div class="bg-gray-900 rounded-2xl p-6 mt-2 bg-gradient-to-br from-gray-800 via-gray-700 to-gray-900">
        <h2 class="text-2xl font-bold text-white mb-6 ">Payment Method</h2>
        <div class="space-y-4">
            <div @click="selectedPayment = 'credit_card'" :class="{'border-blue-500 bg-gray-800/50': selectedPayment === 'credit_card', 'border-gray-700': selectedPayment !== 'credit_card'}" >
                <div class="flex items-center">
                    <input type="radio" name="payment_method" value="credit_card" x-model="selectedPayment" class="h-4 w-4 text-blue-600 bg-gray-700 border-gray-600 focus:ring-blue-500">
                    <label class="ml-3 flex items-center gap-4 text-sm font-medium text-white">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M21.928 6.607a1.5 1.5 0 0 0-1.06-.44h-16.736a1.5 1.5 0 0 0-1.06.44l-1.936 1.936v.001a1.5 1.5 0 0 0 0 2.121l1.936 1.936a1.5 1.5 0 0 0 1.06.44h16.736a1.5 1.5 0 0 0 1.06-.44l1.936-1.936v-.001a1.5 1.5 0 0 0 0-2.121zm-2.06 5.557H4.132a1.5 1.5 0 0 0-1.5 1.5v4.203a1.5 1.5 0 0 0 1.5 1.5h15.736a1.5 1.5 0 0 0 1.5-1.5v-4.203a1.5 1.5 0 0 0-1.5-1.5z"/></svg>
                        Credit / Debit Card
                    </label>
                </div>
            </div>
            <div @click="selectedPayment = 'upi'" :class="{'border-blue-500 bg-gray-800/50': selectedPayment === 'upi', 'border-gray-700': selectedPayment !== 'upi'}" >
                <div class="flex items-center">
                    <input type="radio" name="payment_method" value="upi" x-model="selectedPayment" class="h-4 w-4 text-blue-600 bg-gray-700 border-gray-600 focus:ring-blue-500">
                    <label class="ml-3 flex items-center gap-4 text-sm font-medium text-white">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M14.292 2.34l-3.324 7.978h4.064l-4.292 9.342 3.324-7.978h-4.064zM12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12z"/></svg>
                        UPI
                    </label>
                </div>
            </div>
            <div @click="selectedPayment = 'upi'" :class="{'border-blue-500 bg-gray-800/50': selectedPayment === 'upi', 'border-gray-700': selectedPayment !== 'upi'}">
                <div class="flex items-center">
                    <input type="radio" name="payment_method" value="upi" x-model="selectedPayment" class="h-4 w-4 text-blue-600 bg-gray-700 border-gray-600 focus:ring-blue-500">
                    <label class="ml-3 flex items-center gap-4 text-sm font-medium text-white">
                        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M14.292 2.34l-3.324 7.978h4.064l-4.292 9.342 3.324-7.978h-4.064zM12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12z"/></svg>
                        WALLET
                    </label>
                </div>
            </div>
            <% if (isCodAvailable) { %>
                <div @click="selectedPayment = 'cod'" :class="{'border-blue-500 bg-gray-800/50': selectedPayment === 'cod', 'border-gray-700': selectedPayment !== 'cod'}" >
                    <div class="flex items-center">
                        <input type="radio" name="payment_method" value="cod" x-model="selectedPayment" class="h-4 w-4 text-blue-600 bg-gray-700 border-gray-600 focus:ring-blue-500">
                        <label class="ml-3 flex items-center gap-4 text-sm font-medium text-white">
                             <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.627 0-12 5.373-12 12s5.373 12 12 12 12-5.373 12-12-5.373-12-12-12zm0 22c-5.514 0-10-4.486-10-10s4.486-10 10-10 10 4.486 10 10-4.486 10-10 10zm-1.2-12.012c-.255 0-.512.098-.707.293s-.293.452-.293.707v1.012h4v-1.012c0-.255-.098-.512-.293-.707s-.452-.293-.707-.293h-2zm3.2 0c-.441 0-.8.359-.8.8v1.212h-4v-1.212c0-.441-.359-.8-.8-.8s-.8.359-.8.8v1.212h-1c-.552 0-1 .448-1 1v6c0 .552.448 1 1 1h8c.552 0 1-.448 1-1v-6c0-.552-.448-1-1-1h-1v-1.212c0-.441-.359-.8-.8-.8z"/></svg>
                            Cash on Delivery
                        </label>
                    </div>
                </div>
            <% } %>
        </div>
    </div>

</div>
                   <!-- ///////////////////////////////left side end -->

                 <!-- Right Side: Your Order -->
                 <div class="lg:w-1/3 bg-gray-800 p-6 rounded-lg shadow-lg bg-gradient-to-br from-gray-800 via-gray-700 to-gray-900">
                   <h3 class="text-xl font-semibold mb-4">Your Order</h3>

                  <!-- Cart Items -->
                      <div class="space-y-4 mb-4">
                  <% if (cartItems && cartItems.length > 0) { %>
                   <% cartItems.forEach(item => { %>
                    <div class="flex items-center justify-between">
                     <div class="flex items-center gap-3">
                    <%
                        // We need a fallback image path in case something goes wrong
                        let imageUrl = '/images/placeholder.png'; 
                        
                        // Find the color variant for the current item
                        const colorVariant = item.productId.colorVariants.find(c => c.colorName === item.colorName);
                        
                        // If we found the color and it has images, build the correct path
                        if (colorVariant && colorVariant.images && colorVariant.images.length > 0) {
                            imageUrl = `/uploads/products/${colorVariant.images[0]}`;
                        }
                    %>
                    <img src="<%= imageUrl %>" alt="<%= item.productId.title %>" class="w-16 h-22 rounded object-cover " />
                    <div>
                        <p class="text-sm font-medium"><%= item.productId.title %></p>
                        <p class="text-xs text-gray-400">Qty: <%= item.quantity %></p>
                                 </div>
                             </div>
                         <%
                           const itemPrice = item.productId.colorVariants.find(c => c.colorName === item.colorName)?.variants.find(s => s.size === item.size)?.price || 0;
                           %>
                             <span class="text-sm font-semibold">₹<%= (itemPrice * item.quantity).toLocaleString() %></span>
                          </div>
                                  <% }) %>
                                <% } else { %>
                              <p class="text-gray-300">Your cart is empty.</p>
                            <% } %>
                             </div>


            <a href="/user/cart" class="block mb-2 text-sm text-purple-700 font-extrabold hover:underline">Edit Cart</a>

            <!-- Price Details -->
            <div class="space-y-3 text-gray-300">
                <div class="flex justify-between">
                    <span>Subtotal</span>
                    <span>₹<%= subtotal.toLocaleString() %></span>
                </div>
                <div class="flex justify-between">
                    <span>Shipping</span>
                    <span class="text-green-400">Free</span>
                </div>

                <!-- Coupon Input -->
                <div class="flex gap-2 mt-3">
                    <input type="text" placeholder="Coupon code"
                        class="flex-1 bg-gray-700 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    <button class="bg-purple-900 hover:bg-purple-700 px-4 rounded-lg font-medium transition">Apply</button>
                </div>

                <div class="flex justify-between">
                    <span>Coupon Discount</span>
                    <span>- ₹<%= couponDiscount.toLocaleString() %></span>
                </div>
                <div class="flex justify-between">
                    <span>Tax</span>
                    <span>₹<%= tax.toLocaleString() %></span>
                </div>
                <div class="border-t border-gray-700"></div>
                <div class="flex justify-between text-lg font-bold">
                    <span>Total</span>
                    <span>₹<%= total.toLocaleString() %></span>
                </div>
            </div>

            <% const isDisabled = !address || !cartItems || cartItems.length === 0; %>
            <button id="place-order-btn" type="button" class="w-full mt-4 py-3 rounded-lg font-semibold transition
                <%= isDisabled ? 'bg-gray-500 cursor-not-allowed' : 'bg-green-600 hover:bg-green-700' %>"
                <%= isDisabled ? 'disabled' : '' %>>
                Place Order
            </button>
        </div>
    </div>
    <!-- ////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////////// -->
</div>

<!-- add address modal -->
<div id="addAddressModal" class="hidden fixed inset-0 z-50 overflow-y-auto bg-gray-900 bg-opacity-75 transition-opacity duration-300 ease-in-out">
    <div class="flex items-center justify-center min-h-screen p-4">
        <div class="relative bg-gray-800 rounded-lg shadow-xl max-w-md w-full mx-auto p-6 md:p-8 transform scale-95 opacity-0 transition-all duration-300 ease-in-out">
            
            <button type="button" class="absolute top-4 right-4 text-gray-400 hover:text-gray-100 transition-colors duration-200" onclick="closeModal('addAddressModal')">
                <i class="fa-solid fa-xmark fa-lg"></i>
            </button>
            
            <h3 class="text-2xl font-bold text-white mb-6 border-b border-gray-700 pb-3">Add New Address</h3>

            <form id="add-address-form" method="POST" action="/user/profile/address/add">
