    function showToast(icon, text) {
        toastMessageText.textContent = text;
        toastAlert.classList.remove('hidden');
        
        
        toastAlert.classList.remove('bg-green-600', 'bg-red-600');

        if (icon === 'success') {
            toastAlert.classList.add('bg-green-600');
            toastIconSuccess.classList.remove('hidden');
            toastIconError.classList.add('hidden');
        } else if (icon === 'error') {
            toastAlert.classList.add('bg-red-600');
            toastIconSuccess.classList.add('hidden');
            toastIconError.classList.remove('hidden');
        }
        
      
        setTimeout(() => {
            toastAlert.classList.add('hidden');
        }, 5000);
    }

    
    if (toastData && toastData.text) {
        showToast(toastData.icon, toastData.text);
    }
    
    
    const address = <%- JSON.stringify(typeof address !== 'undefined' ? address : null) %>;
    const cartItems = <%- JSON.stringify(typeof cartItems !== 'undefined' ? cartItems : []) %>;
    
   
    const placeOrderBtn = document.getElementById('place-order-btn');
    //////payment integration////////
    async function handlePlaceOrder() {
    if (placeOrderBtn.disabled) return;

    if (!address || !address._id) {
    showToast('error', 'Please add or select a default shipping address.');
    return;
}
const addressId = address._id;

    const selectedPaymentInput = document.querySelector('input[name="paymentMethod"]:checked');
    if (!selectedPaymentInput) {
        showToast('error', 'Please select a payment method.');
        return;
    }
    const paymentMethod = selectedPaymentInput.value;

    placeOrderBtn.disabled = true;
    placeOrderBtn.innerText = 'Processing...';

    // --- LOGIC FOR DIFFERENT PAYMENT METHODS ---
    try {
        // For COD and Wallet, we place the order directly
        if (paymentMethod === 'COD' || paymentMethod === 'WALLET') {
            const response = await fetch('/user/placeorder/place-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ addressId, paymentMethod })
            });

            const result = await response.json();
            if (response.ok) {
                window.location.href = result.redirectUrl;
            } else {
                showToast('error', result.message || 'An error occurred.');
                placeOrderBtn.disabled = false;
                placeOrderBtn.innerText = 'Place Order';
            }

        } else if (paymentMethod === 'razorpay') {
            const createOrderResponse = await fetch('/user/placeorder/create-payment-order', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ addressId, paymentMethod })
            });
            const data = await createOrderResponse.json();
            if (!createOrderResponse.ok) throw new Error(data.message);
            const razorpayOrder = data.order;
            const dbOrderId = data.dbOrderId; 
            const customId = data.customId;
            const options = {
                key: data.keyId,
                amount: razorpayOrder.amount,   
                currency: "INR",
                name: "VIXOR",
                description: "Order Payment",
                order_id: razorpayOrder.id,
                handler: async function (response) {
                    const verifyResponse = await fetch('/user/placeorder/verify-payment', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            payment: response,
                            order: razorpayOrder,
                            dbOrderId: dbOrderId,
                            customId:customId
                        })
                    });
                    const verifyData = await verifyResponse.json();
                    if (verifyData.success) {
                        window.location.href = verifyData.redirectUrl;
                    } else {
                        showToast('error', verifyData.message || 'Payment verification failed.');
                         window.location.href = `/user/payment/failure?orderId=${dbOrderId}&customId=${customId}`;
                    }
                },
                prefill: {
                    name: "<%= user.name %>",
                    email: "<%= user.email %>"
                },
                theme: { color: "#5222D0" }
            };
            
            const rzp1 = new Razorpay(options);
            
            // Add listener for payment failure
            rzp1.on('payment.failed', async function (response) {
                showToast('error', `Payment failed: ${response.error.description}`);
                 placeOrderBtn.disabled = false;
                placeOrderBtn.innerText = 'Place Order';
                try {
        await fetch('/user/payment/order-failed', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ dbOrderId: dbOrderId ,customId:customId}) // Pass the database order ID
        });
    } catch (error) {
        console.error('Could not notify server of payment failure:', error);
    }
    
    // Now redirect to the failure page
    window.location.href = `/user/payment/failure?orderId=${dbOrderId}&customId=${customId}`;
            });

            rzp1.open(); // Open the modal
        }

    } catch (error) {
        console.error('An error occurred during place order:', error);
        showToast('error', 'An unexpected error occurred. Please try again.');
    } finally {
        // Re-enable the button if something goes wrong with Razorpay modal opening
        if (!placeOrderBtn.disabled) { // Check if it wasn't already re-enabled
            placeOrderBtn.disabled = false;
            placeOrderBtn.innerText = 'Place Order';
        }
    }
}
    if (placeOrderBtn) {
    placeOrderBtn.addEventListener('click', handlePlaceOrder);
}
//////////payment integration end ////////////////
    ////////////////////////////////////////////
    if (applyCouponBtn) {
        applyCouponBtn.addEventListener('click', async () => {
            const couponCode = couponCodeInput.value.trim();
            if (!couponCode) {
                showToast('error', 'Please enter a coupon code.');
                return;
            }

            try {
                const response = await fetch('/user/checkout/apply-coupon', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ couponCode: couponCode })
                });

                const data = await response.json();

                if (data.success) {
                    const codeSpan = document.getElementById('appliedCouponCode');
                    const typeSpan = document.getElementById('appliedCouponType');
                    codeSpan.innerText = couponCode.toUpperCase(); 
                   if (data.discountType === 'percentage') {
                     typeSpan.innerText = `(${data.discountValue}% OFF)`;
                  } else { 
                     typeSpan.innerText = `(₹${data.discountValue} OFF)`;
                  }
                    couponDiscountRow.classList.remove('hidden');
                    couponDiscountValue.innerText = `- ₹${data.discountAmount}`;
                    grandTotalValue.innerText = `₹${data.newGrandTotal}`;
                    showToast('success', data.message);
                } else {
                    couponDiscountRow.classList.add('hidden');
                    couponDiscountValue.innerText = '';
                    grandTotalValue.innerText = `₹${data.newGrandTotal}`; // Revert to the total without coupon
                    showToast('error', data.message);
                }
            } catch (error) {
                console.error('Error applying coupon:', error);
                showToast('error', 'Could not apply coupon. Please try again.');
            }
        });
    }
    if (removeCouponBtn) {
    removeCouponBtn.addEventListener('click', async () => {
        try {
            const response = await fetch('/user/checkout/remove-coupon', { method: 'POST' });
            const data = await response.json();
            if (data.success) {
                couponDiscountRow.classList.add('hidden');
                couponDiscountValue.innerText = '';
                couponCodeInput.value = ''; // Clear the input
                grandTotalValue.innerText = `₹${data.newGrandTotal}`;
                showToast('success', data.message);
            } else {
                showToast('error', data.message);
            }
        } catch (error) {
            showToast('error', 'Could not remove coupon.');
        }
    });
}

    ///////////////////////////////////////
    const attachAddAddressFormListener = () => {
            const addNewAddressBtn = document.getElementById('addNewAddressBtn');
            const addAddressForm = document.getElementById('add-address-form');
            if (addNewAddressBtn) {
                addNewAddressBtn.addEventListener('click', () => {
                    openModal('addAddressModal');
                });
            }
            if (addAddressForm) {
                addAddressForm.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    document.querySelectorAll('#add-address-form .error-message').forEach(el => el.textContent = '');
                    document.querySelectorAll('#add-address-form input').forEach(input => input.classList.remove('border-red-500'));
                    const formData = new FormData(addAddressForm);
                    const data = Object.fromEntries(formData.entries());
                    try {
                        const response = await fetch('/user/profile/address/add', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });
                        const result = await response.json();
                        if (response.ok) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: result.message || 'Address added successfully!',
                                 width:'400px',
                                customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                                
                            });
                            closeModal('addAddressModal');
                            addAddressForm.reset();
                            window.location.reload();
                        } else {
                            if (result.errors) {
                                for (const field in result.errors) {
                                    const errorElement = document.getElementById(`${field}Error`);
                                    if (errorElement) {
                                        errorElement.textContent = result.errors[field];
                                        addAddressForm.querySelector(`[name="${field}"]`).classList.add('border-red-500');
                                    }
                                }
                            }
                            Swal.fire({
                                icon: 'error',
                                title: 'Validation Error!',
                                text: result.message || 'Please correct the errors in the form.',
                                 width:'400px',
                                customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                            });
                        }
                    } catch (error) {
                        console.error('Error submitting add address form:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Network Error!',
                            text: 'Could not connect to server.',
                             width:'400px',
                            customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                        });
                    }
                });
            }
        };
