<div class="bg-gray-900 min-h-screen text-white">
    <!-- toast alert -->
    <div id="toast-container" class="fixed top-0 left-1/2 -translate-x-1/2 mt-4 z-50">
        <div id="toast-alert" class="hidden max-w-sm w-full rounded-xl shadow-lg p-2 transition-all duration-300">
            <div class="flex items-center space-x-3">
                <!-- Success Icon -->
                <svg id="toast-icon-success" class="h-8 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <!-- Error Icon -->
                <svg id="toast-icon-error" class="hidden h-8 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                <div class="flex-1">
                    <p id="toast-message" class="text-sm font-extrabold"></p>
                </div>
            </div>
        </div>
    </div>
    <!-- Breadcrumb -->
    <div class="px-6 py-4 text-gray-400 text-sm">
        <a href="/" class="hover:text-white">Home</a> <span class="mx-2">›</span> Checkout
    </div>

    <div class="px-6 py-8 flex flex-col lg:flex-row gap-8">
        <!-- Left Side: Default Address -->
        <div class="flex-1 bg-gray-900 text-white p-8 rounded-2xl shadow-2xl">
    <h2 class="text-3xl font-bold mb-6 pb-4 border-b-2 border-purple-900">Shipping Address</h2>
    
    <% if (address) { %>
        <div class="space-y-8 mb-8">
            <!-- Name -->
            <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 flex  items-center">
                <span class="text-gray-400 font-semibold">Name:</span>
                <span class="text-white mx-4"><%= address.name %></span>
            </div>

            <!-- Address 1 -->
            <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 flex  items-center">
                <span class="text-gray-400 font-semibold">Address 1:</span>
                <span class="text-white text-right mx-4"><%= address.address1 %></span>
            </div>

            <!-- Address 2 (if it exists) -->
            <% if (address.address2 && address.address2.trim() !== '') { %>
                <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 flex  items-center">
                    <span class="text-gray-400 font-semibold">Address 2:</span>
                    <span class="text-white text-right mx-4"><%= address.address2 %></span>
                </div>
            <% } %>

            <!-- City, State, Pincode -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 flex  items-center">
                    <span class="text-gray-400 font-semibold">City:</span>
                    <span class="text-white mx-4"><%= address.city %></span>
                </div>
                <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 flex  items-center">
                    <span class="text-gray-400 font-semibold">State:</span>
                    <span class="text-white mx-4"><%= address.state %></span>
                </div>
                <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 flex items-center">
                    <span class="text-gray-400 font-semibold">Pincode:</span>
                    <span class="text-white mx-4"><%= address.pincode %></span>
                </div>
            </div>

            <!-- Mobile -->
            <div class="bg-gray-800 p-4 rounded-xl border border-gray-700 flex  items-center">
                <span class="text-gray-400 font-semibold">Mobile:</span>
                <span class="text-white mx-4"><%= address.mobile %></span>
            </div>
        </div>

        <a href="/user/profile?section=address" class="block w-full">
            <button class="w-full bg-purple-900 hover:bg-purple-700 px-5 py-3 rounded-xl font-medium transition-colors duration-200">
                Edit Address
            </button>
        </a>
    <% } else { %>
        <div class="text-center text-gray-400 mb-8 p-6 bg-gray-800 rounded-xl border border-gray-700">
            <p>No default address found.</p>
            <p>Please add one to proceed with your order.</p>
        </div>
        <a href="/user/profile" class="inline-block w-full">
            <button class="w-full bg-purple-900 hover:purple-700 px-5 py-3 rounded-xl font-medium transition-colors duration-200">
                Add Address
            </button>
        </a>
    <% } %>
</div>

        <!-- Right Side: Your Order -->
        <div class="lg:w-1/3 bg-gray-800 p-6 rounded-lg shadow-lg">
            <h3 class="text-xl font-semibold mb-6">Your Order</h3>

            <!-- Cart Items -->
           <div class="space-y-4 mb-6">
    <% if (cartItems && cartItems.length > 0) { %>
        <% cartItems.forEach(item => { %>
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <%
                        // We need a fallback image path in case something goes wrong
                        let imageUrl = '/images/placeholder.png'; 
                        
                        // Find the color variant for the current item
                        const colorVariant = item.productId.colorVariants.find(c => c.colorName === item.colorName);
                        
                        // If we found the color and it has images, build the correct path
                        if (colorVariant && colorVariant.images && colorVariant.images.length > 0) {
                            imageUrl = `/uploads/products/${colorVariant.images[0]}`;
                        }
                    %>
                    <img src="<%= imageUrl %>" alt="<%= item.productId.title %>" class="w-12 h-16 rounded object-cover border border-gray-700" />
                    <div>
                        <p class="text-sm font-medium"><%= item.productId.title %></p>
                        <p class="text-xs text-gray-400">Qty: <%= item.quantity %></p>
                    </div>
                </div>
                <%
                    const itemPrice = item.productId.colorVariants.find(c => c.colorName === item.colorName)?.variants.find(s => s.size === item.size)?.price || 0;
                %>
                <span class="text-sm font-semibold">₹<%= (itemPrice * item.quantity).toLocaleString() %></span>
            </div>
        <% }) %>
    <% } else { %>
        <p class="text-gray-300">Your cart is empty.</p>
    <% } %>
</div>


            <a href="/user/cart" class="block mb-6 text-sm text-indigo-400 hover:underline">Edit Cart</a>

            <!-- Price Details -->
            <div class="space-y-3 text-gray-300">
                <div class="flex justify-between">
                    <span>Subtotal</span>
                    <span>₹<%= subtotal.toLocaleString() %></span>
                </div>
                <div class="flex justify-between">
                    <span>Shipping</span>
                    <span class="text-green-400">Free</span>
                </div>

                <!-- Coupon Input -->
                <div class="flex gap-2 mt-3">
                    <input type="text" placeholder="Coupon code"
                        class="flex-1 bg-gray-700 px-3 py-2 rounded-lg focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                    <button class="bg-purple-900 hover:bg-purple-700 px-4 rounded-lg font-medium transition">Apply</button>
                </div>

                <div class="flex justify-between">
                    <span>Coupon Discount</span>
                    <span>- ₹<%= couponDiscount.toLocaleString() %></span>
                </div>
                <div class="flex justify-between">
                    <span>Tax</span>
                    <span>₹<%= tax.toLocaleString() %></span>
                </div>
                <div class="border-t border-gray-700"></div>
                <div class="flex justify-between text-lg font-bold">
                    <span>Total</span>
                    <span>₹<%= total.toLocaleString() %></span>
                </div>
            </div>

            <% const isDisabled = !address || !cartItems || cartItems.length === 0; %>
            <button id="place-order-btn" type="button" class="w-full mt-8 py-3 rounded-lg font-semibold transition
                <%= isDisabled ? 'bg-gray-500 cursor-not-allowed' : 'bg-green-600 hover:bg-green-700' %>"
                <%= isDisabled ? 'disabled' : '' %>>
                Place Order
            </button>
        </div>
    </div>
</div>



<script>
    
    const toastData = <%- JSON.stringify(typeof toastMessage !== 'undefined' ? toastMessage : {}) %>;

   
    const toastContainer = document.getElementById('toast-container');
    const toastAlert = document.getElementById('toast-alert');
    const toastIconSuccess = document.getElementById('toast-icon-success');
    const toastIconError = document.getElementById('toast-icon-error');
    const toastMessageText = document.getElementById('toast-message');

    
    function showToast(icon, text) {
        toastMessageText.textContent = text;
        toastAlert.classList.remove('hidden');
        
        
        toastAlert.classList.remove('bg-green-600', 'bg-red-600');

        if (icon === 'success') {
            toastAlert.classList.add('bg-green-600');
            toastIconSuccess.classList.remove('hidden');
            toastIconError.classList.add('hidden');
        } else if (icon === 'error') {
            toastAlert.classList.add('bg-red-600');
            toastIconSuccess.classList.add('hidden');
            toastIconError.classList.remove('hidden');
        }
        
      
        setTimeout(() => {
            toastAlert.classList.add('hidden');
        }, 5000);
    }

    
    if (toastData && toastData.text) {
        showToast(toastData.icon, toastData.text);
    }
    
    
    const address = <%- JSON.stringify(typeof address !== 'undefined' ? address : null) %>;
    const cartItems = <%- JSON.stringify(typeof cartItems !== 'undefined' ? cartItems : []) %>;
    
   
    const placeOrderBtn = document.getElementById('place-order-btn');

    
    async function handlePlaceOrder() {
       
        if (placeOrderBtn.disabled) {
            console.log("Button is disabled, cannot place order.");
            return;
        }
        
        
        placeOrderBtn.disabled = true;
        placeOrderBtn.classList.add('bg-gray-500', 'cursor-not-allowed');
        placeOrderBtn.classList.remove('bg-green-600', 'hover:bg-green-700');

        try {
            
            const addressId = address ? address._id : null;
            if (!addressId) {
                console.error("Address ID not found. Cannot place order.");
                showToast('error', 'Please select a valid address.');
                return;
            }
            
            
            const response = await fetch('/user/place-order/cod', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json' 
                },
                body: JSON.stringify({
                    addressId: addressId, 
                    cartItems: cartItems
                })
            });

           
            if (response.ok) {
                const result = await response.json();
                console.log('Order placed successfully:', result);
                showToast('success', result.message || 'Order placed successfully!');
                 window.location.href = result.redirectUrl;
               
            } else {
              
                const errorData = await response.json();
                console.error('Failed to place order:', errorData);
                showToast('error', errorData.message || 'An error occurred. Please try again.');
            }
        } catch (error) {
           
            console.error('An error occurred:', error);
            showToast('error', 'Network error. Please check your connection.');
        } finally {
          
            placeOrderBtn.disabled = false;
            placeOrderBtn.classList.remove('bg-gray-500', 'cursor-not-allowed');
            placeOrderBtn.classList.add('bg-green-600', 'hover:bg-green-700');
        }
    }

   
    document.getElementById('place-order-btn').addEventListener('click', handlePlaceOrder);
</script>