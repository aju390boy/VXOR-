<!-- Page wrapper - Enhanced design -->
<div class="w-full bg-gradient-to-br from-black via-gray-950 to-black">
  <!-- Animated top stripe -->
  <div class="border-b border-red-600/20 bg-gradient-to-r from-gray-950/90 via-gray-900/90 to-gray-950/90 backdrop-blur-sm sticky top-0 z-10">
    
  </div>

  <!-- Hero gradient section -->
  <div class="relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-red-900/5 via-transparent to-purple-900/5"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
      
      <!-- Floating particles -->
      <div class="absolute top-10 right-10 hidden lg:block">
        <div class="w-20 h-20 bg-red-500/10 rounded-full blur-xl animate-float"></div>
      </div>
      <div class="absolute bottom-20 left-10 hidden lg:block">
        <div class="w-24 h-24 bg-purple-500/10 rounded-full blur-xl animate-float-slow"></div>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start lg:items-center">
        
        <!-- Left: Hero + Form -->
        <div class="space-y-8 lg:order-2">
          <div class="space-y-4">
            <div class="inline-flex items-center px-4 py-1.5 bg-gradient-to-r from-red-600/20 to-purple-600/20 rounded-full border border-red-500/30 text-sm font-semibold text-red-300">
              <i class="fa-solid fa-message mr-2"></i>
              Get Support Fast
            </div>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black bg-gradient-to-r from-white via-gray-100 to-gray-300 bg-clip-text text-transparent leading-tight">
              Contact <span class="bg-gradient-to-r from-red-400 via-red-500 to-purple-500 bg-clip-text text-transparent">VXOR</span>
            </h1>
            <p class="text-lg md:text-xl text-gray-300 max-w-lg leading-relaxed">
              Need help with orders, returns, sizing, payments or account issues? 
              <span class="text-red-400 font-semibold">Our team responds within 24 hours.</span>
            </p>
          </div>

          <!-- Enhanced Glassmorphism Form -->
          <div class="bg-white/5 backdrop-blur-xl border border-white/10 rounded-3xl p-8 shadow-2xl shadow-black/40 hover:shadow-black/60 transition-all duration-500">
            <form class="space-y-6">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div class="space-y-2">
                  <label class="text-sm font-semibold text-gray-200 flex items-center gap-1">
                    <i class="fa-solid fa-user text-red-400"></i>
                    Full Name
                  </label>
                  <input
                    id="name"
                    type="text"
                    required
                    class="w-full h-14 px-5 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all duration-300 hover:border-white/30"
                    placeholder="John Doe"
                  />
                </div>
                <div class="space-y-2">
                  <label class="text-sm font-semibold text-gray-200 flex items-center gap-1">
                    <i class="fa-solid fa-envelope text-red-400"></i>
                    Email Address
                  </label>
                  <input
                    id="email"
                    type="email"
                    required
                    class="w-full h-14 px-5 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all duration-300 hover:border-white/30"
                    placeholder="john@vxor.shop"
                  />
                </div>
              </div>

              <div class="space-y-2">
                <label class="text-sm font-semibold text-gray-200 flex items-center gap-1">
                  <i class="fa-solid fa-tag text-red-400"></i>
                  Subject
                </label>
                <input
                  id="subject"
                  type="text"
                  required
                  class="w-full h-14 px-5 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-gray-400 focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all duration-300 hover:border-white/30"
                  placeholder="Order issue • Return • Payment • Account..."
                />
              </div>

              <div class="space-y-2">
                <label class="text-sm font-semibold text-gray-200 flex items-center gap-1">
                  <i class="fa-solid fa-comment-dots text-red-400"></i>
                  Message
                </label>
                <textarea
                  id="message"
                  rows="5"
                  required
                  class="w-full px-5 py-4 rounded-2xl bg-white/5 border border-white/20 text-white placeholder-gray-400 resize-vertical focus:outline-none focus:ring-2 focus:ring-red-500/50 focus:border-transparent transition-all duration-300 hover:border-white/30"
                  placeholder="Describe your issue in detail so we can help you faster..."
                ></textarea>
              </div>

              <div class="flex items-start space-x-3 p-4 bg-gray-900/50 rounded-xl border border-gray-800">
                <input id="privacy" type="checkbox" required class="mt-1 h-5 w-5 rounded-lg border-gray-600 bg-gray-800 text-red-500 focus:ring-red-500 mt-0.5">
                <label for="privacy" class="text-sm text-gray-300 leading-relaxed">
                  I agree to VXOR Privacy Policy and Terms. Your data stays secure.
                </label>
              </div>

              <button
                type="submit"
                class="group w-full h-14 bg-gradient-to-r from-red-600 via-red-500 to-purple-600 hover:from-red-500 hover:to-purple-500 text-white font-bold rounded-2xl shadow-2xl shadow-red-500/25 hover:shadow-red-500/40 transform hover:-translate-y-0.5 transition-all duration-300 flex items-center justify-center gap-3 text-lg"
              >
                <span>Send Message</span>
                <i class="fa-solid fa-paper-plane group-hover:translate-x-1 transition-transform duration-300"></i>
              </button>
            </form>
          </div>
        </div>

        <!-- Right: Enhanced Contact Cards -->
        <div class="lg:order-1 space-y-6 lg:pl-8">
