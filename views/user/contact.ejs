          <div class="grid grid-cols-2 gap-4 mb-8">
            <div class="text-center p-6 bg-white/3 backdrop-blur-sm rounded-2xl border border-white/10">
              <div class="text-2xl font-black text-red-400 mb-1">24h</div>
              <div class="text-xs text-gray-400 uppercase tracking-wide">Response Time</div>
            </div>
            <div class="text-center p-6 bg-white/3 backdrop-blur-sm rounded-2xl border border-white/10">
              <div class="text-2xl font-black text-purple-400 mb-1">98%</div>
              <div class="text-xs text-gray-400 uppercase tracking-wide">Issues Resolved</div>
            </div>
          </div>

          <!-- Contact Methods -->
          <div class="space-y-4">
            <!-- Email -->
            <a href="mailto:support@vxor.shop" class="group flex items-start gap-4 p-6 bg-gradient-to-r from-gray-900/50 to-gray-800/50 rounded-2xl border border-white/10 hover:border-red-500/50 hover:bg-red-500/5 transition-all duration-300 hover:-translate-y-1">
              <div class="flex-shrink-0 w-14 h-14 bg-gradient-to-br from-red-500 to-purple-500 rounded-2xl flex items-center justify-center shadow-lg shadow-red-500/30 group-hover:scale-110 transition-transform duration-300">
                <i class="fa-solid fa-envelope text-xl text-white"></i>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-white text-lg mb-1 group-hover:text-red-400 transition-colors">Email Support</h3>
                <p class="text-sm text-gray-300 mb-2 break-all">support@vxor.shop</p>
                <p class="text-xs text-gray-500">Orders • Returns • Payments</p>
              </div>
              <i class="fa-solid fa-arrow-right text-red-400 text-lg group-hover:translate-x-1 transition-transform ml-auto"></i>
            </a>

            <!-- WhatsApp/Phone -->
            <a href="tel:+919876543210" class="group flex items-start gap-4 p-6 bg-gradient-to-r from-gray-900/50 to-gray-800/50 rounded-2xl border border-white/10 hover:border-green-500/50 hover:bg-green-500/5 transition-all duration-300 hover:-translate-y-1">
              <div class="flex-shrink-0 w-14 h-14 bg-gradient-to-br from-green-500 to-emerald-500 rounded-2xl flex items-center justify-center shadow-lg shadow-green-500/30 group-hover:scale-110 transition-transform duration-300">
                <i class="fa-solid fa-phone text-xl text-white"></i>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-white text-lg mb-1 group-hover:text-green-400 transition-colors">WhatsApp / Call</h3>
                <p class="text-sm text-gray-300 mb-2">+91 98765 43210</p>
                <p class="text-xs text-gray-500">Mon-Sat 9AM-6PM IST</p>
              </div>
              <i class="fa-solid fa-arrow-right text-green-400 text-lg group-hover:translate-x-1 transition-transform ml-auto"></i>
            </a>

            <!-- Location -->
            <div class="group flex items-start gap-4 p-6 bg-gradient-to-r from-gray-900/50 to-gray-800/50 rounded-2xl border border-white/10 hover:border-blue-500/50 hover:bg-blue-500/5 transition-all duration-300 hover:-translate-y-1">
              <div class="flex-shrink-0 w-14 h-14 bg-gradient-to-br from-blue-500 to-indigo-500 rounded-2xl flex items-center justify-center shadow-lg shadow-blue-500/30 group-hover:scale-110 transition-transform duration-300">
                <i class="fa-solid fa-location-dot text-xl text-white"></i>
              </div>
              <div class="flex-1 min-w-0">
                <h3 class="font-semibold text-white text-lg mb-1 group-hover:text-blue-400 transition-colors">Visit Us</h3>
                <p class="text-sm text-gray-300 mb-2">VXOR Studio<br>Kochi, Kerala, India</p>
                <p class="text-xs text-gray-500">By appointment only</p>
              </div>
            </div>
          </div>

          <!-- Social Links -->
          <div class="pt-6 border-t border-white/10">
            <h4 class="text-sm font-semibold text-gray-300 mb-4 flex items-center gap-2">
              <i class="fa-solid fa-share-nodes"></i>
              Follow for updates
            </h4>
            <div class="flex gap-3">
              <a href="#" class="group w-12 h-12 bg-white/5 hover:bg-red-500/20 border border-white/10 rounded-2xl flex items-center justify-center text-gray-300 hover:text-red-300 hover:border-red-400 transition-all duration-300">
                <i class="fa-brands fa-instagram text-lg"></i>
              </a>
              <a href="#" class="group w-12 h-12 bg-white/5 hover:bg-blue-500/20 border border-white/10 rounded-2xl flex items-center justify-center text-gray-300 hover:text-blue-300 hover:border-blue-400 transition-all duration-300">
                <i class="fa-brands fa-twitter text-lg"></i>
              </a>
              <a href="#" class="group w-12 h-12 bg-white/5 hover:bg-blue-600/20 border border-white/10 rounded-2xl flex items-center justify-center text-gray-300 hover:text-blue-300 hover:border-blue-500 transition-all duration-300">
                <i class="fa-brands fa-facebook-f text-lg"></i>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
@keyframes float {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-10px); }
}
@keyframes float-slow {
  0%, 100% { transform: translateY(0px); }
  50% { transform: translateY(-15px); }
}
.animate-float { animation: float 6s ease-in-out infinite; }
.animate-float-slow { animation: float-slow 8s ease-in-out infinite; }
</style>
