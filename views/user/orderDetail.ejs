</div>

<!-- Modals for Cancel and Return -->
<div id="cancelModal" class="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50 hidden">
    <div class="bg-white w-full max-w-md mx-auto rounded-2xl shadow-lg p-6 relative">
        <button id="btnCloseCancel" class="absolute top-2 right-3 text-gray-400 hover:text-red-500 text-xl font-bold">×</button>
        <h2 class="text-xl font-semibold mb-4 text-gray-800">Cancel Item</h2>
        <form id="cancelForm" class="space-y-4">
            <input type="hidden" id="cancelOrderId" name="orderId">
            <input type="hidden" id="cancelItemId" name="itemId">
            <div>
                <label for="cancel-note" class="block text-gray-700 mb-1">Reason for Cancellation</label>
                <textarea id="cancel-note" name="cancel-note" rows="4" required class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-500 resize-none" placeholder="Write your reason here..."></textarea>
            </div>
            <div class="flex justify-end">
                <button type="submit" class="bg-red-500 hover:bg-red-600 text-white py-2 px-4 rounded-lg">
                    Submit 
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Return Modal -->
<div id="returnModal" class="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50 hidden">
    <div class="bg-white w-full max-w-md mx-auto rounded-2xl shadow-lg p-6 relative">
        <button id="btnCloseReturn" class="absolute top-2 right-3 text-gray-400 hover:text-red-500 text-xl font-bold">×</button>
        <h2 class="text-xl font-semibold mb-4 text-gray-800">Return Request</h2>
        <form id="returnForm" class="space-y-4">
            <input type="hidden" id="returnOrderId" name="orderId">
            <input type="hidden" id="returnItemId" name="itemId">
            <div>
                <label for="returnNote" class="block text-gray-700 mb-1">Reason for Return</label>
                <textarea id="returnNote" name="returnNote" rows="4" required class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-500 resize-none" placeholder="Write your reason here..."></textarea>
            </div>
            <div class="flex justify-end">
                <button type="submit" class="bg-purple-500 hover:bg-purple-600 text-white py-2 px-4 rounded-lg">
                    Submit Request
                </button>
            </div>
        </form>
    </div>
</div>
<script>
    // --- Generic Modal Handlers ---
    function openModal(modal) {
        if (modal) modal.classList.remove('hidden');
    }
    function closeModal(modal) {
        if (modal) modal.classList.add('hidden');
    }
    
    document.addEventListener('DOMContentLoaded', () => {
        const cancelModal = document.getElementById('cancelModal');
        const returnModal = document.getElementById('returnModal');
        const btnCloseCancel = document.getElementById('btnCloseCancel');
        const btnCloseReturn = document.getElementById('btnCloseReturn');
        const cancelForm = document.getElementById('cancelForm');
        const returnForm = document.getElementById('returnForm');
        document.body.addEventListener('click', (e) => {
            const target = e.target.closest('button, a'); 
            if (!target) return;
            const handleModalOpen = (modal, idField, orderId, itemId = null) => {
                const action = modal === cancelModal ? 'Cancellation' : 'Return';
                Swal.fire({
                    title: `Confirm ${action}`,
                    text: "Are you sure you want to proceed?",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonText: `Yes, request ${action.toLowerCase()}!`,
                  
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById(idField.order).value = orderId;
                        document.getElementById(idField.item).value = itemId || '';
                        openModal(modal);
                    }
                });
            };

            const invoiceBtn = target.closest('.invoice-btn, .single-item-invoice-btn');
           
            if (target.matches('.cancel-item-btn')) {
                handleModalOpen(cancelModal, { order: 'cancelOrderId', item: 'cancelItemId' }, target.dataset.orderId, target.dataset.itemId);
            } else if (target.matches('#cancelEntireOrderBtn')) {
                handleModalOpen(cancelModal, { order: 'cancelOrderId', item: 'cancelItemId' }, target.dataset.orderId);
            } else if (target.matches('.return-item-btn')) {
                handleModalOpen(returnModal, { order: 'returnOrderId', item: 'returnItemId' }, target.dataset.orderId, target.dataset.itemId);
            } else if (target.matches('#returnEntireOrderBtn')) {
                handleModalOpen(returnModal, { order: 'returnOrderId', item: 'returnItemId' }, target.dataset.orderId);
            }
            
         
            else if (target.matches('#retry-btn')) {
               
                window.location.href = '/user/checkout';
            }
            else if (target.matches('.invoice-btn') || target.matches('.single-item-invoice-btn')) {
    e.preventDefault(); 
    const url = target.href;

    Swal.fire({
        title: 'Confirm Download',
        text: 'Are you sure you want to download the invoice?',
        icon: 'question',
        showCancelButton: true,
        confirmButtonText: 'Yes, download it!'
    }).then((result) => {
        if (result.isConfirmed) {
         
            window.location.href = url;
        }
    });
}
            else if (target === btnCloseCancel || target === cancelModal) closeModal(cancelModal);
            else if (target === btnCloseReturn || target === returnModal) closeModal(returnModal);
        });
        const handleFormSubmit = async (form, url, body) => {
            try {
                const response = await fetch(url, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(body)
                });
                const result = await response.json();
                
                if (response.ok) {
                    Swal.fire({ icon: 'success', title: 'Success!', text: result.message })
                        .then(() => location.reload());
                } else {
                    Swal.fire({ icon: 'error', title: 'Oops...', text: result.message });
                }
            } catch (error) {
                Swal.fire({ icon: 'error', title: 'Oops...', text: 'An error occurred.' });
            } finally {
                closeModal(form.closest('.fixed'));
            }
        };

     
        cancelForm?.addEventListener('submit', (e) => {
            e.preventDefault();
            const orderId = document.getElementById('cancelOrderId').value;
            const itemId = document.getElementById('cancelItemId').value;
            const reason = document.getElementById('cancel-note').value;
            
            const url = itemId 
                ? `/user/orders/${orderId}/items/${itemId}/request-cancellation` 
                : `/user/orders/${orderId}/request-cancellation`;
            
            handleFormSubmit(cancelForm, url, { reason });
        });

        
        returnForm?.addEventListener('submit', (e) => {
            e.preventDefault();
            const orderId = document.getElementById('returnOrderId').value;
            const itemId = document.getElementById('returnItemId').value;
            const reason = document.getElementById('returnNote').value;
            
            const url = itemId 
                ? `/user/orders/${orderId}/items/${itemId}/request-return` 
                : `/user/orders/${orderId}/request-return`;

            handleFormSubmit(returnForm, url, { reason });
        });
    });
</script>