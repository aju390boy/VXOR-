              <% order.products.forEach(productItem => { %>
                <% 
                  const product = productItem.product_id;
                  let imagePath = 'https://placehold.co/96x96/1f2937/d1d5db?text=IMG';
                  if (product && product.colorVariants && product.colorVariants.length > 0 && product.colorVariants[0].images && product.colorVariants[0].images.length > 0) {
                    let firstImage = product.colorVariants[0].images[0];
                    imagePath = firstImage.startsWith('http') ? firstImage : `/uploads/products/${firstImage}`;
