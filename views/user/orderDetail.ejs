                          <!-- Order Status Tracker -->
   <div class="space-y-8">
  <% 
    const progressSteps = ['CONFIRMED', 'PROCESSING', 'PACKED', 'SHIPPED', 'DELIVERED'];
    const statusIcons = {
      'CONFIRMED': 'fa-solid fa-clipboard-check',
      'PROCESSING': 'fa-solid fa-cogs',
      'PACKED': 'fa-solid fa-box-archive',
      'SHIPPED': 'fa-solid fa-truck-fast',
      'DELIVERED': 'fa-solid fa-house-chimney-user',
      'CANCELLED': 'fa-solid fa-circle-xmark',
      'RETURNED': 'fa-solid fa-box-open',
      'CANCELLATION REQUESTED': 'fa-solid fa-ban',
      'RETURN REQUESTED': 'fa-solid fa-rotate-left',
    };

    const specialStatusPriority = ['CANCELLED', 'CANCELLATION REQUESTED', 'RETURNED', 'RETURN REQUESTED'];

    // Find unique special statuses from all products
    const allSpecialStatuses = [...new Set(order.products
      .map(p => p.status)
      .filter(status => specialStatusPriority.includes(status)))];

    // Pick one special status per priority order to show
    let specialStatusToShow = null;
    for (let status of specialStatusPriority) {
      if (allSpecialStatuses.includes(status)) {
        specialStatusToShow = status;
        break;
      }
    }

    // Helper to get progress width
    function getProgressWidth(status) {
      const index = progressSteps.indexOf(status);
      if (index === -1) return 0;
      return (index / (progressSteps.length - 1)) * 100;
    }
  %>

  <% order.products.forEach(product => { 
    const status = product.status;
    const progressWidth = getProgressWidth(status);
    const currentStepIndex = progressSteps.indexOf(status);

    // Flag if this product has special status that should be hidden
    const isSpecialStatus = specialStatusPriority.includes(status);
    const showProductTracker = !specialStatusToShow || (specialStatusToShow === status);
  %>

    <% if (!isSpecialStatus || showProductTracker) { %>
      <div class="rounded-2xl px-4  mb-8 ">
       
        <div class="relative pt-8 pb-4">
          <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-1 bg-gray-700 mx-8 md:mx-16"></div>
          <div class="absolute left-0 h-1 bg-green-500 top-1/2 -translate-y-1/2 transition-all duration-1000 ease-in-out" 
               style="width: calc(<%= progressWidth %>% - 4rem);"></div>

          <div class="flex justify-between relative z-10 text-center">
            <% progressSteps.forEach((step, index) => {
              const isCompleted = currentStepIndex > index;
              const isActive = currentStepIndex === index;

              let stepClass = 'bg-gray-700 text-gray-400'; // Default
              if (isActive) {
                stepClass = 'bg-purple-600 text-white shadow-lg shadow-purple-500/30'; // Current step
              } else if (isCompleted) {
                stepClass = 'bg-green-600 text-white'; // Completed step
              }

              let iconClass = statusIcons[step];
              if (isCompleted) {
                iconClass = 'fa-solid fa-check';
              } else if (isActive) {
                iconClass = 'fa-solid fa-spinner fa-spin';
              }
            %>
              <div class="flex flex-col items-center flex-1">
                <div class="w-12 h-12 rounded-full flex items-center justify-center mb-2 transition-all duration-300 <%= stepClass %>">
                  <i class="text-xl <%= iconClass %>"></i>
                </div>
                <span class="text-xs sm:text-sm font-medium text-white text-center"><%= step.charAt(0) + step.slice(1).toLowerCase() %></span>
                <% if (isCompleted || isActive) { %>
                  <span class="text-xs text-gray-500 text-center mt-1">
                    <%= new Date(order.updatedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
                  </span>
                <% } %>
              </div>
            <% }); %>
          </div>
        </div>
      </div>
    <% } %>
  <% }); %>

  <% if (specialStatusToShow) { %>
    <div class="rounded-2xl px-4 shadow-lg mb-8 bg-yellow-700">
      <h3 class="font-semibold mb-4 text-white">Status Alert</h3>
      <div class="flex justify-center items-center">
        <div class="w-12 h-12 rounded-full flex items-center justify-center mr-4 mb-6 text-white 
          <%= (specialStatusToShow === 'CANCELLED' || specialStatusToShow === 'RETURNED') ? 'bg-red-600' : 'bg-yellow-600' %>"
        >
          <i class="text-3xl  <%= statusIcons[specialStatusToShow] %>"></i>
        </div>
        <div class="text-white font-semibold text-lg mb-4">
          <%= specialStatusToShow.replace(/_/g, ' ').toLowerCase().replace(/\b\w/g, c => c.toUpperCase()) %>
        </div>
      </div>
    </div>
  <% } %>
</div>
</div>
        <!-- order status tracker end -->
         <% }); %>             
          </div>
            <% } else { %>
                <div class="p-6 text-center text-gray-400">
                    <p>No products found for this order.</p>
                </div>
            <% } %>
        </div>
        
        <!-- Order Summary and Address -->
