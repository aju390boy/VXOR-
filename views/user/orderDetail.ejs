            <p class="mb-4 text-gray-500">Expected Delivery: <%= itemDetail.expected_delivery ? new Date(itemDetail.expected_delivery).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></p>

            <% if (canCancel) { %>
              <button class="cancel-item-btn px-6 py-3 rounded-xl font-semibold text-red-500 bg-gray-700 hover:bg-red-700 transition" data-order-id="<%= order._id %>" data-item-id="<%= itemDetail._id %>">
                Cancel
              </button>
            <% } %>
            <% if (canReturn) { %>
              <button class="return-item-btn px-6 py-3 rounded-xl font-semibold bg-purple-600 text-white hover:bg-purple-700 transition" data-order-id="<%= order._id %>" data-item-id="<%= itemDetail._id %>">
                Return
              </button>
            <% } %>
