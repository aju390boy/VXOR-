                          productItem.status === 'PROCESSING' ? 'bg-blue-600/80 text-blue-100' : 
                          productItem.status === 'CONFIRMED' ? 'bg-blue-300 text-black' :
                          productItem.status === 'PACKED' ? 'bg-indigo-600/80 text-indigo-100' : 
                          productItem.status === 'SHIPPED' ? 'bg-cyan-600/80 text-cyan-100' : 
                          productItem.status === 'DELIVERED' ? 'bg-green-600/80 text-green-100' : 
                          productItem.status === 'RETURN REQUESTED' ? 'bg-yellow-600/80 text-yellow-100' : 
                          productItem.status === 'CANCELLED' ? 'bg-red-600/80 text-red-100' : 
                          productItem.status === 'PENDING' ? 'bg-orange-600/80 text-orange-100' : 
                          productItem.status === 'RETURNED' ? 'bg-orange-600/80 text-orange-100' : 'bg-gray-600/80 text-gray-100' %>">
                          <%= productItem.status %>
                        </span>
                      </p>
                    </div>
                    <p class="text-gray-500 text-sm mt-2">Expected Delivery: <%= productItem.expected_delivery ? new Date(productItem.expected_delivery).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : 'N/A' %></p>
                  </div>

                  <div class="flex flex-col sm:flex-row gap-4 w-full md:w-auto mt-4 md:mt-0">
                    <% if (canCancel) { %>
                      <button class="cancel-item-btn w-full sm:w-auto px-6 py-3 rounded-xl font-semibold text-red-500 transition"
                              data-order-id="<%= order._id %>" data-item-id="<%= productItem._id %>">
                        Cancel
                      </button>
                    <% } %>
                    <% if (canReturn) { %>
                      <button class="return-item-btn w-full sm:w-auto px-6 py-3 rounded-xl font-semibold bg-purple-600 text-white hover:bg-purple-700 transition"
                              data-order-id="<%= order._id %>" data-item-id="<%= productItem._id %>">
                        Return
                      </button>
                    <% } %>
                    <a href="/user/orders/<%= order.order_id || order._id %>/items/<%= productItem._id %>/invoice" 
                       class="single-item-invoice-btn w-full sm:w-auto px-6 py-3 rounded-xl font-semibold text-white transition text-center"
                       data-order-id="<%= order.order_id || order._id %>">
                      Download Invoice
                    </a>
                  </div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <div class="p-6 text-center text-gray-400">No products found for this order.</div>
          <% } %>
        </div>

      <% } %>
    </div>
     <!-- Order Status Tracker -->
   <div class="rounded-2xl px-4 mb-8">
  <% 
    function getProgressWidth(status) {
      const index = progressSteps.indexOf(status);
      if (index === -1) return 0;
      return (index / (progressSteps.length - 1)) * 100;
    }

    const progressWidth = getProgressWidth(itemStatus);
    const currentStepIndex = progressSteps.indexOf(itemStatus);

    const statusIcons = {
      'CONFIRMED': 'fa-solid fa-clipboard-check',
      'PROCESSING': 'fa-solid fa-cogs',
      'PACKED': 'fa-solid fa-box-archive',
      'SHIPPED': 'fa-solid fa-truck-fast',
      'DELIVERED': 'fa-solid fa-house-chimney-user',
      'CANCELLATION REQUESTED': 'fa-solid fa-ban',
      'CANCELLED': 'fa-solid fa-circle-xmark',
      'RETURN REQUESTED': 'fa-solid fa-rotate-left',
      'RETURNED': 'fa-solid fa-box-open',
    };
  %>

  <div class="relative pt-8 pb-4">
    <div class="absolute left-0 right-0 top-1/2 -translate-y-1/2 h-1 bg-gray-700 mx-8 md:mx-16"></div>
    <div class="absolute left-0 h-1 bg-green-500 top-1/2 -translate-y-1/2 transition-all duration-1000 ease-in-out" 
         style="width: calc(<%= progressWidth %>% - 4rem);"></div>

    <div class="flex justify-between relative z-10 text-center">
      <% progressSteps.forEach((step, index) => {
          const isCompleted = currentStepIndex > index;
          const isActive = currentStepIndex === index;

          let stepClass = 'bg-gray-700 text-gray-400';
          if (isActive) {
            stepClass = 'bg-purple-600 text-white shadow-lg shadow-purple-500/30';
          } else if (isCompleted) {
            stepClass = 'bg-green-600 text-white';
          }

          let iconClass = statusIcons[step];
          if (isCompleted) iconClass = 'fa-solid fa-check';
          else if (isActive) iconClass = 'fa-solid fa-spinner fa-spin';
      %>
        <div class="flex flex-col items-center flex-1">
          <div class="w-12 h-12 rounded-full flex items-center justify-center mb-2 transition-all duration-300 <%= stepClass %>">
            <i class="text-xl <%= iconClass %>"></i>
          </div>
          <span class="text-xs sm:text-sm font-medium text-white text-center">
            <%= step.charAt(0) + step.slice(1).toLowerCase() %>
          </span>
          <% if (isCompleted || isActive) { %>
            <span class="text-xs text-gray-500 text-center mt-1">
              <%= new Date(itemUpdatedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short' }) %>
            </span>
          <% } %>
        </div>
      <% }); %>
    </div>
  </div>
</div>

