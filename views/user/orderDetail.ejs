                    <h3 class="text-lg font-semibold text-white truncate hover:text-purple-400"><%= product ? product.title : 'Product unavailable' %></h3>
                    <div class="flex flex-wrap gap-x-6 gap-y-2 text-sm text-gray-400 mt-1">
                      <p>Quantity: <span class="text-white font-medium"><%= productItem.quantity %></span></p>
                      <p class="font-bold text-green-400">₹<%= productItem.price.toFixed(2) %></p>
                      <p>Color: <%= productItem.colorName || 'N/A' %></p>
                      <p>Size: <%= productItem.size || 'N/A' %></p>
