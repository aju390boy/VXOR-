<div class="max-w-12xl font-sans antialiased text-gray-300 min-h-screen bg-gray-900 py-6">
  <div class="max-w-[100%] mx-auto rounded-3xl shadow-2xl p-6 md:p-10 border border-gray-800 bg-gradient-to-br from-gray-900 to-gray-700">

    <div class="bg-gradient-to-br from-gray-900 via-gray-700 to-gray-900 rounded-md ">
      <div class="flex flex-col md:flex-row justify-between items-start mb-5 border-b border-gray-800 pb-2">
        <!-- Order Details -->
        <div class="mb-6 md:mb-0 flex-grow">
