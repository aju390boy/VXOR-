            <!-- Delivery Address -->
            <div class="bg-gradient-to-br from-gray-800 via-gray-700 to-gray-900 rounded-2xl shadow-lg p-6 border border-gray-700">
                <h2 class="text-2xl font-bold text-white mb-4">Delivery Address</h2>
                <% if (order.address_id) { %>
                    <div class="flex items-start gap-4">
                        <i class="fa-solid fa-location-dot text-gray-500 mt-1 text-xl"></i>
                        <div>
                            <h3 class="font-semibold text-white text-lg"><%= order.address_id.name %></h3>
                            <p class="text-gray-400 text-sm mt-1">
                                <%= order.address_id.address1 %><br>
                                 <%= order.address_id.address2 %><br>
                                <%= order.address_id.district %>, <%= order.address_id.state %><br>
                                <%= order.address_id.pincode %>, <%= order.address_id.country %>
                            </p>
                        </div>
                    </div>
                <% } else { %>
                    <p class="text-gray-500 text-sm">Address not found.</p>
                <% } %>
            </div>

            <!-- Order Summary -->
           <div class="bg-gradient-to-br from-gray-800 via-gray-700 to-gray-900 rounded-2xl shadow-lg p-6 border border-gray-700">
    <h2 class="text-2xl font-bold text-white mb-4">Order Summary</h2>
    <div class="space-y-3">
        
        <div class="flex justify-between">
            <span class="text-gray-400">Subtotal</span>
            <span class="font-medium text-white">₹<%= totals.originalSubtotal %></span>
        </div>
        
        <% if (totals.offerDiscount > 0) { %>
