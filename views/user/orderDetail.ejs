            <span class="font-bold text-green-400 text-xl">₹<%= totals.grandTotal %></span>
        </div>
    </div>
</div>
</div>

        <!-- Thank you message and call to action -->
        <div class="p-8 text-center rounded-2xl bg-gradient-to-br from-purple-800 to-indigo-900 shadow-xl border border-purple-700">
            <h3 class="text-2xl sm:text-3xl font-bold text-white mb-2">Thank you for your order!</h3>
            <p class="text-purple-200 text-sm sm:text-lg mb-6 max-w-2xl mx-auto">
                We hope you are excited about your purchase. Explore our collection to find your next favorite item and enjoy more seamless shopping.
            </p>
            <a href="/user/product" class="inline-block px-8 py-4 rounded-full font-bold text-lg text-white bg-black transition-all duration-300 transform hover:scale-105 hover:shadow-lg focus:outline-none focus:ring-4 focus:ring-purple-500">
