<%# views/user/profile/partials/_orderList.ejs %>

<%# 
  This block contains the main layout (header, search bar, table structure).
  It will ONLY be rendered on the initial page load when 'isSearchResult' is false or undefined.
%>
<% if (!locals.isSearchResult) { %>
<div class="w-full bg-gray-900 rounded-2xl shadow-2xl p-6 border border-gray-800">
    <div class="flex flex-col md:flex-row justify-between items-center mb-6 border-b border-gray-700 pb-4">
        <h2 class="text-3xl font-extrabold text-white mb-2 md:mb-0">My Orders</h2>
        <div class="relative w-full md:w-1/3">
            <input type="text" id="orderSearch" placeholder="Search orders..." 
                   class="w-full bg-gray-800 text-gray-300 rounded-lg py-2 pl-10 pr-4 focus:outline-none focus:ring-2 focus:ring-purple-500 transition-all duration-300 placeholder-gray-500">
            <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
        </div>
    </div>

    <div class="overflow-x-auto custom-scrollbar">
        <table class="min-w-full text-gray-300 border border-gray-800 rounded-xl overflow-hidden">
            <thead class="bg-gradient-to-r from-gray-800 to-gray-700">
                <tr class="text-left text-sm font-semibold text-gray-100 uppercase tracking-wide">
                    <th class="py-4 px-4">Order ID</th>
                    <th class="py-4 px-4">Product</th>
                    <th class="py-4 px-4">Title</th>
                    <th class="py-4 px-4">Date</th>
                    <th class="py-4 px-4">Total</th>
                    <th class="py-4 px-4">Status</th>
                    <th class="py-4 px-4">Payment</th>
                </tr>
            </thead>
            <tbody id="ordersTableBody" class="divide-y divide-gray-800">
<% } %>

<%# 
  This block contains the logic to render the actual table rows.
  It will run for BOTH the initial page load AND for search results.
%>
<% if (orders && orders.length > 0) { %>
    <% orders.forEach(order => { %>
         <tr class="bg-gray-800 hover:bg-gray-700 transition-all duration-300 transform hover:scale-[1.01] order-row cursor-pointer border-l-8 border-gray-700 hover:border-purple-500">
            <td class="py-4 px-4 text-sm font-medium ">
                <a href="/user/order-detail?order_id=<%= order._id %>" class="hover:underline hover:text-purple-400 transition-colors duration-200">
                    <%= order.order_id || order._id %>
                </a>
            </td>
            <td class="py-4 px-4">
                <% if (order.products && order.products.length > 0) { %>
                    <% 
                        const product = order.products[0].product_id;
                        let imagePath = 'https://placehold.co/64x64/2d3748/e2e8f0?text=IMG';
                        let altText = 'No Image';
                        if (product && product.colorVariants && product.colorVariants.length > 0) {
                            const firstVariant = product.colorVariants[0];
                            if (firstVariant.images && firstVariant.images.length > 0) {
                                imagePath = `/uploads/products/${firstVariant.images[0]}`;
                                altText = product.title || 'Product Image';
                            }
                        }
                    %>
                    <a href="/user/orders/<%= order._id %>" class="flex items-center space-x-4">
                        <img src="<%= order.display_image_url %>" alt="<%= altText %>" class="w-16 h-22 object-cover rounded-xl shadow-md border border-gray-700">
                    </a>
                <% } else { %>
                    <span class="text-gray-500">No Product</span>
                <% } %>
            </td>
            <td class="text-white text-base font-semibold hover:text-purple-400">
    <% if (order.products[0] && order.products[0].product_id) { %>
        <%= order.products[0].product_id.title %>
    <% } else { %>
        <span class="text-red-500 text-sm">Product no longer available</span>
    <% } %>
</td>
            <td class="py-4 px-4 text-sm font-light whitespace-nowrap"><%= new Date(order.createdAt).toLocaleDateString() %></td>
            <td class="py-4 px-4 text-base font-bold text-green-400 whitespace-nowrap">₹<%= order.total_amount.toFixed(2) %></td>
            <td class="py-4 px-6">
                <% const firstProductStatus = order.products && order.products.length > 0 ? order.products[0].status : ''; %>
                <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase shadow-sm <%= firstProductStatus === 'PROCESSING' ? 'bg-blue-600/80 text-blue-100' : firstProductStatus === 'PACKED' ? 'bg-indigo-600/80 text-indigo-100' : firstProductStatus === 'SHIPPED' ? 'bg-cyan-600/80 text-cyan-100' : firstProductStatus === 'DELIVERED' ? 'bg-green-600/80 text-green-100' : firstProductStatus === 'RETURN REQUESTED' ? 'bg-yellow-600/80 text-yellow-100' : firstProductStatus === 'CANCELLED' ? 'bg-red-600/80 text-red-100' : firstProductStatus === 'RETURNED' ? 'bg-orange-600/80 text-orange-100' : 'bg-gray-600/80 text-gray-100' %>">
                    <%= firstProductStatus %>
                </span>
            </td>
            <td class="py-4 px-4">
                <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase shadow-sm <%= order.payment_status === 'COMPLETED' ? 'bg-green-600/80 text-green-100' : order.payment_status === 'PENDING' ? 'bg-yellow-600/80 text-yellow-50' : order.payment_status === 'REFUNDED' ? 'bg-indigo-600/80 text-indigo-100' : order.payment_status === 'FAILED' ? 'bg-red-600/80 text-red-100' : order.payment_status === 'PROCESSING' ? 'bg-blue-600/80 text-blue-100' : 'bg-gray-600/80 text-gray-100' %>">
                    <%= order.payment_status %>
                </span>
            </td>
        </tr>
    <% }); %>
<% } %>

<%# 
  This block contains the closing tags for the layout.
  It will ONLY be rendered on the initial page load.
%>
<% if (!locals.isSearchResult) { %>
            </tbody>
        </table>
    </div>
    <%# This 'else' corresponds to the 'if (orders && orders.length > 0)' from the very beginning %>
    <% if (!orders || orders.length === 0) { %>
        <div class="flex flex-col items-center justify-center p-6 bg-gray-900 rounded-2xl mt-2 border border-gray-700 shadow-lg max-h-[500px]">
            <img class="w-[80%] h-auto max-w-sm rounded-xl object-contain" src="/images/no orders.png" alt="No orders">
            <p class="mt-3 text-gray-300 text-lg font-semibold">You have no orders yet.</p>
            <p class="text-gray-500 text-sm mt-2">Browse products and place your first order!</p>
        </div>
    <% } %>
</div>
<% } else { %>
    <%# This 'else' block handles the case for a search that returns 0 results %>
    <% if (!orders || orders.length === 0) { %>
        <tr>
            <td colspan="7" class="text-center py-8 text-gray-400">No orders found matching your search.</td>
        </tr>
    <% } %>
<% } %>

<!-- Pagination Controls -->
    <!-- Pagination Controls -->
<!-- Pagination Controls -->
<div class="pagination-container" data-section="orders">
  <div class="pagination flex justify-center mt-6 space-x-4">
    <button class="prevPageBtn px-3 py-1 bg-gray-700 rounded"
      <%= orders.pagination && orders.pagination.currentPage === 1 ? 'disabled' : '' %>>
      Previous
    </button>

    <span class="pageIndicator">
      Page <%= orders.pagination ? orders.pagination.currentPage : 1 %> /
      <%= orders.pagination ? orders.pagination.totalPages : 1 %>
    </span>

    <button class="nextPageBtn px-3 py-1 bg-gray-700 rounded"
      <%= orders.pagination && orders.pagination.currentPage === orders.pagination.totalPages ? 'disabled' : '' %>>
      Next
    </button>
  </div>
</div>


<style>
    .custom-scrollbar::-webkit-scrollbar {
        height: 8px;
    }
    .custom-scrollbar::-webkit-scrollbar-track {
        background: #1f2937;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb {
        background: #4b5563;
        border-radius: 10px;
    }
    .custom-scrollbar::-webkit-scrollbar-thumb:hover {
        background: #6b7280;
    }
</style>

