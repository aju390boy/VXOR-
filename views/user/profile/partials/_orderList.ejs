<%# views/user/profile/partials/_orderList.ejs %>

<% if (!locals.isSearchResult) { %>
  <div class="space-y-8">
    <div class="flex flex-col md:flex-row justify-between items-center mt-4 border-b border-gray-700 pb-4">
      <h2 class="text-2xl font-extrabold text-white px-2 mt-4 md:mb-0">My Orders</h2>
      <div class="relative w-full md:w-1/3">
        <input type="text" id="orderSearch" placeholder="Search orders..." 
               class="w-full bg-gray-800 text-gray-300 rounded-lg py-2 pl-10 pr-4 focus:outline-none focus:ring-2 focus:ring-purple-500 placeholder-gray-500 transition-all duration-300">
        <svg class="absolute left-3 top-1/2 transform -translate-y-1/2 h-5 w-5 text-gray-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>
    </div>
<% } %>

<% if (orders && orders.length > 0) { %>
  <% orders.forEach(order => { %>
    <% 
      const hasCancelableStatus = order.products.some(p => 
        ['CONFIRMED', 'PROCESSING', 'PACKED'].includes(p.status));
      const allDelivered = order.products.length > 0 && 
        order.products.every(p => p.status === 'DELIVERED');
      const paymentFailed = order.payment_status === 'FAILED';
    %>

    <div class="bg-gray-900 rounded-xl p-6 border border-gray-800 shadow-lg space-y-6">
      <header class="flex flex-col md:flex-row md:justify-between md:items-center mb-4 border-b border-gray-700 pb-3">
        <div class=" space-x-4 mt-6">
        <a href="/user/order-detail?order_id=<%= order._id %>" class="text-2xl font-semibold text-purple-400 hover:underline">
          Order ID: <%= order.order_id || order._id %>
        </a>
        </div>
            <!-- BTN -->
      <div class=" space-x-4 mt-6">
        <% if (paymentFailed) { %>
         <a href="/user/checkout"> <button 
            class="retry-btn px-2  text-md font-bold rounded-2xl bg-yellow-500 text-gray-900 transition"
            data-order-id="<%= order._id %>"
            
          >
            Retry
          </button>
          </a>
        <% } %>

        <% if (hasCancelableStatus) { %>
          <button 
            class="cancelEntireOrderBtn px-2 text-md font-bold bg-red-500 rounded-2xl text-gray-900 transition"
            data-order-id="<%= order._id %>"
          >
            Cancel
          </button>
        <% } %>

        <% if (allDelivered) { %>
          <button 
            class="returnEntireOrderBtn px-2   font-bold text-md bg-blue-500 rounded-2xl text-gray-900 transition"
            data-order-id="<%= order._id %>"
          >
            Return
          </button>
        <% } %>
         <a href="/user/orders/<%= order.order_id || order._id %>/invoice" 
             class="invoice-btn text-center w-full sm:w-auto bg-white px-2   text-md rounded-xl font-bold text-white transition-all duration-300
                    text-gray-900 "
             data-order-id="<%= order.order_id || order._id %>">
            Invoice
       </a>
     
      
         
          <span class="px-3  mb-3.5 rounded-full text-md font-semibold uppercase shadow-sm <%= 
              order.payment_status === 'COMPLETED' ?  'text-green-600' :
              order.payment_status === 'PENDING' ? ' text-yellow-600' :
              order.payment_status === 'REFUNDED' ? ' text-indigo-600' :
              order.payment_status === 'FAILED' ? ' text-red-600' :
              order.payment_status === 'PROCESSING' ? ' text-blue-600' :
              ' text-gray-600' %>">
              Payment: <%= order.payment_status %>
          </span>
           </div>
      <!-- BTN END  -->
        
      </header>

      <div class="space-y-4">
        <% order.products.forEach(item => { %>
          <% const product = item.product_id; %>
          <div class="flex items-center space-x-6 bg-gray-800 rounded-lg p-4 shadow-md cursor-pointer hover:bg-gray-700 transition-colors" 
               onclick="window.location.href='/user/orders/<%= order._id %>/items/<%= item._id %>'">
            <% 
              let imgSrc = 'https://placehold.co/64x64/2d3748/e2e8f0?text=IMG';
              let altText = 'No Image';
              if (product && product.colorVariants && product.colorVariants.length > 0) {
                const firstVariant = product.colorVariants[0];
                if (firstVariant.images && firstVariant.images.length > 0) {
                  imgSrc =  firstVariant.images[0];
                  altText = product.title || 'Product Image';
                }
              }
            %>
            <img src="<%= imgSrc %>" alt="<%= altText %>" class="w-16 h-16 object-cover  shadow-sm">
            <div class="flex-1 min-w-0">
              <h3 class="text-white font-semibold truncate hover:text-purple-400"><%= product ? product.title : 'Product unavailable' %></h3>
              <p class="text-gray-400 text-sm mt-1 truncate">Qty: <%= item.quantity %> | Price: ₹<%= order.total_amount %></p>
              <p class="text-gray-400 text-sm">Expected Delivery: <%= item.expected_delivery ? new Date(item.expected_delivery).toLocaleDateString() : 'N/A' %></p>
            </div>
            <div>
              <span class="px-3 py-1 rounded-full text-xs font-semibold uppercase shadow-sm <%= 
                  item.status === 'PROCESSING' ? 'bg-blue-600 text-blue-100' :
                  item.status === 'CONFIRMED'  ? 'bg-blue-300 text-black' :
                  item.status === 'PACKED' ? 'bg-indigo-600 text-indigo-100' :
                  item.status === 'SHIPPED' ? 'bg-cyan-600 text-cyan-100' :
                  item.status === 'DELIVERED' ? 'bg-green-600 text-green-100' :
                  item.status === 'RETURN REQUESTED' ? 'bg-yellow-600 text-yellow-100' :
                   item.status === 'CANCELLATION REQUESTED' ? 'bg-yellow-600 text-yellow-100' :
                  item.status === 'CANCELLED' ? 'bg-red-600 text-red-100' :
                  item.status === 'RETURNED' ? 'bg-orange-600 text-orange-100' :
                  'bg-gray-600 text-gray-100' %>">
                <%= item.status %>
              </span>
            </div>
          </div>
        <% }); %>
      </div>

    </div>
  <% }); %>
<% } else { %>
  <div class="flex flex-col items-center justify-center p-6 bg-gray-900 rounded-2xl mt-2 border border-gray-700 shadow-lg max-h-[500px]">
    <img class="w-[80%] h-auto max-w-sm rounded-xl object-contain" src="/images/no orders.png" alt="No orders">
    <p class="mt-3 text-gray-300 text-lg font-semibold">You have no orders yet.</p>
    <p class="text-gray-500 text-sm mt-2">Browse products and place your first order!</p>
  </div>
<% } %>

<% if (!locals.isSearchResult) { %>
  <div class="pagination-container" data-section="orders">
    <div class="pagination flex justify-center mt-6 space-x-4">
      <button class="prevPageBtn px-3 py-1 bg-gray-700 rounded"
        <%= orders.pagination && orders.pagination.currentPage === 1 ? 'disabled' : '' %>>
        Previous
      </button>
      <span class="pageIndicator">
        Page <%= orders.pagination ? orders.pagination.currentPage : 1 %> /
        <%= orders.pagination ? orders.pagination.totalPages : 1 %>
      </span>
      <button class="nextPageBtn px-3 py-1 bg-gray-700 rounded"
        <%= orders.pagination && orders.pagination.currentPage === orders.pagination.totalPages ? 'disabled' : '' %>>
        Next
      </button>
    </div>
  </div>
</div>
<% } %>

<!-- Modals for Cancel and Return -->
<!-- Cancel Modal with Predefined Reasons -->
<div id="cancelModal" class="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50 hidden">
  <div class="bg-white w-full max-w-md mx-auto rounded-2xl shadow-lg p-6 relative max-h-[90vh] overflow-y-auto">
    <button id="btnCloseCancel" class="absolute top-2 right-3 text-gray-400 hover:text-red-500 text-xl font-bold">×</button>
    <h2 class="text-xl font-semibold mb-4 text-gray-800">Cancel Item</h2>
    <form id="cancelForm" class="space-y-4">
      <input type="hidden" id="cancelOrderId" name="orderId">
      <input type="hidden" id="cancelItemId" name="itemId">
      
      <!-- Predefined Reasons Dropdown -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Select Reason</label>
        <select id="cancelReasonSelect" class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-400" required>
          <option value="">Choose a reason...</option>
          <option value="changed my mind">Changed my mind</option>
          <option value="wrong product received">Wrong product received</option>
          <option value="doesnt match description">Doesn't match description</option>
          <option value="out of stock">Out of stock</option>
          <option value="better price elsewhere">Better price elsewhere</option>
          <option value="ordered by mistake">Ordered by mistake</option>
          <option value="other">Other (please specify)</option>
        </select>
      </div>

      <!-- Custom Reason (shows when "Other" selected) -->
      <div id="customCancelReason" class="hidden">
        <label for="cancel-note" class="block text-sm font-medium text-gray-700 mb-2">Please specify:</label>
        <textarea id="cancel-note" name="cancel-note" rows="3" class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-red-400 resize-none" placeholder="Enter your reason..."></textarea>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <button type="button" id="cancelFormCancel" class="px-6 py-2 text-gray-600 bg-gray-200 hover:bg-gray-300 rounded-lg transition">Cancel</button>
        <button type="submit" class="bg-red-500 hover:bg-red-600 text-white px-6 py-2 rounded-lg font-medium transition">Submit Cancellation</button>
      </div>
    </form>
  </div>
</div>


<!-- Return Modal -->
<!-- Return Modal with Predefined Reasons -->
<div id="returnModal" class="fixed inset-0 bg-black bg-opacity-40 flex items-center justify-center z-50 hidden">
  <div class="bg-white w-full max-w-md mx-auto rounded-2xl shadow-lg p-6 relative max-h-[90vh] overflow-y-auto">
    <button id="btnCloseReturn" class="absolute top-2 right-3 text-gray-400 hover:text-purple-500 text-xl font-bold">×</button>
    <h2 class="text-xl font-semibold mb-4 text-gray-800">Return Request</h2>
    <form id="returnForm" class="space-y-4">
      <input type="hidden" id="returnOrderId" name="orderId">
      <input type="hidden" id="returnItemId" name="itemId">
      
      <!-- Predefined Reasons Dropdown -->
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-2">Select Reason</label>
        <select id="returnReasonSelect" class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-400" required>
          <option value="">Choose a reason...</option>
          <option value="defective or damaged">Defective or damaged</option>
          <option value="wrong item received">Wrong item received</option>
          <option value="doesnt fit properly">Doesn't fit properly</option>
          <option value="poor quality">Poor quality</option>
          <option value="doesnt match description">Doesn't match description</option>
          <option value="changed my mind">Changed my mind</option>
          <option value="other">Other (please specify)</option>
        </select>
      </div>

      <!-- Custom Reason (shows when "Other" selected) -->
      <div id="customReturnReason" class="hidden">
        <label for="returnNote" class="block text-sm font-medium text-gray-700 mb-2">Please specify:</label>
        <textarea id="returnNote" name="returnNote" rows="3" class="w-full p-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-purple-400 resize-none" placeholder="Enter your reason..."></textarea>
      </div>

      <div class="flex justify-end gap-3 pt-2">
        <button type="button" id="returnFormCancel" class="px-6 py-2 text-gray-600 bg-gray-200 hover:bg-gray-300 rounded-lg transition">Cancel</button>
        <button type="submit" class="bg-purple-500 hover:bg-purple-600 text-white px-6 py-2 rounded-lg font-medium transition">Submit Return Request</button>
      </div>
    </form>
  </div>
</div>

<style>
  .custom-scrollbar::-webkit-scrollbar {
    height: 8px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #1f2937;
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #4b5563;
    border-radius: 10px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #6b7280;
  }
</style>
