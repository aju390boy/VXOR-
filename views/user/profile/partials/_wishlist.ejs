<%# views/user/profile/partials/_wishlist.ejs %>
<div class="px-6 md:px-12 py-8">
    

    <% if (wishlistItems.length > 0) { %>
        <div class="space-y-6">
            <% wishlistItems.forEach(item => { %>
                <!-- Wishlist Item Card -->
                <div class="flex items-center bg-gradient-to-br from-gray-900 to-gray-600 rounded-xl p-4 transition-all duration-300 hover:shadow-lg hover:border-purple-500/50">
                    
                    <!-- Product Image -->
                    <img src="<%= item.display_image_url %>" alt="<%= item.title %>" class="w-24 h-32 object-cover rounded-lg" />
                    
                    <!-- Product Details -->
                    <div class="flex-grow px-6">
                        <h3 class="text-lg font-semibold text-white"><%= item.title %></h3>
                        
                        <!-- Price Display with Offer Logic -->
                        <div class="price-info mt-2 text-lg">
                            <% if (item.bestOffer) { %>
                                <s class="text-gray-400 text-base">₹<%= item.min_price.toFixed(0) %></s> 
                                <strong class="text-red-500 ml-2">₹<%= item.discounted_price.toFixed(0) %></strong>
                                <span class="text-green-400 text-sm ml-3 font-semibold">(<%= item.bestOffer.discountPercentage %>% OFF)</span>
                            <% } else { %>
                                <strong class="text-white">₹<%= item.min_price.toFixed(0) %></strong>
                            <% } %>
                        </div>

                        <!-- Stock Status -->
                        <p class="text-sm text-green-400 mt-2 font-semibold">In Stock</p>
                    </div>

                    <!-- Action Buttons -->
                    <div class="flex items-center gap-4">
                        <button 
                            class="move-to-cart-btn bg-gradient-to-br from-purple-900 to-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg text-sm transition-all duration-300 transform hover:scale-105"
                            data-product-id="<%= item._id %>"
                            data-title="<%= item.title %>">
                            Move to Cart
                        </button>
                        
                        <button 
                            class="remove-from-wishlist-btn w-10 h-10 rounded-full flex items-center justify-center bg-gray-700 text-gray-300 hover:bg-red-500 hover:text-white transition-colors" 
                            data-product-id="<%= item._id %>"
                            title="Remove from Wishlist">
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /></svg>
                        </button>
                    </div>
                </div>
            <% }) %>
        </div>
    <% } else { %>
        <!-- Empty Wishlist State -->
        <div class="w-full flex flex-col items-center justify-center text-center p-4">
            <img src="/images/wishlist.png" alt="An empty box with a heart" class="w-96 h-auto mb-6" />
            <h2 class="text-3xl font-bold text-gray-200 mb-2">Your Wishlist is Empty</h2>
            <p class="text-gray-400 mb-6 max-w-md">Add items you love to your wishlist. We'll keep them here for you.</p>
            <a href="/user/product" class="bg-purple-900 hover:bg-red-700 text-white font-bold py-3 px-8 rounded-lg transition-all duration-300 transform hover:scale-105 shadow-lg shadow-indigo-500/30">
                Discover Products
            </a>
        </div>
    <% } %>
</div>