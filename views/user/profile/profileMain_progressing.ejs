});
};


  ///////////////////////////////////////////////////////////////////////////////////////////////////////////////    
        const attachEditAddressFormListener = () => {
            const editAddressForm = document.getElementById('edit-address-form');
            if (editAddressForm) {
                editAddressForm.addEventListener('submit', async (event) => {
                    event.preventDefault();
                    clearErrorMessages('edit-address-form');

                    const addressId = document.getElementById('editAddressId').value;
                    const formData = new FormData(editAddressForm);
                    const data = Object.fromEntries(formData.entries());

                    try {
                        const response = await fetch(`/user/profile/address/edit/${addressId}`, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify(data)
                        });

                        const result = await response.json();

                        if (response.ok) {
                            Swal.fire({
                                icon: 'success',
                                title: 'Success!',
                                text: result.message || 'Address updated successfully!',
                                customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                            });

                            closeModal('editAddressModal');
                            setTimeout(() => {
                                loadSection('address');
                            }, 1500);
                        } else {
                            if (result.errors) {
                                for (const field in result.errors) {
                                    const errorElement = document.getElementById(`edit${field.charAt(0).toUpperCase() + field.slice(1)}Error`);
                                    if (errorElement) {
                                        errorElement.textContent = result.errors[field];
                                        editAddressForm.querySelector(`[name="${field}"]`).classList.add('border-red-500');
                                    }
                                }
                            }
                            Swal.fire({
                                icon: 'error',
                                title: 'Validation Error!',
                                text: result.message || 'Please correct the errors in the form.',
                                customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                            });
                        }
                    } catch (error) {
                        console.error('Error submitting edit address form:', error);
                        Swal.fire({
                            icon: 'error',
                            title: 'Network Error!',
                            text: 'Could not connect to server.',
                            customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                        });
                    }
                });
            }
        };

       //////////////////////////new one///////////////////
        sidebarLinks.forEach(link => {
            link.addEventListener('click', (event) => {
                event.preventDefault();
                const sectionName = event.currentTarget.dataset.section;
                sidebarLinks.forEach(item => item.classList.remove('active', 'bg-gray-700', 'text-white'));
                event.currentTarget.classList.add('active', 'bg-gray-700', 'text-white');
                loadSection(sectionName);
            });
        });

        const urlParams = new URLSearchParams(window.location.search);
        const defaultSection = urlParams.get('section') || 'profile';
        const initialLink = document.querySelector(`.sidebar-link[data-section="${defaultSection}"]`) || document.querySelector('.sidebar-link[data-section="profile"]');
        if (initialLink) {
            initialLink.click();
        }


    });
</script>

