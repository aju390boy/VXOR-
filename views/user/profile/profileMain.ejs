<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function openModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.remove('hidden');
            setTimeout(() => {
                const modalContent = modal.querySelector('.transform');
                if (modalContent) {
                    modalContent.classList.remove('scale-95', 'opacity-0');
                    modalContent.classList.add('scale-100', 'opacity-100');
                }
            }, 10);
        }
    }
    function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            const modalContent = modal.querySelector('.transform');
            if (modalContent) {
                modalContent.classList.remove('scale-100', 'opacity-100');
                modalContent.classList.add('scale-95', 'opacity-0');
            }
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }
    }
    function openEditProfileModal() {
        const profileModalImagePreview = document.getElementById('profile-modal-image-preview');
        const profileImageStatic = document.getElementById('profile-image-preview');
        if (profileImageStatic && profileModalImagePreview) {
            profileModalImagePreview.src = profileImageStatic.src;
        }
        openModal('editProfileModal');
    }
    const clearErrorMessages = (form) => {
        if (!form) return;
        form.querySelectorAll('.error-message').forEach(el => el.textContent = '');
        form.querySelectorAll('input').forEach(input => input.classList.remove('border-red-500'));
    };  
    ///////////////new logic/////////////////
function bindCancelReturnModals() {
  const cancelModal = document.getElementById('cancelModal');
  const returnModal = document.getElementById('returnModal');
  const cancelForm = document.getElementById('cancelForm');
  const returnForm = document.getElementById('returnForm');

  if (cancelModal) {
    cancelModal.addEventListener('click', e => {
      if (e.target === cancelModal) closeModal('cancelModal');
    });
  }
  if (returnModal) {
    returnModal.addEventListener('click', e => {
      if (e.target === returnModal) closeModal('returnModal');
    });
  }
  if (cancelForm) {
    cancelForm.addEventListener('submit', async e => {
      e.preventDefault();
      const orderId = document.getElementById('cancelOrderId').value;
      const reason = document.getElementById('cancel-note').value.trim();
      if (!reason) {
        Swal.fire('Error', 'Please provide a cancellation reason.', 'error');
        return;
      }
      const url = `/user/orders/${orderId}/request-cancellation`;
      try {
        const resp = await fetch(url, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason }),
        });
        const data = await resp.json();
        if (resp.ok) {
          await Swal.fire('Success!', 'Order cancellation successfully submitted.', 'success');
          closeModal('cancelModal');
          window.location.href = '/user/profile?section=orders';
        } else {
          Swal.fire('Error', data.message || 'Failed to cancel order.', 'error');
        }
      } catch {
        Swal.fire('Error', 'Network error. Please try again later.', 'error');
      }
    });
  }
  if (returnForm) {
    returnForm.addEventListener('submit', async e => {
      e.preventDefault();
      const orderId = document.getElementById('returnOrderId').value;
      const reason = document.getElementById('returnNote').value.trim();
      if (!reason) {
        Swal.fire('Error', 'Please provide a return reason.', 'error');
        return;
      }
      const url = `/user/orders/${orderId}/request-return`;
      try {
        const resp = await fetch(url, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason }),
        });
        const data = await resp.json();
        if (resp.ok) {
          await Swal.fire('Success!', 'Return request successfully submitted.', 'success');
          closeModal('returnModal');
          window.location.href = '/user/profile?section=orders';
        } else {
          Swal.fire('Error', data.message || 'Failed to request return.', 'error');
        }
      } catch {
        Swal.fire('Error', 'Network error. Please try again later.', 'error');
      }
    });
  }
}
    /////////////////new logic end////////////

     let variantsData = [];
     function populateVariantModal(variants, productTitle) {
        variantsData = variants; 
        const titleEl = document.getElementById('variantModalTitle');
        const colorSelector = document.getElementById('variantModalColorSelector');
        const sizeSelector = document.getElementById('variantModalSizeSelector');
        const selectedColorSpan = document.getElementById('variantModalSelectedColor');
        
        colorSelector.innerHTML = '';
        sizeSelector.innerHTML = '';
        titleEl.innerText = productTitle || 'Select Options';
        selectedColorSpan.innerText = '';

        if (!variants || variants.length === 0) return;

        variants.forEach((colorVar, index) => {
            const colorDot = document.createElement('span');
            colorDot.className = 'w-6 h-6 rounded-full border-2 border-transparent cursor-pointer';
            colorDot.style.backgroundColor = colorVar.colorName;
            colorDot.dataset.colorName = colorVar.colorName;
            colorDot.dataset.index = index;
            colorSelector.appendChild(colorDot);
        });
    }
