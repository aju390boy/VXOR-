                    Swal.fire({ icon: 'error', title: 'Error!', text: `Error loading section: ${errorMessage}`, width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
                    return;
                }
                profileContentArea.innerHTML = await response.text();
              bindCancelReturnModals();
            } catch (error) {
                console.error('Error fetching profile section:', error);
                Swal.fire({ icon: 'error', title: 'Network Error!', text: 'Failed to load section content.', width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
            }
        };
        sidebarLinks.forEach(link => {
            link.addEventListener('click', (event) => {
                event.preventDefault();
                const sectionName = event.currentTarget.dataset.section;
                sidebarLinks.forEach(item => item.classList.remove('active', 'bg-gray-700', 'text-white'));
                event.currentTarget.classList.add('active', 'bg-gray-700', 'text-white');
