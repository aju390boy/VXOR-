            if (event.target.id === 'addMoneyBtn') {
        const amountInput = document.getElementById('addAmountInput');
        const amount = amountInput.value;

        if (!amount || amount < 10) {
            Swal.fire({ icon: 'error', title: 'Invalid Amount', text: 'Please enter an amount of at least ₹10.'});
