<%# views/user/profile/profileMain.ejs %>
<% title = 'VIXOR | My Profile'; -%>

<%# Breadcrumb %>
<div class="flex justify-between items-center px-6 py-2 bg-gray-900 mt-2 flex-wrap gap-1">
    <div class="breadcrumb text-xs text-gray-400">
        <a href="/user/home" class="text-gray-400 font-bold hover:text-white">HOME</a> > <span>MY PROFILE</span>
    </div>
</div>

<div class="flex flex-col md:flex-row px-10 py-2 bg-gray-900 min-h-5 text-gray-400">

    
    <aside id="profile-sidebar" class="
        w-full md:w-1/4 lg:w-1/5
        p-4 md:p-6 border-r border-gray-800 bg-gray-900
        sticky top-[6.5rem]
        h-fit
        md:self-start
        z-0
    ">
        <h2 class="text-lg font-bold mb-7 text-white  border-b border-gray-700 pb-2">MY ACCOUNT</h2>
        <ul class="flex flex-col gap-2">
            <li>
                <a href="/user/profile/section/profile" data-section="profile" class="sidebar-link flex items-center gap-3 py-4 px-2 rounded text-gray-400 hover:bg-gray-800 hover:text-white transition duration-200">
                    <i class="fa-regular fa-user"></i> PROFILE
                </a>
            </li>
            <li>
                <a href="/user/profile/section/orders" data-section="orders" class="sidebar-link flex items-center gap-3 py-4 px-2 rounded text-gray-400 hover:bg-gray-800 hover:text-white transition duration-200">
                    <i class="fa-solid fa-box"></i> ORDERS
                </a>
            </li>
            <li>
                <a href="/user/profile/section/wishlist" data-section="wishlist" class="sidebar-link flex items-center gap-3 py-4 px-2 rounded text-gray-400 hover:bg-gray-800 hover:text-white transition duration-200">
                    <i class="fa-regular fa-heart"></i> WISHLIST
                </a>
            </li>
            <li>
                <a href="/user/profile/section/address" data-section="address" class="sidebar-link flex items-center gap-3 py-4 px-2 rounded text-gray-400 hover:bg-gray-800 hover:text-white transition duration-200">
                    <i class="fa-solid fa-location-dot"></i> ADDRESS
                </a>
            </li>
            <li>
                <a href="/user/profile/section/change-password" data-section="change-password" class="sidebar-link flex items-center gap-3 py-4 px-2 rounded text-gray-400 hover:bg-gray-800 hover:text-white transition duration-200">
                    <i class="fa-solid fa-key"></i> PASSWORD
                </a>
            </li>
            <li>
                <a href="/user/profile/section/wallet" data-section="wallet" class="sidebar-link flex items-center gap-3 py-4 px-2 rounded text-gray-400 hover:bg-gray-800 hover:text-white transition duration-200">
                    <i class="fa-solid fa-wallet"></i> WALLET
                </a>
            </li>
            <li class="mt-4 border-t border-gray-700 pt-4">
                <a href="/logout" class="block py-2 px-3 rounded  text-white font-bold hover:bg-purple-900 transition duration-200">
                    <i class="fa-solid fa-right-from-bracket"></i> LOGOUT
                </a>
            </li>
        </ul>
    </aside>

    <%# Main Content Area %>
     <main id="main-content-area" 
      class="flex-1 px-1 md:px-1 py-1 bg-gray-900 flex w-full">
    <div id="profile-content" class="w-full">
        <%- include('partials/_profileDetails', { user: user, addresses: addresses }) %>
    </div>
</main>
</div>
<!-- ///variant selecting modal/// -->
<div id="variantSelectorModal" class="fixed inset-0 bg-gray-900 bg-opacity-75 flex items-center justify-center z-50 hidden">
    <div class="bg-gray-800 p-6 rounded-lg shadow-xl max-w-sm w-full relative">
        <button id="closeVariantModalBtn" class="absolute top-4 right-4 text-gray-400 hover:text-white">&times;</button>
        <h4 id="variantModalTitle" class="text-xl font-bold mb-4">Select Options</h4>
        
        <div class="color-options mb-4">
            <h3>COLOR: <span id="variantModalSelectedColor"></span></h3>
            <div id="variantModalColorSelector" class="flex items-center gap-2 mt-2"></div>
        </div>

        <div class="select-size mb-6">
            <h3>SELECT SIZE</h3>
            <div id="variantModalSizeSelector" class="flex flex-wrap gap-2 mt-2"></div>
        </div>

        <button id="modalAddToCartBtn" class="w-full bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg transition-colors">Add to Cart</button>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<script>
    function openModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            modal.classList.remove('hidden');
            setTimeout(() => {
                const modalContent = modal.querySelector('.transform');
                if (modalContent) {
                    modalContent.classList.remove('scale-95', 'opacity-0');
                    modalContent.classList.add('scale-100', 'opacity-100');
                }
            }, 10);
        }
    }
    function closeModal(modalId) {
        const modal = document.getElementById(modalId);
        if (modal) {
            const modalContent = modal.querySelector('.transform');
            if (modalContent) {
                modalContent.classList.remove('scale-100', 'opacity-100');
                modalContent.classList.add('scale-95', 'opacity-0');
            }
            setTimeout(() => {
                modal.classList.add('hidden');
            }, 300);
        }
    }
    function openEditProfileModal() {
        const profileModalImagePreview = document.getElementById('profile-modal-image-preview');
        const profileImageStatic = document.getElementById('profile-image-preview');
        if (profileImageStatic && profileModalImagePreview) {
            profileModalImagePreview.src = profileImageStatic.src;
        }
        openModal('editProfileModal');
    }
    const clearErrorMessages = (form) => {
        if (!form) return;
        form.querySelectorAll('.error-message').forEach(el => el.textContent = '');
        form.querySelectorAll('input').forEach(input => input.classList.remove('border-red-500'));
    };  
    ////////
     let variantsData = [];
     function populateVariantModal(variants, productTitle) {
        variantsData = variants; 
        const titleEl = document.getElementById('variantModalTitle');
        const colorSelector = document.getElementById('variantModalColorSelector');
        const sizeSelector = document.getElementById('variantModalSizeSelector');
        const selectedColorSpan = document.getElementById('variantModalSelectedColor');
        
        colorSelector.innerHTML = '';
        sizeSelector.innerHTML = '';
        titleEl.innerText = productTitle || 'Select Options';
        selectedColorSpan.innerText = '';

        if (!variants || variants.length === 0) return;

        variants.forEach((colorVar, index) => {
            const colorDot = document.createElement('span');
            colorDot.className = 'w-6 h-6 rounded-full border-2 border-transparent cursor-pointer';
            colorDot.style.backgroundColor = colorVar.colorName;
            colorDot.dataset.colorName = colorVar.colorName;
            colorDot.dataset.index = index;
            colorSelector.appendChild(colorDot);
        });
    }
    ///////////////
    document.addEventListener('DOMContentLoaded', () => {
        const profileContentArea = document.getElementById('profile-content');
        const sidebarLinks = document.querySelectorAll('.sidebar-link');
        const variantModal = document.getElementById('variantSelectorModal');
        let activeProductId = null;

        const loadSection = async (sectionName) => {
            try {
                const response = await fetch(`/user/profile/section/${sectionName}`);
                if (!response.ok) {
                    const errorMessage = await response.text();
                    Swal.fire({ icon: 'error', title: 'Error!', text: `Error loading section: ${errorMessage}`, width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
                    return;
                }
                profileContentArea.innerHTML = await response.text();
            } catch (error) {
                console.error('Error fetching profile section:', error);
                Swal.fire({ icon: 'error', title: 'Network Error!', text: 'Failed to load section content.', width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
            }
        };
        sidebarLinks.forEach(link => {
            link.addEventListener('click', (event) => {
                event.preventDefault();
                const sectionName = event.currentTarget.dataset.section;
                sidebarLinks.forEach(item => item.classList.remove('active', 'bg-gray-700', 'text-white'));
                event.currentTarget.classList.add('active', 'bg-gray-700', 'text-white');
                loadSection(sectionName);
            });
        });
        profileContentArea.addEventListener('click', async(e) => {
            const removeBtn = e.target.closest('.remove-address-btn');
            const editBtn = e.target.closest('.edit-address-btn');
            const setDefaultBtn = e.target.closest('.set-default-btn');
            const addNewAddressBtn = e.target.closest('#addNewAddressBtn');
            const editProfileModal = e.target.closest('#editProfileModal');
            const removeWishlistBtn = e.target.closest('.remove-from-wishlist-btn'); 
            const moveToCartBtn = e.target.closest('.move-to-cart-btn');

            if (removeBtn) {
                const addressId = removeBtn.dataset.addressId;
                Swal.fire({ title: 'Are you sure?', text: "You won't be able to revert this!", icon: 'warning', width:'400px', showCancelButton: true, confirmButtonText: 'Yes, remove it!', cancelButtonText: 'No, cancel!', reverseButtons: true, customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button', cancelButton: 'swal-dark-button' }
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/user/profile/address/remove/${addressId}`, { method: 'POST' });
                            const resData = await response.json();
                            if (response.ok) {
                                Swal.fire({ icon: 'success', title: 'Removed!', text: resData.message, width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
                                setTimeout(() => loadSection('address'), 1500);
                            } else {
                                Swal.fire({ icon: 'error', title: 'Failed!', text: resData.message, width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
                            }
                        } catch (error) { console.error('Error removing address:', error); Swal.fire({ icon: 'error', title: 'Network Error!', text: 'Could not connect to server.', width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } }); }
                    }
                });
            } else if (editBtn) {
                const addressData = JSON.parse(editBtn.dataset.address);
                document.getElementById('editAddressId').value = addressData._id;
                document.getElementById('edit-name').value = addressData.name;
                document.getElementById('edit-mobile').value = addressData.mobile || '';
                document.getElementById('edit-address1').value = addressData.address1;
                document.getElementById('edit-address2').value = addressData.address2 || '';
                document.getElementById('edit-city').value = addressData.city;
                document.getElementById('edit-state').value = addressData.state;
                document.getElementById('edit-pincode').value = addressData.pincode;
                document.getElementById('edit-country').value = addressData.country;
                openModal('editAddressModal');
            } else if (setDefaultBtn) {
                const addressId = setDefaultBtn.dataset.addressId;
                Swal.fire({ title: 'Set as default?', text: "This will be your primary shipping address.", icon: 'info', width:'400px', showCancelButton: true, confirmButtonText: 'Yes, set as default!', cancelButtonText: 'Cancel', reverseButtons: true, customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button', cancelButton: 'swal-dark-button' }
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            const response = await fetch(`/user/profile/address/set-default/${addressId}`, { method: 'POST' });
                            const resData = await response.json();
                            if (response.ok) {
                                Swal.fire({ icon: 'success', title: 'Success!', text: resData.message, width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
                                setTimeout(() => window.location.reload(), 1500);
                            } else {
                                Swal.fire({ icon: 'error', title: 'Error!', text: resData.message, width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
                            }
                        } catch(error) { console.error('Error setting default address:', error); Swal.fire({ icon: 'error', title: 'Network Error!', text: 'Could not connect to server.', width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } }); }
                    }
                });
            } else if (addNewAddressBtn) {
                openModal('addAddressModal');
            }else if (removeWishlistBtn) { // --- ADD THIS ENTIRE 'ELSE IF' BLOCK ---
    const productId = removeWishlistBtn.dataset.productId;
    const wishlistItemCard = removeWishlistBtn.closest('.flex.items-center');

    Swal.fire({
        title: 'Are you sure?',
        text: "This item will be removed from your wishlist.",
        icon: 'warning',
        width:'400px',
        showCancelButton: true,
        confirmButtonText: 'Yes, remove it!',
        cancelButtonText: 'Cancel',
        reverseButtons: true,
        customClass: { 
            popup: 'swal-dark-bg', 
            title: 'swal-dark-title', 
            content: 'swal-dark-content', 
            confirmButton: 'swal-dark-button', 
            cancelButton: 'swal-dark-button' 
        }
    }).then(async (result) => {
        if (result.isConfirmed) {
            try {
                const response = await fetch(`/user/wishlist/remove/${productId}`, {
                    method: 'DELETE'
                });
                const data = await response.json();
                
                if (response.ok && data.success) {
                    // Remove the item from the page for instant feedback
                    wishlistItemCard.remove();
                    Swal.fire({ 
                        icon: 'success', 
                        title: 'Removed!', 
                        text: data.message, 
                        width:'400px',
                        customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' }
                    });
                    window.location.href = '/user/profile?section=wishlist';
                } else {
                    Swal.fire({ icon: 'error', title: 'Error!', text: data.message, width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
                }
            } catch (error) {
                console.error('Error removing from wishlist:', error);
                Swal.fire({ icon: 'error', title: 'Network Error!', text: 'Could not connect to server.', width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
            }
        }
    });
}else if (moveToCartBtn) { // --- ADD THIS ENTIRE 'ELSE IF' BLOCK ---
                activeProductId = moveToCartBtn.dataset.productId;
                const productTitle = moveToCartBtn.dataset.title;

                try {
                    const response = await fetch(`/user/product-variants/${activeProductId}`);
                    if (!response.ok) throw new Error('Could not fetch product details.');
                    const variants = await response.json();
                    
                    populateVariantModal(variants, productTitle);
                    openModal('variantSelectorModal'); // Assuming you have a generic openModal function
                } catch (error) {
                    console.error("Could not fetch variants:", error);
                    Swal.fire({ icon: 'error', title: 'Error', text: 'Could not load product options.' });
                }
            } 
else if (editProfileModal && e.target === editProfileModal) {
                 closeModal('editProfileModal');
            }
        });

        profileContentArea.addEventListener('submit', async (e) => {
            e.preventDefault();
            const form = e.target;
            
            if (form.id === 'profile-update-form') {
                const formData = new FormData(form);
                try {
                    const response = await fetch('/user/profile/update', { method: 'POST', body: formData });
                    const result = await response.json();
                    if (!response.ok) {
                        Swal.fire({ icon: 'error', title: 'Update Failed', text: result.message, width: '400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
                        return;
                    }
                  if (result.otpSent) {
    let timerInterval;
    Swal.fire({
        title: 'Enter OTP',
        text: result.message,
        input: 'text',
        width:'400px',
        inputAttributes: {
            maxlength: 6,
            autocapitalize: 'off',
            autocorrect: 'off'
        },
        showCancelButton: true,
        confirmButtonText: 'Verify Email',
        showLoaderOnConfirm: true,
        html: `
            <div id="otp-timer-container" class="mt-4">
                You can resend OTP in <strong id="swal-timer">60</strong> seconds.
            </div>
            <button id="resend-otp-btn" type="button" class="swal2-styled" style="display:none; background-color: #3085d6; border-left-color: #3085d6; border-right-color: #3085d6;">Resend OTP</button>
        `,
        didOpen: () => {
            const timerEl = document.getElementById('swal-timer');
            const resendBtn = document.getElementById('resend-otp-btn');
            let timeLeft = 60;
            timerInterval = setInterval(() => {
                timeLeft--;
                timerEl.textContent = timeLeft;
                if (timeLeft <= 0) {
                    clearInterval(timerInterval);
                    document.getElementById('otp-timer-container').style.display = 'none';
                    resendBtn.style.display = 'inline-block';
                }
            }, 1000);
            resendBtn.addEventListener('click', () => {
                  clearInterval(timerInterval);
                fetch('/user/resend-email-otp', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ newEmail: result.newEmail })
                })
                .then(res => res.json())
                .then(data => {
                    if (data.message) {
                        Swal.update({ text: data.message }); 
                        document.getElementById('otp-timer-container').style.display = 'block';
                        resendBtn.style.display = 'none';
                        timeLeft = 60;
                         const timerEl = document.getElementById('swal-timer');
                          timerEl.textContent = timeLeft;
                        timerInterval = setInterval(() => {
                           timeLeft--;
                           timerEl.textContent = timeLeft;
                           if (timeLeft <= 0) {
                               clearInterval(timerInterval);
                               document.getElementById('otp-timer-container').style.display = 'none';
                               resendBtn.style.display = 'inline-block';
                           }
                        }, 1000);
                    }
                })
                .catch(err => console.error(err));
            });
        },
        willClose: () => {
            clearInterval(timerInterval);
        },
        preConfirm: (otp) => {
             return fetch('/user/verify-email-update', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ otp: otp, newEmail: result.newEmail }) 
                })
                .then(verifyResponse => {
                    if (!verifyResponse.ok) {
                        return verifyResponse.json().then(err => { throw new Error(err.message) });
                    }
                    return verifyResponse.json();
                })
                .catch(error => {
                    Swal.showValidationMessage(`Request failed: ${error}`);
                });
        },
        allowOutsideClick: () => !Swal.isLoading()
    }).then((finalResult) => {
                    if (finalResult.isConfirmed) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Success!',
                            text: finalResult.value.message,
                            width:'400px'
                        }).then(() => {
                            loadSection('profile');
                        });
                    }
                });
            }  else {
                        Swal.fire({ icon: 'success', title: 'Success!', text: result.message, width:'400px', timer: 1500, showConfirmButton: false, customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content' } });
                        closeModal('editProfileModal');
                        setTimeout(() => loadSection('profile'), 1500);
                    }
                } catch (error) { console.error('Error submitting profile update:', error); Swal.fire({ icon: 'error', title: 'Network Error!', text: 'Could not connect to the server.', width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } }); }
            
            } else if (form.id === 'change-password-form' || form.id === 'add-address-form' || form.id === 'edit-address-form') {
                clearErrorMessages(form);
                const isEditAddress = form.id === 'edit-address-form';
                const addressId = isEditAddress ? form.querySelector('#editAddressId').value : null;
                const urlMap = {
                    'change-password-form': '/user/profile/change-password',
                    'add-address-form': '/user/profile/address/add',
                    'edit-address-form': `/user/profile/address/edit/${addressId}`
                };
                const url = urlMap[form.id];
                const formData = new FormData(form);
                const data = Object.fromEntries(formData.entries());
                try {
                    const response = await fetch(url, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(data) });
                    const result = await response.json();
                    if (!response.ok) {
                        if(result.errors) {
                           for (const field in result.errors) {
                                const errorElement = form.querySelector(`#${field}Error, #edit${field.charAt(0).toUpperCase() + field.slice(1)}Error`);
                                if (errorElement) errorElement.textContent = result.errors[field];
                                const inputElement = form.querySelector(`[name="${field}"]`);
                                if (inputElement) inputElement.classList.add('border-red-500');
                           }
                        }
                        Swal.fire({ icon: 'error', title: 'Validation Error!', text: result.message, width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } });
                    } else {
                        Swal.fire({ icon: 'success', title: 'Success!', text: result.message, width:'400px', timer: 1500, showConfirmButton: false, customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content' } });
                        if(form.id.includes('address')) {
                            closeModal(isEditAddress ? 'editAddressModal' : 'addAddressModal');
                            setTimeout(() => loadSection('address'), 1500);
                        }
                        form.reset();
                    }
                } catch (error) { console.error(`Error submitting ${form.id}:`, error); Swal.fire({ icon: 'error', title: 'Network Error!', text: 'Could not connect to server.', width:'400px', customClass: { popup: 'swal-dark-bg', title: 'swal-dark-title', content: 'swal-dark-content', confirmButton: 'swal-dark-button' } }); }
            }
        });
        profileContentArea.addEventListener('change', (e) => {
            if (e.target.id === 'profile-picture-input') {
                const file = e.target.files[0];
                const profileModalImagePreview = document.getElementById('profile-modal-image-preview');
                if (file && profileModalImagePreview) {
                    const reader = new FileReader();
                    reader.onload = (event) => { profileModalImagePreview.src = event.target.result; };
                    reader.readAsDataURL(file);
                }
            } else if (e.target.id === 'addressSelect') {
                const addressIdInput = document.getElementById('addressId');
                const addressSpan = document.getElementById('addressSpan');
                const allAddressesElement = document.getElementById('allAddresses');
                if (addressIdInput && addressSpan && allAddressesElement) {
                    try {
                        const allAddresses = JSON.parse(allAddressesElement.value);
                        const selectedAddress = allAddresses.find(addr => addr._id === e.target.value);
                        if (selectedAddress) {
                            addressSpan.textContent = selectedAddress.name;
                            addressIdInput.value = selectedAddress._id;
                        }
                    } catch(err) { console.error('Failed to parse addresses JSON:', err); }
                }
            }
        });
        const debounce = (func, delay) => { let timeoutId; return (...args) => { clearTimeout(timeoutId); timeoutId = setTimeout(() => func.apply(this, args), delay); }; };
        const performSearch = async (query) => {
            const tableBody = document.getElementById('ordersTableBody');
            if (!tableBody) return;
            tableBody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-gray-400">Searching...</td></tr>`;
            try {
                const response = await fetch(`/user/orders/search?q=${encodeURIComponent(query)}`);
                if (!response.ok) throw new Error('Search request failed');
                tableBody.innerHTML = await response.text();
            } catch (error) {
                console.error('Search error:', error);
                tableBody.innerHTML = `<tr><td colspan="7" class="text-center py-8 text-red-400">Error loading results.</td></tr>`;
            }
        };
        const debouncedSearch = debounce(performSearch, 400);
        profileContentArea.addEventListener('keyup', (e) => {
            if (e.target && e.target.id === 'orderSearch') {
                const query = e.target.value.trim();
                if (query === "") { loadSection('orders'); } else { debouncedSearch(query); }
            }
        });

        //////
        if (variantModal) {
            const colorSelector = document.getElementById('variantModalColorSelector');
            const sizeSelector = document.getElementById('variantModalSizeSelector');
            const addToCartBtn = document.getElementById('modalAddToCartBtn');
            const closeBtn = document.getElementById('closeVariantModalBtn');

            colorSelector.addEventListener('click', (e) => {
                if (e.target.classList.contains('w-6')) {
                    colorSelector.querySelectorAll('.w-6').forEach(dot => dot.classList.remove('border-white'));
                    e.target.classList.add('border-white');
                    const colorIndex = e.target.dataset.index;
                    const selectedColor = variantsData[colorIndex];
                    document.getElementById('variantModalSelectedColor').innerText = selectedColor.colorName;

                    sizeSelector.innerHTML = '';
                    selectedColor.variants.forEach(sizeVar => {
                        const sizeBtn = document.createElement('button');
                        sizeBtn.className = 'border border-gray-600 px-3 py-1 rounded hover:bg-purple-600';
                        sizeBtn.innerText = sizeVar.size;
                        sizeBtn.dataset.size = sizeVar.size;
                        sizeSelector.appendChild(sizeBtn);
                    });
                }
            });

            sizeSelector.addEventListener('click', (e) => {
                if (e.target.tagName === 'BUTTON') {
                    sizeSelector.querySelectorAll('button').forEach(btn => btn.classList.remove('bg-purple-600'));
                    e.target.classList.add('bg-purple-600');
                }
            });

            addToCartBtn.addEventListener('click', async () => {
                const selectedColorEl = colorSelector.querySelector('.border-white');
                const selectedSizeEl = sizeSelector.querySelector('.bg-purple-600');

                if (!selectedColorEl || !selectedSizeEl) {
                    Swal.fire({ icon: 'error', title: 'Selection Missing', text: 'Please select a color and size.' });
                    return;
                }

                const colorName = selectedColorEl.dataset.colorName;
                const size = selectedSizeEl.dataset.size;

                try {
                    const cartResponse = await fetch('/user/cart', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ productId: activeProductId, colorName, size, quantity: 1 })
                    });
                    const cartData = await cartResponse.json();
                    if (!cartResponse.ok) throw new Error(cartData.message);

                    const wishlistResponse = await fetch(`/user/wishlist/remove/${activeProductId}`, { method: 'DELETE' });
                    const wishlistData = await wishlistResponse.json();
                    if (!wishlistResponse.ok) throw new Error(wishlistData.message);
                    
                    closeModal('variantSelectorModal');
                    Swal.fire({ icon: 'success', title: 'Success!', text: 'Item moved to cart!' });
                    loadSection('wishlist'); // Reload the wishlist section

                } catch (error) {
                    console.error("Move to cart error:", error);
                    Swal.fire({ icon: 'error', title: 'Error', text: error.message || 'An error occurred.' });
                }
            });

            closeBtn.addEventListener('click', () => closeModal('variantSelectorModal'));
        }

        //////
        const urlParams = new URLSearchParams(window.location.search);
        const defaultSection = urlParams.get('section') || 'profile';
        const initialLink = document.querySelector(`.sidebar-link[data-section="${defaultSection}"]`);
        if (initialLink) {
            initialLink.click();
        } else {
            document.querySelector('.sidebar-link[data-section="profile"]')?.click();
        }


    });
</script>

