function bindCancelReturnModals() {
  const cancelModal = document.getElementById('cancelModal');
  const returnModal = document.getElementById('returnModal');
  const cancelReasonSelect = document.getElementById('cancelReasonSelect');
  const returnReasonSelect = document.getElementById('returnReasonSelect');
  const customCancelReason = document.getElementById('customCancelReason');
  const customReturnReason = document.getElementById('customReturnReason');

  // Toggle custom reason fields
  function toggleCustomReason(select, customDiv) {
    if (select?.value === 'other') {
      customDiv?.classList.remove('hidden');
    } else {
      customDiv?.classList.add('hidden');
    }
  }

  cancelReasonSelect?.addEventListener('change', () => toggleCustomReason(cancelReasonSelect, customCancelReason));
  returnReasonSelect?.addEventListener('change', () => toggleCustomReason(returnReasonSelect, customReturnReason));

  // Modal backdrop close
  [cancelModal, returnModal].forEach(modal => {
    if (modal) {
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal(modal.id);
      });
    }
  });

  // Cancel Form Submission
  const cancelForm = document.getElementById('cancelForm');
  if (cancelForm) {
    cancelForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const orderId = document.getElementById('cancelOrderId').value;
      const reasonSelect = document.getElementById('cancelReasonSelect');
      const customReason = document.getElementById('cancel-note');
      
      let reason = reasonSelect.value;
      if (reason === 'other' && customReason?.value.trim()) {
        reason = customReason.value.trim();
      }
      
      if (!reason) {
        Swal.fire({
          title: 'Required!',
          text: 'Please select a cancellation reason.',
          icon: 'warning',
          toast: true,
          position: 'top-end'
        });
        return;
      }

      const url = `/user/orders/${orderId}/request-cancellation`;
      try {
        const resp = await fetch(url, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason }),
        });
        const data = await resp.json();
        
        if (resp.ok) {
          Swal.fire({
            title: 'Success!',
            text: 'Cancellation request submitted!',
            icon: 'success',
            toast: true,
            position: 'top-end',
            timer: 2500,
            showConfirmButton: false,
            timerProgressBar: true
          });
          closeModal('cancelModal');
          setTimeout(() => window.location.href = '/user/profile?section=orders', 500);
        } else {
          Swal.fire({
            title: 'Error!',
            text: data.message || 'Failed to cancel order.',
            icon: 'error',
            toast: true,
            position: 'top-end'
          });
        }
      } catch (error) {
        Swal.fire({
          title: 'Error!',
          text: 'Network error. Please try again.',
          icon: 'error',
          toast: true,
          position: 'top-end'
        });
      }
    });
  }

  // Return Form Submission
  const returnForm = document.getElementById('returnForm');
  if (returnForm) {
    returnForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const orderId = document.getElementById('returnOrderId').value;
      const reasonSelect = document.getElementById('returnReasonSelect');
      const customReason = document.getElementById('returnNote');
      
      let reason = reasonSelect.value;
      if (reason === 'other' && customReason?.value.trim()) {
        reason = customReason.value.trim();
      }
      
      if (!reason) {
        Swal.fire({
          title: 'Required!',
          text: 'Please select a return reason.',
          icon: 'warning',
          toast: true,
          position: 'top-end'
        });
        return;
      }

      const url = `/user/orders/${orderId}/request-return`;
      try {
        const resp = await fetch(url, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ reason }),
        });
        const data = await resp.json();
        
        if (resp.ok) {
          Swal.fire({
            title: 'Success!',
            text: 'Return request submitted!',
            icon: 'success',
            toast: true,
            position: 'top-end',
            timer: 2500,
            showConfirmButton: false,
            timerProgressBar: true
          });
          closeModal('returnModal');
          setTimeout(() => window.location.href = '/user/profile?section=orders', 500);
        } else {
          Swal.fire({
            title: 'Error!',
            text: data.message || 'Failed to request return.',
            icon: 'error',
            toast: true,
            position: 'top-end'
          });
        }
      } catch (error) {
        Swal.fire({
          title: 'Error!',
          text: 'Network error. Please try again.',
          icon: 'error',
          toast: true,
          position: 'top-end'
        });
      }
    });
  }
}

