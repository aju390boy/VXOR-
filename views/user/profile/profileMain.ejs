            const errorMsg = form.querySelector(`#${input.name}Error`);
            if (errorMsg) errorMsg.textContent = '';
        };

        // Helper to show error
        const setErrorMessage = (input, msg) => {
            input.classList.add('border-red-500');
            let errorMsg = form.querySelector(`#${input.name}Error`);
            if (!errorMsg) {
                errorMsg = document.createElement('div');
                errorMsg.className = 'error-message text-red-500 text-xs mt-1';
                errorMsg.id = `${input.name}Error`;
                input.parentNode.appendChild(errorMsg);
            }
            errorMsg.textContent = msg;
        };

        // 1. Reset fields if length is not 6
        if (pin.length !== 6) {
            cityInput.value = '';
            stateInput.value = '';
            countryInput.value = '';
            return;
        }

        // 2. Validate format (numbers only)
        if (!/^[0-9]{6}$/.test(pin)) {
            setErrorMessage(pincodeInput, "Pincode must be 6 digits");
            return;
        }

        // 3. Fetch Data
        try {
            // Optional: Show loading state
            cityInput.placeholder = "Loading...";
             stateInput.placeholder = "Loading...";
              countryInput.placeholder = "Loading...";
            
            const res = await fetch(`https://api.postalpincode.in/pincode/${pin}`);
            const data = await res.json();

            if (data[0].Status === "Success") {
                const info = data[0].PostOffice[0];

                // Auto-fill inputs
                cityInput.value = info.District || "";
                stateInput.value = info.State || "";
                countryInput.value = info.Country || "India";

                // Clear any previous errors
                clearError(pincodeInput);
                clearError(cityInput);
                clearError(stateInput);
                clearError(countryInput);
            } else {
                setErrorMessage(pincodeInput, "INVALID PINCODE,LOCATION NOT FOUND");
                cityInput.value = '';
                stateInput.value = '';
                countryInput.value = '';
            }
        } catch (error) {
            console.error(error);
            setErrorMessage(pincodeInput, "Network error. Unable to fetch location.");
        } finally {
            cityInput.placeholder = ""; 
        }
    });
}
//////////////////

</script>

