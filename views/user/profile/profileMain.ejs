    ///////////////Profile validation//////////////////
   function validateProfileForm(form) {
    let isValid = true;
    const firstname = form.querySelector('[name="firstname"]');
    const lastname = form.querySelector('[name="lastname"]');
    const email = form.querySelector('[name="email"]');
    const mobile = form.querySelector('[name="mobile"]');
    const addressId = form.querySelector('[name="addressId"]');
    
    function showError(input, message) {
        if (!input) return;
        input.classList.add('border-red-500');
        let errorMsg = form.querySelector(`#${input.name}Error`);
        if (!errorMsg) {
            errorMsg = document.createElement('div');
            errorMsg.className = 'error-message text-red-500 text-xs mt-1';
            errorMsg.id = `${input.name}Error`;
            input.parentNode.appendChild(errorMsg);
        }
        errorMsg.textContent = message;
        isValid = false;
    }
    
    clearErrorMessages(form);

    // First name: required, min 2 chars, alphabets/spaces/hyphens/dots only
    if (firstname) {
        console.log('first name exists.............')
        const val = firstname.value.trim();
        if (!val) {
            showError(firstname, "First name is required.");
        } else if (val.length < 2) {
            showError(firstname, "First name must be at least 2 characters.");
        } else if (!/^[A-Za-z\s\-\.]+$/.test(val)) {
            showError(firstname, "First name must contain only letters, spaces, hyphens, or dots.");
        }
    }

    // Last name: required, min 2 chars, alphabets/spaces/hyphens/dots only
    if (lastname) {
        const val = lastname.value.trim();
        if (!val) {
            showError(lastname, "Last name is required.");
        } else if (val.length < 0) {
            showError(lastname, "Last name must be at least 2 characters.");
        } else if (!/^[A-Za-z\s\-\.]+$/.test(val)) {
            showError(lastname, "Last name must contain only letters, spaces, hyphens, or dots.");
        }
    }
    
    // Email: required, valid format
    if (email) {
        const val = email.value.trim();
        if (!val) {
            showError(email, "Email is required.");
        } else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val)) {
            showError(email, "Please enter a valid email address.");
        }
    }
    
    // Mobile: optional, if filled must be 10 digits starting with 6-9
    if (mobile) {
        const val = mobile.value.trim();
        if (val && !/^[6-9]\d{9}$/.test(val)) {
            showError(mobile, "Enter a valid 10-digit mobile number starting with 6-9.");
        }
    }
    
    // Address ID: optional, valid MongoDB ObjectId format (24 hex chars)
    if (addressId) {
        const val = addressId.value.trim();
        if (val && !/^[a-fA-F0-9]{24}$/.test(val)) {
            showError(addressId, "Invalid address ID.");
        }
    }
    
    return isValid;
}

    /////////////Address validation//////////////
    function validateAddressForm(form) {
    let isValid = true;
    const name = form.querySelector('[name="name"]');
    const mobile = form.querySelector('[name="mobile"]');
    const address1 = form.querySelector('[name="address1"]');
    const address2 = form.querySelector('[name="address2"]');
    const city = form.querySelector('[name="city"]');
    const state = form.querySelector('[name="state"]');
    const pincode = form.querySelector('[name="pincode"]');
    const country = form.querySelector('[name="country"]');
    
    function showError(input, message) {
        input.classList.add('border-red-500');
        let errorMsg = form.querySelector(`#${input.name}Error`);
        if (!errorMsg) {
            errorMsg = document.createElement('div');
            errorMsg.className = 'error-message text-red-500 text-xs mt-1';
            errorMsg.id = `${input.name}Error`;
            input.parentNode.appendChild(errorMsg);
        }
        errorMsg.textContent = message;
        isValid = false;
    }
    clearErrorMessages(form);
    const alphaRegex = /^[A-Za-z\s\-\.]+$/;
    if (!name.value.trim() || !alphaRegex.test(name.value.trim())) {
        showError(name, "Name must contain only alphabets");
    }
    if (!address1.value.trim() || !address1.value.trim()) {
        showError(address1, "Address line 1 is Empty");
    }
    if (address2 && address2.value && !address2.value.trim()) {
        showError(address2, "Address line 2 is Empty");
    }
    if (!city.value.trim() || !alphaRegex.test(city.value.trim())) {
        showError(city, "City is Requered (Enter valid pincode)");
    }
    if (!state.value.trim() || !alphaRegex.test(state.value.trim())) {
        showError(state, "State is Requered (Enter valid pincode)");
    }
    if (!country.value.trim() || !alphaRegex.test(country.value.trim())) {
        showError(country, "Country is Requered (Enter valid pincode)");
    }
    const mobileRegex = /^[6-9]\d{9}$/;
    if (!mobile.value.match(mobileRegex)) {
        showError(mobile, "Enter a valid 10-digit mobile number.");
    }
    const pincodeRegex = /^[1-9]{1}[0-9]{2}\s{0,1}[0-9]{3}$/;
    if (!pincode.value.match(pincodeRegex)) {
        showError(pincode, "Enter a valid 6-digit Indian pincode (e.g., 110001 or 110 001).");
    }
    return isValid;
}

