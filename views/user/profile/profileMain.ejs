document.addEventListener('click', (event) => {
  if (event.target.classList.contains('prevPageBtn') || event.target.classList.contains('nextPageBtn')) {
    const container = event.target.closest('.pagination-container');
    if (!container) return;
    const section = container.dataset.section;
    const pageIndicator = container.querySelector('.pageIndicator');
    if (!pageIndicator) return;
    const text = pageIndicator.textContent;
    const match = text.match(/\d+/g);
    const currentPage = parseInt(match[0]);
    const totalPages = parseInt(match[1]);
    let newPage = currentPage;
    if (event.target.classList.contains('prevPageBtn') && currentPage > 1) {
      newPage = currentPage - 1;
    } else if (event.target.classList.contains('nextPageBtn') && currentPage < totalPages) {
      newPage = currentPage + 1;
    }

    if (newPage !== currentPage) {
      changePage(newPage, section);
    }
  }
});
function changePage(page, section) {
  const limit = 5; 
  fetch(`/user/profile/section/${section}?page=${page}&limit=${limit}`)
    .then(response => response.text())
    .then(html => {
      document.getElementById('profile-content').innerHTML = html;
    })
    .catch(err => console.error(`Error loading ${section} page:`, err));
}

// REFERRAL COPY FUNCTIONALITY
function initReferralCopy() {
    const copyBtn = document.getElementById('copyReferralBtn');
    const codeEl = document.getElementById('referralCodeText');
    const statusEl = document.getElementById('copyStatus');
    if (copyBtn && codeEl) {
        copyBtn.addEventListener('click', async () => {
            const text = codeEl.textContent.trim();
            try {
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    await navigator.clipboard.writeText(text);
                } else {
                    const temp = document.createElement('textarea');
                    temp.value = text;
                    temp.setAttribute('readonly', '');
                    temp.style.position = 'absolute';
                    temp.style.left = '-9999px';
                    document.body.appendChild(temp);
                    temp.select();
                    document.execCommand('copy');
                    document.body.removeChild(temp);
                }
                const originalIcon = copyBtn.innerHTML;
                copyBtn.innerHTML = `
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                    </svg>
                `;
                copyBtn.classList.add('bg-emerald-500', 'hover:bg-emerald-400');
                copyBtn.classList.remove('from-pink-500', 'to-purple-500');
                if (statusEl) {
                    const originalText = statusEl.textContent;
                    statusEl.textContent = '✅ Copied to clipboard!';
                    statusEl.className = 'mt-8 text-center text-sm text-emerald-400 font-bold animate-pulse';
                }
                setTimeout(() => {
                    copyBtn.innerHTML = originalIcon;
                    copyBtn.classList.remove('bg-emerald-500', 'hover:bg-emerald-400');
                    copyBtn.classList.add('bg-gradient-to-r', 'from-pink-500', 'via-purple-500', 'to-pink-500');
                    if (statusEl) {
                        statusEl.textContent = 'Share your code with friends to start earning rewards instantly.';
                        statusEl.className = 'mt-8 text-center text-sm text-gray-400 font-medium';
                    }
                }, 2000);
            } catch (err) {
                console.error('Copy failed:', err);
                if (statusEl) {
                    statusEl.textContent = '❌ Failed to copy';
                    statusEl.className = 'mt-8 text-center text-sm text-red-400';
                    setTimeout(() => {
                        statusEl.className = 'mt-8 text-center text-sm text-gray-400';
                        statusEl.textContent = 'Share your code with friends to start earning rewards instantly.';
                    }, 2000);
                }
            }
        });
    }
}
