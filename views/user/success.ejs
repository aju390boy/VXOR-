<div class="bg-gray-900 min-h-screen text-white flex flex-col items-center justify-center px-6 py-12">
  
  <!-- Green Tick Icon -->
  <div class="bg-green-600 rounded-full p-6 mb-6 shadow-lg">
    <svg xmlns="http://www.w3.org/2000/svg" class="h-16 w-16 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
    </svg>
  </div>

  <!-- Dynamic Thank You Text -->
  <% if (paymentMethod === 'COD') { %>
    <h1 class="text-3xl font-bold mb-2">Order Placed Successfully!</h1>
    <p class="text-gray-400 text-center max-w-md mb-8">
      Thank you for your order. We've received your request and will process it shortly. Please have the cash ready at the time of delivery. A confirmation email has been sent to your registered email address.
    </p>
  <% } else { %>
    <h1 class="text-3xl font-bold mb-2">Thank You for Shopping!</h1>
    <p class="text-gray-400 text-center max-w-md mb-8">
      Your payment was processed successfully. We truly appreciate your trust in us and can’t wait for you to enjoy your purchase. 
      A confirmation email has been sent to your registered email address.
    </p>
 <p class="text-md text-gray-400 mb-8">
            Your order ID is: <span class="font-mono text-white bg-gray-700 px-2 py-1 rounded-md">#<%= orderId %></span>
        </p>
  <% } %>

  <!-- Buttons -->
  <div class="flex gap-4">
    <a href="/user/product" class="bg-indigo-600 hover:bg-indigo-700 px-6 py-3 rounded-lg font-semibold transition">
      Continue Shopping
    </a>
    <a href="/user/profile?section=orders" class="bg-gray-700 hover:bg-gray-600 px-6 py-3 rounded-lg font-semibold transition">
      View Order
    </a>
  </div>

</div>

