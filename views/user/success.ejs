<style>
  /* Import stylish and readable fonts */
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Poppins:wght@400;600&display=swap');

  body {
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .font-playfair { font-family: 'Playfair Display', serif; }
  .font-poppins { font-family: 'Poppins', sans-serif; }
  
  /* Animated Background */
  .animated-bg {
    background-color: #0d0d1a;
    overflow: hidden; 
  }

  /* Keyframe animation for drawing the checkmark */
  .checkmark__circle {
    stroke-dasharray: 166;
    stroke-dashoffset: 166;
    stroke-width: 3;
    stroke-miterlimit: 10;
    stroke: #4BB543;
    fill: none;
    animation: stroke 0.6s cubic-bezier(0.65, 0, 0.45, 1) 0.5s forwards;
  }
  .checkmark {
    width: 90px;
    height: 90px;
    border-radius: 50%;
    display: block;
    stroke-width: 3;
    stroke: #fff;
    stroke-miterlimit: 10;
    margin: 0 auto;
    box-shadow: inset 0px 0px 0px #4BB543;
    animation: fill .4s ease-in-out .9s forwards, scale .3s ease-in-out 1.4s both;
  }
  .checkmark__check {
    transform-origin: 50% 50%;
    stroke-dasharray: 48;
    stroke-dashoffset: 48;
    animation: stroke 0.3s cubic-bezier(0.65, 0, 0.45, 1) 1.3s forwards;
  }
  @keyframes stroke {
    100% { stroke-dashoffset: 0; }
  }
  @keyframes scale {
    0%, 100% { transform: none; }
    50% { transform: scale3d(1.1, 1.1, 1); }
  }
  @keyframes fill {
    100% { box-shadow: inset 0px 0px 0px 45px #4BB543; }
  }

  /* Staggered fade-in animation for content */
  .fade-in-up {
    opacity: 0;
    transform: translateY(30px);
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* Glassmorphism Card Style */
  .glass-card {
    
    animation: card-fade-in 1s ease forwards;
  }
  
  @keyframes card-fade-in {
      from {
          opacity: 0;
          transform: scale(0.95);
      }
      to {
          opacity: 1;
          transform: scale(1);
      }
  }

  .delay-anim-1 { animation-delay: 1.6s; }
  .delay-anim-2 { animation-delay: 1.8s; }
  .delay-anim-3 { animation-delay: 2.0s; }
  .delay-anim-4 { animation-delay: 2.2s; }
  
  /* Canvases for animations */
  .animation-canvas {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 10;
    pointer-events: none;
  }
</style>

<!-- Main page container -->
<div class="font-poppins animated-bg min-h-screen text-white flex flex-col items-center justify-center p-4 sm:p-6 relative">
  
  <!-- Canvas for 2D animations -->
  <canvas id="fireworks-2d-canvas" class="animation-canvas"></canvas>
  <!-- Canvas for 3D explosions -->
  <canvas id="fireworks-3d-canvas" class="animation-canvas"></canvas>

  <!-- Main content card -->
  <div class="glass-card w-full max-w-xl rounded-2xl p-8 sm:p-12 text-center z-20">

    <!-- Animated Success Icon -->
    <div class="mb-6">
       <svg class="checkmark" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 52 52">
         <circle class="checkmark__circle" cx="26" cy="26" r="25" fill="none"/>
         <path class="checkmark__check" fill="none" d="M14.1 27.2l7.1 7.2 16.7-16.8"/>
       </svg>
    </div>

    <!-- Conditional content based on payment method -->
    <% if (paymentMethod === 'COD') { %>
      <h1 class="font-playfair text-4xl sm:text-5xl font-bold mb-4 text-white fade-in-up delay-anim-1">
        Order Placed Successfully!
      </h1>
      <p class="text-gray-300 text-base max-w-lg mx-auto mb-8 fade-in-up delay-anim-2">
        Thank you! Your order is confirmed and will be delivered soon. Please keep the exact cash amount ready for our delivery partner.
      </p>
    <% } else { %>
      <h1 class="font-playfair text-4xl sm:text-5xl font-bold mb-4 text-white fade-in-up delay-anim-1">
        Thank You For Your Purchase!
      </h1>
      <p class="text-gray-300 text-base max-w-lg mx-auto mb-6 fade-in-up delay-anim-2">
        Your payment was successful and your order is being prepared with care. We can't wait for you to receive it.
      </p>
      <!-- Order ID Display -->
      <div class="my-8 inline-block fade-in-up delay-anim-3">
         <p class="text-sm text-gray-400">
          Your Order ID is <br class="sm:hidden">
          <span class="mt-2 inline-block font-mono text-white bg-black/20 px-4 py-2 rounded-lg tracking-wider text-base border border-gray-700"><%= customId ||orderId %></span>
        </p>
      </div>
    <% } %>

    <!-- Action Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center mt-6 fade-in-up delay-anim-4">
      <a href="/user/product" 
         class="bg-white/10 border border-white/20 hover:bg-white/20 px-8 py-3 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 shadow-lg focus:outline-none focus:ring-4 focus:ring-white/30">
        Continue Shopping
      </a>
      <a href="/user/orders/<%=orderId%>"
         class="bg-transparent border border-white/20 hover:bg-white/10 px-8 py-3 rounded-lg font-semibold transition-all duration-300 transform hover:scale-105 focus:outline-none focus:ring-4 focus:ring-white/20">
        View Order Details
      </a>
    </div>
  </div>
</div>

<!-- Import three.js library -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

<!-- Combined 2D + 3D Fireworks Script -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    if (typeof THREE === 'undefined') {
        console.error('three.js not loaded');
        return;
    }

    // --- Shared variables ---
    let w = window.innerWidth;
    let h = window.innerHeight;
    const fluorescentColors = [
        new THREE.Color(0x00ffdd), // Fluorescent Teal
        new THREE.Color(0xff00ff), // Magenta
        new THREE.Color(0x00ff00), // Lime Green
        new THREE.Color(0xffff00), // Bright Yellow
        new THREE.Color(0xff4500)  // Orange Red
    ];
    function random(min, max) { return Math.random() * (max - min) + min; }

    // --- 3D Setup (Explosions) ---
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(75, w / h, 0.1, 1000);
    const canvas3D = document.getElementById('fireworks-3d-canvas');
    const renderer = new THREE.WebGLRenderer({ canvas: canvas3D, alpha: true });
    renderer.setSize(w, h);
    camera.position.z = 50;
    const explosions3D = [];

    // --- 2D Setup (Rockets & Explosions) ---
    const canvas2D = document.getElementById('fireworks-2d-canvas');
    const ctx2D = canvas2D.getContext('2d');
    canvas2D.width = w;
    canvas2D.height = h;
    const rockets = [];
    const particles2D = [];

    // --- 2D Rocket Class ---
    function Rocket(targetX, targetY, targetColor) {
        this.x = w / 2;
        this.y = h;
        this.tx = targetX;
        this.ty = targetY;
        this.color = targetColor;
        this.explosionType = Math.random() < 0.5 ? '2d' : '3d'; // Randomly choose explosion type
        this.distanceToTarget = Math.hypot(targetX - this.x, targetY - this.y);
        this.distanceTraveled = 0;
        this.coordinates = [];
        this.coordinateCount = 3;
        while(this.coordinateCount--) this.coordinates.push([this.x, this.y]);
        this.angle = Math.atan2(targetY - this.y, targetX - this.x);
        this.speed = 1;
        this.acceleration = 1.05;
    }

    Rocket.prototype.update = function(index) {
        this.coordinates.pop();
        this.coordinates.unshift([this.x, this.y]);
        this.speed *= this.acceleration;
        const vx = Math.cos(this.angle) * this.speed;
        const vy = Math.sin(this.angle) * this.speed;
        this.distanceTraveled = Math.hypot(this.x - w / 2, this.y - h);

        if (this.distanceTraveled >= this.distanceToTarget) {
            if (this.explosionType === '3d') {
                const vec = new THREE.Vector3((this.tx / w) * 2 - 1, -(this.ty / h) * 2 + 1, 0.5);
                vec.unproject(camera);
                const dir = vec.sub(camera.position).normalize();
                const distance = -camera.position.z / dir.z;
                const pos = camera.position.clone().add(dir.multiplyScalar(distance));
                create3DExplosion(pos, this.color);
            } else {
                create2DExplosion(this.tx, this.ty, this.color);
            }
            rockets.splice(index, 1);
        } else {
            this.x += vx;
            this.y += vy;
        }
    };

    Rocket.prototype.draw = function() {
        ctx2D.beginPath();
        ctx2D.moveTo(this.coordinates[this.coordinates.length - 1][0], this.coordinates[this.coordinates.length - 1][1]);
        ctx2D.lineTo(this.x, this.y);
        ctx2D.strokeStyle = this.color.getStyle();
        ctx2D.stroke();
    };

    // --- 2D Particle Class ---
    function Particle2D(x, y, color) {
        this.x = x;
        this.y = y;
        this.color = color;
        this.coordinates = [];
        this.coordinateCount = 5;
        while(this.coordinateCount--) this.coordinates.push([this.x, this.y]);
        this.angle = random(0, Math.PI * 2);
        this.speed = random(1, 20);
        this.friction = 0.95;
        this.gravity = 1;
        this.alpha = 1;
        this.decay = random(0.015, 0.03);
    }

    Particle2D.prototype.update = function(index) {
        this.coordinates.pop();
        this.coordinates.unshift([this.x, this.y]);
        this.speed *= this.friction;
        this.x += Math.cos(this.angle) * this.speed;
        this.y += Math.sin(this.angle) * this.speed + this.gravity;
        this.alpha -= this.decay;
        if (this.alpha <= this.decay) particles2D.splice(index, 1);
    };

    Particle2D.prototype.draw = function() {
        ctx2D.beginPath();
        ctx2D.moveTo(this.coordinates[this.coordinates.length - 1][0], this.coordinates[this.coordinates.length - 1][1]);
        ctx2D.lineTo(this.x, this.y);
        const hsl = { h: 0, s: 0, l: 0 };
        this.color.getHSL(hsl);
        ctx2D.strokeStyle = `hsla(${hsl.h * 360}, 100%, ${hsl.l * 100}%, ${this.alpha})`;
        ctx2D.stroke();
    };
    
    function create2DExplosion(x, y, color) {
        let particleCount = 100;
        while(particleCount--) {
            particles2D.push(new Particle2D(x, y, color));
        }
    }

    // --- 3D Explosion Function ---
    function create3DExplosion(position, color) {
        const explosion = { lifetime: 1.5, startTime: Date.now() };
        const particleCount = 500;
        const geometry = new THREE.BufferGeometry();
        const positions = [], velocities = [];

        for (let i = 0; i < particleCount; i++) {
            const vertex = new THREE.Vector3((Math.random()-0.5), (Math.random()-0.5), (Math.random()-0.5));
            vertex.normalize().multiplyScalar(Math.random() * 20 + 5);
            velocities.push(vertex);
            positions.push(0, 0, 0);
        }
        
        geometry.setAttribute('position', new THREE.Float32BufferAttribute(positions, 3));
        const material = new THREE.PointsMaterial({ size: 0.5, color: color, blending: THREE.AdditiveBlending, depthWrite: false, transparent: true, opacity: 1.0 });
        const points = new THREE.Points(geometry, material);
        points.position.copy(position);
        
        explosion.mesh = points;
        explosion.velocities = velocities;
        scene.add(points);
        explosions3D.push(explosion);
    }
    
    // --- Main Animation Loop ---
    function animate() {
        requestAnimationFrame(animate);

        // Animate 2D Canvas (Rockets and Particles)
        ctx2D.globalCompositeOperation = 'destination-out';
        ctx2D.fillStyle = 'rgba(0, 0, 0, 0.5)';
        ctx2D.fillRect(0, 0, w, h);
        ctx2D.globalCompositeOperation = 'lighter';
        rockets.forEach((r, i) => { r.draw(); r.update(i); });
        particles2D.forEach((p, i) => { p.draw(); p.update(i); });

        // Animate 3D Canvas (Explosions)
        const now = Date.now();
        for (let i = explosions3D.length - 1; i >= 0; i--) {
            const explosion = explosions3D[i];
            const elapsedTime = (now - explosion.startTime) / 1000;
            const progress = elapsedTime / explosion.lifetime;

            if (progress > 1) {
                scene.remove(explosion.mesh);
                explosions3D.splice(i, 1);
                continue;
            }

            const positions = explosion.mesh.geometry.attributes.position.array;
            for (let j = 0; j < explosion.velocities.length; j++) {
                const index = j * 3;
                const velocity = explosion.velocities[j];
                velocity.multiplyScalar(1.01); // Add acceleration
                positions[index] += velocity.x * 0.01;
                positions[index + 1] += velocity.y * 0.01;
                positions[index + 2] += velocity.z * 0.01;
                velocity.y -= 0.2; // Gravity
            }

            explosion.mesh.geometry.attributes.position.needsUpdate = true;
            explosion.mesh.material.opacity = 1 - progress;
        }

        renderer.render(scene, camera);
    }

    // --- Launch Control ---
    function launchLoop() {
        const targetX = random(w * 0.2, w * 0.8);
        const targetY = random(h * 0.2, h * 0.5);
        const color = fluorescentColors[Math.floor(random(0, fluorescentColors.length))];
        rockets.push(new Rocket(targetX, targetY, color));
        setTimeout(launchLoop, random(800, 1500)); // Slower continuous launch
    }

    function initialBurst(isFinalBurst = false) {
        const burstCount = 10; 
        const stagger = 20; 
        for (let i = 0; i < burstCount; i++) {
            setTimeout(() => {
                const targetX = random(w * 0.1, w * 0.9);
                const targetY = random(h * 0.1, h * 0.6);
                const color = fluorescentColors[Math.floor(random(0, fluorescentColors.length))];
                rockets.push(new Rocket(targetX, targetY, color));
            }, i * stagger); 
        }
        
        if (isFinalBurst) {
            setTimeout(launchLoop, burstCount * stagger + 500); 
        }
    }
    
    window.addEventListener('resize', () => {
        w = window.innerWidth;
        h = window.innerHeight;
        camera.aspect = w / h;
        camera.updateProjectionMatrix();
        renderer.setSize(w, h);
        canvas2D.width = w;
        canvas2D.height = h;
    });

    animate();
    
    // Start with the grand initial burst after the checkmark animation
    setTimeout(() => {
        const totalBursts = 20;
        const burstInterval = 10;

        for (let i = 0; i < totalBursts; i++) {
            setTimeout(() => {
                // Pass true only on the last iteration to start the continuous loop
                initialBurst(i === totalBursts - 1);
            }, i * burstInterval);
        }
    }, 1000);
  });
</script>