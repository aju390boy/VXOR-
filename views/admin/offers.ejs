<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Offer Management</title>
  <link rel="stylesheet" href="/styles/admin/adminnavbar.css">
  <link rel="stylesheet" href="/styles/admin/adminsidebar.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/choices.js/public/assets/styles/choices.min.css" />
<script src="https://cdn.jsdelivr.net/npm/choices.js/public/assets/scripts/choices.min.js" defer></script>
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
  <style>
    /* Paste the entire <style> block from your category.ejs here */
    /* All your custom CSS for table, modal, forms, etc. goes here */
    .admin-wrapper { display: flex; min-height: 100vh; }
    .admin-main { flex-grow: 1; padding: 2rem; background-color: #f8f9fa; }
    .breadcrumb { margin-bottom: 1.5rem; font-size: 0.9rem; color: #6c757d; }
    .category-table { width: 100%; border-collapse: collapse; margin-top: 2rem; background-color: #ffffff; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); border-radius: 0.5rem; overflow: hidden; }
    .category-table th, .category-table td { padding: 1rem 1.25rem; text-align: left; border-bottom: 1px solid #e2e8f0; }
    .category-table th { background-color: #f1f5f9; font-weight: 600; color: #334155; text-transform: uppercase; font-size: 0.875rem; }
    .category-table tbody tr:last-child td { border-bottom: none; }
    .category-table tbody tr:hover { background-color: #fbfdff; }
    .switch { position: relative; display: inline-block; width: 40px; height: 24px; }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .4s; border-radius: 24px; }
    .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 4px; bottom: 4px; background-color: white; transition: .4s; border-radius: 50%; }
    input:checked + .slider { background-color: #4CAF50; }
    input:focus + .slider { box-shadow: 0 0 1px #4CAF50; }
    input:checked + .slider:before { transform: translateX(16px); }
    .add-category-section { background-color: #ffffff; padding: 2rem; border-radius: 0.5rem; box-shadow: 0 0.125rem 0.25rem rgba(0, 0, 0, 0.075); margin-top: 2rem; }
    .add-category-section h2 { font-size: 1.75rem; font-weight: 700; margin-bottom: 1.5rem; color: #1a202c; }
    .add-category-form label, #editOfferForm label { display: block; margin-bottom: 0.5rem; font-weight: 600; color: #4a5568; margin-top: 1rem; }
    .add-category-form input[type="text"], .add-category-form input[type="number"], .add-category-form input[type="date"], .add-category-form textarea, #editOfferForm input[type="text"], #editOfferForm input[type="number"], #editOfferForm input[type="date"], #editOfferForm textarea { width: 100%; padding: 0.75rem; border: 1px solid #cbd5e0; border-radius: 0.375rem; font-size: 1rem; box-sizing: border-box; transition: border-color 0.2s ease, box-shadow 0.2s ease; }
    .add-category-form input[type="text"]:focus, .add-category-form input[type="number"]:focus, .add-category-form input[type="date"]:focus, .add-category-form textarea:focus, #editOfferForm input[type="text"]:focus, #editOfferForm input[type="number"]:focus, #editOfferForm input[type="date"]:focus, #editOfferForm textarea:focus { border-color: #4299e1; box-shadow: 0 0 0 3px rgba(66, 153, 225, 0.5); outline: none; }
    .add-category-form textarea, #editOfferForm textarea { min-height: 80px; resize: vertical; }
    .pagination { margin-top: 30px; text-align: center; }
    .pagination a { display: inline-block; padding: 8px 14px; margin: 0 5px; border: 1px solid #ddd; border-radius: 5px; background-color: #f9f9f9; color: #333; text-decoration: none; transition: all 0.3s ease; }
    .pagination a:hover { background-color: #007bff; color: white; border-color: #007bff; }
    .pagination a.active { background-color: black; color: white; border-color: black; }
    .modal { display: none; position: fixed; z-index: 1000; left: 0; top: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.6); justify-content: center; align-items: center; }
    .modal-content { background: #fff; padding: 30px; border-radius: 12px; width: 90%; max-width: 450px; position: relative; animation: fadeIn 0.3s ease-in-out; box-shadow: 0 10px 20px rgba(0, 0, 0, 0.19), 0 6px 6px rgba(0, 0, 0, 0.23); }
    .modal-content h2 { margin-top: 0; margin-bottom: 1.5rem; font-size: 1.75rem; color: #1a202c; text-align: center; }
    .modal-content .close { position: absolute; right: 15px; top: 10px; font-size: 28px; cursor: pointer; color: #a0aec0; transition: color 0.2s ease; }
    .modal-content .close:hover { color: #e53e3e; }
    #editModal .modal-content form {
    max-height: 80vh; /* Sets the max height to 65% of the browser window's height */
    overflow-y: auto; /* Adds a scrollbar ONLY if the content is taller than the max-height */
    padding-right: 10px; /* Adds a little space so the scrollbar doesn't overlap content */
}
    @keyframes fadeIn { from { opacity: 0; transform: translateY(-20px) scale(0.95); } to { opacity: 1; transform: translateY(0) scale(1); } }
  </style>
</head>
<body>

<%- include('../partials/admin/adminnavbar') %>

<div class="admin-wrapper">
  <%- include('../partials/admin/adminsidebar', { current: 'offers' }) %>

  <div class="admin-main" style="margin-left: 250px; margin-top: 85px;">
    <div class="breadcrumb">Admin > Offers</div>

    <div class="bg-white p-6 rounded-lg shadow-md">
        <h2 class="text-2xl font-bold mb-4 text-gray-800">Existing Offers</h2>
        <table class="category-table">
          <thead>
            <tr>
              <th>No</th>
              <th>Offer Name</th>
              <th>Discount</th>
              <th>Start Date</th>
              <th>End Date</th>
              <th>Status</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>
            <% if (offers.length > 0) { %>
              <% offers.forEach((offer, index) => { %>
                <tr id="offer-row-<%= offer._id %>">
                  <td><%= index + 1 %></td>
                  <td><%= offer.name %></td>
                  <td><%= offer.discountPercentage %>%</td>
                  <td><%= new Date(offer.startDate).toLocaleDateString() %></td>
                  <td><%= new Date(offer.endDate).toLocaleDateString() %></td>
                  <td>
                  <form action="/admin/offers/<%= offer._id %>/toggle?_method=PATCH" method="POST">
                      <label class="switch">
                        <input type="checkbox" name="status" onchange="this.form.submit()" <%= offer.isActive ? 'checked' : '' %>>
                        <span class="slider round"></span>
                      </label>
                    </form>
                  </td>
                  <td>
                      <button type="button" class="bg-blue-500 hover:bg-blue-600 text-white font-bold py-2 px-4 rounded-lg inline-flex items-center transition-colors duration-200"
  
                             onclick="openEditModal(
                             this, 
                            '<%= offer.name %>', 
                            '<%= offer.discountPercentage %>', 
                            '<%= offer.startDate.toISOString().split('T')[0] %>', 
                            '<%= offer.endDate.toISOString().split('T')[0] %>'
                           )"

                          data-id='<%= offer._id %>'
                          data-categories='<%- JSON.stringify(offer.applicable_on_category) %>'
                          data-products='<%- JSON.stringify(offer.applicable_on_product) %>'
                          data-brands='<%- JSON.stringify(offer.applicable_on_brand) %>'
                           ...>
                          <i class="fas fa-pen mr-2"></i> Edit
                      </button>
                      <button type="button" 
                        class="bg-red-500 hover:bg-red-600 text-white font-bold py-2 px-4 rounded-lg inline-flex items-center ml-2 transition-colors duration-200 delete-offer-btn" 
                        data-offer-id="<%= offer._id %>">
                        <i class="fas fa-trash mr-2"></i> Delete
                      </button>
                  </td>
                </tr>
              <% }) %>
            <% } else { %>
              <tr>
                <td colspan="7" class="text-center py-4 text-gray-500">No offers found.</td>
              </tr>
            <% } %>
          </tbody>
        </table>
    </div>
    <div class="add-category-section mt-8">
      <h2>ADD NEW OFFER</h2>
      <form action="/admin/offers" method="POST" class="add-category-form flex flex-wrap -mx-2">
  <div class="w-full px-2">
    <label for="name">Offer Name:</label>
    <input type="text" id="name" name="name" required class="mt-1" placeholder="e.g., Onam Sale" />
  </div>
  <div class="w-full px-2">
    <label for="discountPercentage">Discount Percentage (%):</label>
    <input type="number" id="discountPercentage" name="discountPercentage" required min="1" max="95" class="mt-1" placeholder="e.g., 15" />
  </div>
  <div class="w-full md:w-1/2 px-2">
    <label for="startDate">Start Date:</label>
    <input type="date" id="startDate" name="startDate" required class="mt-1"  min="<%= new Date().toISOString().split('T')[0] %>"  onchange="document.getElementById('endDate').min = this.value"/>
  </div>
  <div class="w-full md:w-1/2 px-2">
    <label for="endDate">End Date:</label>
    <input type="date" id="endDate" name="endDate" required class="mt-1" />
  </div>
  
  <div class="w-full px-2 mt-4">
    <label for="applicable_on_category">Apply to Categories (Optional):</label>
    <select name="applicable_on_category" id="applicable_on_category" multiple class="mt-1 h-24 w-full border border-gray-300 rounded-md">
      <% categories.forEach(category => { %>
        <option value="<%= category._id %>"><%= category.name %></option>
      <% }) %>
    </select>
  </div>

  <div class="w-full px-2 mt-4">
    <label for="applicable_on_product">Apply to Products (Optional):</label>
    <select name="applicable_on_product" id="applicable_on_product" multiple class="mt-1 h-24 w-full border border-gray-300 rounded-md">
      <% products.forEach(product => { %>
        <option value="<%= product._id %>"><%= product.title %></option>
      <% }) %>
    </select>
  </div>

  <div class="w-full px-2 mt-4">
    <label for="applicable_on_brand">Apply to Brands (Optional):</label>
    <select name="applicable_on_brand" id="applicable_on_brand" multiple class="mt-1 h-24 w-full border border-gray-300 rounded-md">
      <% brands.forEach(brand => { %>
        <option value="<%= brand._id %>"><%= brand.name %></option>
      <% }) %>
    </select>
  </div>

  <button type="submit" class="bg-green-500 hover:bg-green-600 text-white font-bold py-3 px-6 rounded-lg mt-6 w-full mx-2 transition-colors duration-200 text-lg">
    <i class="fas fa-plus-circle mr-2"></i> Add Offer
  </button>
</form>
    </div>
  </div>
</div>

<div id="editModal" class="modal">
  <div class="modal-content">
    <span class="close" onclick="closeModal()">&times;</span>
    <h2 class="text-2xl font-bold mb-2">Edit Offer</h2>
   <form id="editOfferForm" method="POST">
  <input type="hidden" name="_method" value="PUT">
  <label for="editName">Offer Name:</label>
  <input type="text" id="editName" name="name" required class="mt-1 mb-1" />

  <label for="editDiscount">Discount Percentage (%):</label>
  <input type="number" id="editDiscount" name="discountPercentage" required min="1" max="95" class="mt-1 mb-1" />

  <label for="editStartDate">Start Date:</label>
  <input type="date" id="editStartDate" name="startDate" required class="mt-1 mb-1" />

  <label for="editEndDate">End Date:</label>
  <input type="date" id="editEndDate" name="endDate" required class="mt-1 mb-1" />

  <label for="edit_applicable_on_category">Apply to Categories:</label>
  <select name="applicable_on_category" id="edit_applicable_on_category" multiple class="mt-1 h-24 w-full border border-gray-300 rounded-md">
      <% categories.forEach(category => { %>
          <option value="<%= category._id %>"><%= category.name %></option>
      <% }) %>
  </select>

  <label for="edit_applicable_on_product" class="mt-1">Apply to Products:</label>
  <select name="applicable_on_product" id="edit_applicable_on_product" multiple class="mt-1 h-24 w-full border border-gray-300 rounded-md">
      <% products.forEach(product => { %>
          <option value="<%= product._id %>"><%= product.title %></option>
      <% }) %>
  </select>

  <label for="edit_applicable_on_brand" class="mt-1">Apply to Brands:</label>
  <select name="applicable_on_brand" id="edit_applicable_on_brand" multiple class="mt-1 h-24 w-full border border-gray-300 rounded-md">
      <% brands.forEach(brand => { %>
          <option value="<%= brand._id %>"><%= brand.name %></option>
      <% }) %>
  </select>
  
  <button type="submit" class="bg-purple-600 hover:bg-purple-700 text-white font-bold py-3 px-6 rounded-lg w-full transition-colors duration-200 text-lg mt-4">
    <i class="fas fa-save mr-2"></i> Update Offer
  </button>
</form>
  </div>
</div>

<script>
    // --- Global variables to hold our Choices.js instances for the Edit Modal ---
    let categoryChoices, productChoices, brandChoices;

    // --- This function now uses the Choices.js API to populate the modal ---
    function openEditModal(buttonElement, name, discount, startDate, endDate) {
       const id = buttonElement.dataset.id;
  const categories = JSON.parse(buttonElement.dataset.categories);
  const products = JSON.parse(buttonElement.dataset.products);
  const brands = JSON.parse(buttonElement.dataset.brands);
        // Populate basic input fields
        document.getElementById("editName").value = name;
        document.getElementById("editDiscount").value = discount;
        document.getElementById("editStartDate").value = startDate;
        document.getElementById("editEndDate").value = endDate;
        document.getElementById("editOfferForm").action = `/admin/offers/${id}`;

        // Use the Choices.js API to cleanly set the selected values.
        // The .map(String) is important to ensure IDs are compared as strings.
        categoryChoices.setChoiceByValue(categories.map(String));
        productChoices.setChoiceByValue(products.map(String));
        brandChoices.setChoiceByValue(brands.map(String));

        // Show the modal
        document.getElementById("editModal").style.display = "flex";
    }

    function closeModal() {
        document.getElementById("editModal").style.display = "none";
    }

    window.onclick = function (event) {
        const modal = document.getElementById("editModal");
        if (event.target == modal) {
            modal.style.display = "none";
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        // --- Initialize Choices.js on all our select elements ---
        const defaultOptions = {
            removeItemButton: true,
            placeholder: true,
            placeholderValue: 'Select one or more options...',
            searchPlaceholderValue: 'Search here...',
        };
        
        // Initialize for the 'Edit Offer' modal and store instances in our global variables
        categoryChoices = new Choices('#edit_applicable_on_category', defaultOptions);
        productChoices = new Choices('#edit_applicable_on_product', defaultOptions);
        brandChoices = new Choices('#edit_applicable_on_brand', defaultOptions);

        // Initialize for the 'Add New Offer' form (no need to store instances)
        new Choices('#applicable_on_category', defaultOptions);
        new Choices('#applicable_on_product', defaultOptions);
        new Choices('#applicable_on_brand', defaultOptions);

        // --- SweetAlert2 for session messages ---
        const serverMessage = <%- JSON.stringify(message) || 'null' %>;
        if (serverMessage) {
            Swal.fire({
                icon: serverMessage.type,
                title: serverMessage.type.charAt(0).toUpperCase() + serverMessage.type.slice(1),
                text: serverMessage.text,
                timer: 3500,
                timerProgressBar: true,
                showConfirmButton: false
            });
        }

        // --- SweetAlert2 for delete confirmation ---
        document.querySelectorAll('.delete-offer-btn').forEach(button => {
            button.addEventListener('click', (e) => {
                const buttonEl = e.currentTarget;
                const offerId = buttonEl.dataset.offerId;
                
                Swal.fire({
                    title: 'Are you sure?',
                    text: "This action cannot be undone!",
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.isConfirmed) {
                        axios.delete(`/admin/offers/${offerId}`)
                            .then(response => {
                                if (response.data.success) {
                                    buttonEl.closest('tr').remove();
                                    Swal.fire('Deleted!', response.data.message, 'success');
                                } else {
                                    Swal.fire('Error!', response.data.message, 'error');
                                }
                            })
                            .catch(error => {
                                Swal.fire('Error!', 'Failed to delete the offer.', 'error');
                                console.error('Delete Offer Error:', error);
                            });
                    }
                });
            });
        });
    });
</script>

</body>
</html>