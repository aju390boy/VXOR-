<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Orders</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
   <link rel="stylesheet" href="/styles/admin/adminnavbar.css">
  <link rel="stylesheet" href="/styles/admin/adminsidebar.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar styles for a clean theme */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9; /* Light background */
        }
        ::-webkit-scrollbar-thumb {
            background: #94a3b8; /* Gray thumb */
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        .main-content-div{
          margin-left: 240px;
          margin-top: 50px;
        }
       
.status-PENDING {
  background-color: #fbbf24; /* Yellow */
  color: #92400e;
}
.status-PROCESSING {
  background-color: #717473; /* Gray */
  color: white;
}
.status-COMPLETED {
  background-color: #a7f3d0; /* Light Green */
  color: #065f46;
}
.status-FAILED {
  background-color: #f87171; /* Red */
  color: #b91c1c;
}
.status-REFUNDED {
  background-color: #c7d2fe; /* Light Indigo */
  color: #3730a3;
}
.concern-CANCELLATION {
        background-color: #fcd34d; /* Yellow-300 */
        color: #92400e; /* Darker Yellow/Brown */
    }
    .concern-RETURN {
        background-color: #f97316; /* Orange-600 */
        color: white;
    }
    .concern-NONE {
        background-color: #d1d5db; /* Gray-300 */
        color: #374151; /* Dark Gray */
    }
    </style>
</head>
<body class="bg-gray-100 text-gray-800 min-h-screen">
    <div class="flex h-screen">
        <%- include('../partials/admin/adminsidebar', { current: 'orders' }) %>
        <div class="flex-1 flex flex-col overflow-hidden">
            <%- include('../partials/admin/adminnavbar') %>
            <main class="main-content-div flex-1 w-[85%] overflow-x-hidden overflow-y-auto bg-gray-100 p-4 md:p-8">
<div class="breadcrumb mb-4">
    <a href="/admin/dashboard">Admin</a> > 
    <a href="/admin/orders">Orders</a>
</div>
                <header class="mb-8">
                    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">ORDERS MANAGEMENT</h1>
                    <p class="text-gray-700">View, manage, and track all customer orders.</p>
                </header>
                <div class="bg-white rounded-xl p-4 md:p-6 shadow-lg border border-gray-200 mb-6">
                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                        <div class="md:col-span-2">
                            <label for="order-search" class="block text-sm font-medium text-gray-700">Search Orders</label>
                            <input type="text" id="order-search" placeholder="Search by Order ID or User"
                                class="mt-1 block w-full bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-purple-500 focus:border-purple-500 text-sm px-4 py-2 text-gray-800">
                        </div>
                        <div>
                            <label for="payment-status-filter" class="block text-sm font-medium text-gray-700">Filter by Payment Status</label>
                            <select id="payment-status-filter" class="mt-1 block w-full bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-purple-500 focus:border-purple-500 text-sm px-4 py-2 text-gray-800">
                                <option value="" >All Payment Statuses</option>
                                <option value="PENDING">PENDING</option>
                                <option value="PROCESSING">PROCESSING</option>
                                <option value="COMPLETED">COMPLETED</option>
                                <option value="FAILED">FAILED</option>
                                <option value="REFUNDED">REFUNDED</option>
                            </select>
                        </div>
                        <div>
                            <label for="order-sort" class="block text-sm font-medium text-gray-700">Sort by</label>
                            <select id="order-sort" class="mt-1 block w-full bg-gray-50 border border-gray-300 rounded-lg shadow-sm focus:ring-purple-500 focus:border-purple-500 text-sm px-4 py-2 text-gray-800">
                                <option value="date-desc">Order Date (Newest)</option>
                                <option value="date-asc">Order Date (Oldest)</option>
                            </select>
                        </div>
                        <div class="col-span-full mt-4 md:mt-0">
                            <button id="clear-search-btn" class="w-full md:w-auto px-4 py-2 bg-purple-900 text-white font-medium rounded-lg shadow-sm hover:bg-purple-800 focus:outline-none focus:ring-2 focus:ring-purple-500 transition-colors">
                                Clear Filters
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Orders Table -->
                <div class="bg-white rounded-xl p-4 md:p-6 shadow-lg border border-gray-200 overflow-x-auto">
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-50">
                            <tr>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order ID</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order Date</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Total Amount</th>
                                <th scope="col" class="status-row px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider"> Payment Status</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Concerns</th>
                                <th scope="col" class="px-4 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="orders-table-body" class="divide-y divide-gray-200">
                            <!-- Orders will be dynamically injected here  -->
                        </tbody>
                    </table>
                    <div id="loading-state" class="text-center py-8 text-gray-500">
                        <p>Loading orders...</p>
                    </div>
                    <div id="no-data-state" class="text-center py-8 text-gray-500 hidden">
                        <p>No orders found matching your criteria.</p>
                    </div>
                </div>

                <!-- Pagination -->
                <div id="pagination-controls" class="flex justify-between items-center mt-6">
                    <button id="prev-page-btn" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg shadow-sm hover:bg-gray-300 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                        Previous
                    </button>
                    <span id="page-info" class="text-sm text-gray-500">Page 1 of 1</span>
                    <button id="next-page-btn" class="px-4 py-2 bg-gray-200 text-gray-700 rounded-lg shadow-sm hover:bg-gray-300 disabled:opacity-50 disabled:cursor-not-allowed transition-colors">
                        Next
                    </button>
                </div>
            </main>
        </div>
    </div>

    
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.getElementById('order-search');
        const paymentStatusFilter = document.getElementById('payment-status-filter');
        const sortSelect = document.getElementById('order-sort');
        const clearBtn = document.getElementById('clear-search-btn');
        const ordersTableBody = document.getElementById('orders-table-body');
        const loadingState = document.getElementById('loading-state');
        const noDataState = document.getElementById('no-data-state');
        const prevPageBtn = document.getElementById('prev-page-btn');
        const nextPageBtn = document.getElementById('next-page-btn');
        const pageInfoSpan = document.getElementById('page-info');
        
        let currentPage = 1;
        const pageSize = 2; 
        let totalOrders = 0;
        const paymentStatusOptions = ["PENDING","PROCESSING", "COMPLETED", "FAILED", "REFUNDED"];
        const showSwal = (icon, title, text) => {
        Swal.fire({
            icon: icon,
            title: title,
            text: text,
            confirmButtonText: 'OK',
            customClass: {
                popup: 'swal-dark-bg',
                title: 'swal-dark-title',
                content: 'swal-dark-content',
                confirmButton: 'swal-dark-button'
            }
        });
    };
        const fetchAndRenderOrders = async () => {
            loadingState.classList.remove('hidden');
            ordersTableBody.innerHTML = '';
            noDataState.classList.add('hidden');
            const searchQuery = searchInput.value;
            const paymentStatus = paymentStatusFilter.value;
            const sort = sortSelect.value;
            try {
                const response = await fetch(`/admin/orders/api?page=${currentPage}&limit=${pageSize}&search=${searchQuery}&paymentStatus=${paymentStatus}&sort=${sort}`);
                if (!response.ok) {
                    throw new Error("Failed to fetch orders.");
                }
                const data = await response.json();
                totalOrders = data.total;
                const orders = data.orders;
                if (orders.length > 0) {
                    orders.forEach(order => {
                        const row = createOrderRow(order);
                        ordersTableBody.appendChild(row);
                    });
                    ordersTableBody.classList.remove('hidden');
                } else {
                    ordersTableBody.classList.add('hidden');
                    noDataState.classList.remove('hidden');
                }
            } catch (error) {
                console.error("Failed to fetch orders:", error);
                noDataState.innerHTML = '<p class="text-red-400">Failed to load orders. Please try again.</p>';
                noDataState.classList.remove('hidden');
            } finally {
                loadingState.classList.add('hidden');
                updatePaginationControls();
            }
          };
          const getStatusClass = (status) => {
            return status.toUpperCase().replace(/\s/g, '-');
        };
        //////create order row/////////
         const createOrderRow = (order) => {
    const row = document.createElement('tr');
    row.classList.add('hover:bg-gray-100', 'transition-colors', 'duration-200');
    const orderIdCell = document.createElement('td');
    orderIdCell.className = "px-4 py-4 whitespace-nowrap text-sm font-medium text-gray-900";
    orderIdCell.textContent = order.orderId; 
    const dateCell = document.createElement('td');
    dateCell.className = "px-4 py-4 whitespace-nowrap text-sm text-gray-500";
    dateCell.textContent = new Date(order.createdAt).toLocaleDateString('en-IN', {
        day: 'numeric', month: 'short', year: 'numeric'
    });
    const userCell = document.createElement('td');
    userCell.className = "px-4 py-4 whitespace-nowrap text-sm text-gray-500";
    userCell.innerHTML = `
        ${order.user.name}<br>
        <span class="text-xs text-gray-400">${order.user.email}</span>
    `; 
    const totalCell = document.createElement('td');
    totalCell.className = "px-4 py-4 whitespace-nowrap text-sm font-medium text-gray-900";
    totalCell.textContent = new Intl.NumberFormat('en-IN', {
        style: 'currency', currency: 'INR'
    }).format(order.total_amount);
    const statusCell = document.createElement('td');
    statusCell.className = "px-4 py-4 whitespace-nowrap";
    const paymentStatus = order.payment_status || 'N/A';
    const statusClass = `status-${paymentStatus.toUpperCase()}`;
    statusCell.innerHTML = `
    <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${statusClass}">
        ${paymentStatus}
    </span>
`;
    const concernCell = document.createElement('td');
    concernCell.className = "px-4 py-4 whitespace-nowrap";
    const concernValue = order.concern ? order.concern.toUpperCase() : 'NONE'; 
    const concernClass = `concern-${concernValue}`;
    concernCell.innerHTML = `
        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium ${concernClass}">
            ${concernValue}
        </span>
    `; 
    const actionsCell = document.createElement('td');
    actionsCell.className = "px-4 py-4 whitespace-nowrap text-sm font-medium";
    const viewBtn = document.createElement('button');
    viewBtn.className = "view-btn text-gray-100 bg-gradient-to-r from-indigo-300 to-purple-600 rounded-md p-1 hover:text-purple-800 transition-colors";
    viewBtn.textContent = 'View';
    viewBtn.dataset.orderId = order._id;
    actionsCell.appendChild(viewBtn);
    row.append(orderIdCell, dateCell, userCell, totalCell, statusCell,concernCell, actionsCell);
    viewBtn.addEventListener('click', () => {
        window.location.href = `/admin/orders/api/${viewBtn.dataset.orderId}`;
    });
    return row;
};
/////create order row end/////////
        const updatePaginationControls = () => {
            const totalPages = Math.ceil(totalOrders / pageSize);
            pageInfoSpan.textContent = `Page ${currentPage} of ${totalPages || 1}`;
            prevPageBtn.disabled = currentPage === 1;
            nextPageBtn.disabled = currentPage >= totalPages;
        };
        const debounce = (func, delay) => {
        let timeoutId;
        return (...args) => {
            clearTimeout(timeoutId);
            timeoutId = setTimeout(() => {
                func.apply(this, args);
            }, delay);
        };
    };
        searchInput.addEventListener('keyup', debounce(() => {
        currentPage = 1;
        fetchAndRenderOrders();
    }, 500)); 
        paymentStatusFilter.addEventListener('change', () => {
            currentPage = 1;
            fetchAndRenderOrders();
        });
        sortSelect.addEventListener('change', () => {
            currentPage = 1;
            fetchAndRenderOrders();
        });
        clearBtn.addEventListener('click', () => {
            searchInput.value = '';
         paymentStatusFilter.value = '';
            sortSelect.value = 'date-desc';
            currentPage = 1;
            fetchAndRenderOrders();
        });
        prevPageBtn.addEventListener('click', () => {
            if (currentPage > 1) {
                currentPage--;
                fetchAndRenderOrders();
            }
        });
        nextPageBtn.addEventListener('click', () => {
            if (currentPage * pageSize < totalOrders) {
                currentPage++;
                fetchAndRenderOrders();
            }
        });
        fetchAndRenderOrders();
    });
</script>
</body>
</html>