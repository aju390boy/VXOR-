<!-- File: views/admin/dashboard.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/styles/admin/adminnavbar.css">
  <link rel="stylesheet" href="/styles/admin/adminsidebar.css">
  <link rel="stylesheet" href="/styles/admin/dashboard.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body class="bg-gray-100 text-gray-800 min-h-screen">
    <!-- Overall Layout Container -->
    <div class="flex h-screen">
        <!-- Sidebar - Fixed on the left -->
        <%- include('../partials/admin/adminsidebar', { current: 'orders' }) %>

        <!-- Main Content Area (Navbar and Order Management) -->
        <div class="flex-1 flex flex-col overflow-hidden">
            <!-- Navbar - Fixed on top -->
            <%- include('../partials/admin/adminnavbar') %>
            
            <!-- Main Content Wrapper -->
            <main class="main-content-div flex-1 w-[55%] overflow-x-hidden overflow-y-auto bg-gray-100 p-4 md:p-8">
                <div class="breadcrumb mb-4 text-gray-500">Admin > Dashboard</div>

                <header class="mb-8">
                    <h1 class="text-3xl md:text-4xl font-bold text-gray-900 mb-2">DASHBOARD</h1>
                    <p class="text-gray-700">Analytics and overview of your store.</p>
                </header>

                <div class="dashboard-cards grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
                    <!-- Total Sales Card -->
                    <div class="card bg-white p-6 rounded-xl shadow-lg border border-gray-200">
                        <div class="card-title text-sm font-semibold text-gray-500 uppercase">Total Sales</div>
                        <h2 class="text-3xl font-extrabold text-gray-900 mt-1">₹<%= totalSales %></h2>
                        <div class="progress-left mt-2 text-sm text-gray-600">This Month</div>
                    </div>

                    <!-- Customer Count Card -->
                    <div class="card bg-white p-6 rounded-xl shadow-lg border border-gray-200">
                        <div class="card-title text-sm font-semibold text-gray-500 uppercase">Customers</div>
                        <h2 class="text-3xl font-extrabold text-gray-900 mt-1"><%= customerCount %></h2>
                        <div class="progress-left mt-2 text-sm text-gray-600">Total Registered Users</div>
                    </div>

                    <!-- Orders Count Card -->
                    <div class="card bg-white p-6 rounded-xl shadow-lg border border-gray-200">
                        <div class="card-title text-sm font-semibold text-gray-500 uppercase">Orders</div>
                        <h2 class="text-3xl font-extrabold text-gray-900 mt-1"><%= orderCount %></h2>
                        <div class="progress-left mt-2 text-sm text-gray-600">Total Orders</div>
                    </div>
                </div>

                <div class="dashboard-bottom grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Recent Orders Section -->
                    <div class="recent-orders bg-white rounded-xl shadow-lg p-6 border border-gray-200 overflow-x-auto">
                        <div class="section-header flex justify-between items-center mb-4">
                            <h3 class="text-xl font-semibold text-gray-800">Recent Orders</h3>
                            <button class="view-all text-purple-600 font-medium text-sm hover:underline">View All</button>
                        </div>
                        <table class="min-w-full divide-y divide-gray-200">
                            <thead>
                                <tr>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Order ID</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">User</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Total</th>
                                    <th class="px-6 py-3 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">Status</th>
                                </tr>
                            </thead>
                            <tbody class="bg-white divide-y divide-gray-200">
                                <% recentOrders.forEach(order => { %>
                                    <tr>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900"><%= order._id %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= order.user_id.firstname %> <%= order.user_id.lastname %></td>
                                        <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">₹<%= order.total_amount.toFixed(2) %></td>
                                        <td class="px-6 py-4 whitespace-nowrap">
                                            <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full <%= order.status === 'DELIVERED' ? 'bg-green-100 text-green-800' : 'bg-yellow-100 text-yellow-800' %>">
                                                <%= order.status %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Best Selling Section -->
                    <div class="best-selling bg-white rounded-xl shadow-lg p-6 border border-gray-200">
                        <div class="section-header flex justify-between items-center mb-4">
                            <h3 class="text-xl font-semibold text-gray-800">Best Selling</h3>
                            <button class="view-all text-purple-600 font-medium text-sm hover:underline">View All</button>
                        </div>
                        <ul class="divide-y divide-gray-200">
                            <% bestSelling.forEach(product => { %>
                                <li class="py-3 flex items-center space-x-4">
                                    <div class="flex-shrink-0 w-16 h-16">
                                        <% const firstColorVariant = product.colorVariants.length > 0 ? product.colorVariants[0] : null; %>
                                        <img src="/uploads/products/<%= firstColorVariant?.images?.[0] || 'placeholder.png' %>" alt="<%= product.title %>" class="w-16 h-16 rounded-md object-cover">
                                    </div>
                                    <div class="flex-grow">
                                        <p class="text-sm font-medium text-gray-900"><%= product.title %></p>
                                    </div>
                                </li>
                            <% }) %>
                        </ul>
                    </div>
                </div>
            </main>
        </div>
    </div>
</body>
</html>
