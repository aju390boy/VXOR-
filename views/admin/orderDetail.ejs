<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Orders</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
   <link rel="stylesheet" href="/styles/admin/adminnavbar.css">
  <link rel="stylesheet" href="/styles/admin/adminsidebar.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar styles for a clean theme */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9; /* Light background */
        }
        ::-webkit-scrollbar-thumb {
            background: #94a3b8; /* Gray thumb */
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        .main-content-div{
          margin-left: 240px;
          margin-top: 50px;
        }
        .status-PROCESSING {
    background-color: #e2e8f0; /* Light gray */
    color: #475569; /* Slate gray */
    font-weight: 500;
}

.status-PACKED {
    background-color: #fde68a; /* Light yellow */
    color: #92400e; /* Dark orange */
    font-weight: 500;
}

.status-SHIPPED {
    background-color: #a5b4fc; /* Light indigo */
    color: #4338ca; /* Dark indigo */
    font-weight: 500;
}

.status-DELIVERED {
    background-color: #a7f3d0; /* Light green */
    color: #065f46; /* Dark green */
    font-weight: 500;
}

.status-RETURNED {
    background-color: #fca5a5; /* Light red */
    color: #b91c1c; /* Dark red */
    font-weight: 500;
}

.status-CANCELLED {
    background-color: #fee2e2; /* Light red */
    color: #b91c1c; /* Dark red */
    font-weight: 500;
}

.status-RETURN-REQUESTED {
    background-color: #fef08a; /* Light yellow */
    color: #854d0e; /* Dark yellow */
    font-weight: 500;
}
.status-PROCESSING{
  background-color: #717473;
  color: white;
  font-weight: 500;
}


    </style>
</head>
<body class="flex flex-col min-h-screen bg-gray-100">

    <!-- Navbar - Fixed on top -->
    <%- include('../partials/admin/adminnavbar') %>

    <!-- Main container for sidebar and content -->
    <div class="flex flex-grow">
        
        <!-- Sidebar on the left side of the screen -->
        <%- include('../partials/admin/adminsidebar', { current: 'orders' }) %>

        <!-- Order detail section on the right side of the screen -->
         <main class="main-content-div flex-1 w-[85%] overflow-x-hidden overflow-y-auto bg-gray-100 p-4 md:p-8">
    <div class="bg-white rounded-xl shadow-2xl p-6 md:p-8 max-w-7xl mx-auto">
        <header class="mb-8 border-b border-gray-200 pb-4">
            <h1 class="text-3xl font-bold text-gray-900">Order #<%= order._id %></h1>
            <p class="text-gray-600 mt-2">Placed on <%= new Date(order.createdAt).toLocaleDateString() %></p>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Left Column: User and Product Details -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Customer Details -->
                <div class="bg-gray-50 rounded-lg shadow-sm p-6">
                    <h2 class="text-xl font-semibold mb-4 text-gray-800 border-b border-gray-200 pb-2">Customer Details</h2>
                    <div class="text-gray-700 space-y-2">
                        <p><strong>Name:</strong> <%= order.user_id?.firstname %> <%= order.user_id?.lastname %></p>
                        <p><strong>Email:</strong> <%= order.user_id?.email %></p>
                    </div>
                </div>

                <!-- Order Items Table -->
                <div class="bg-gray-50 rounded-lg shadow-sm p-6 overflow-x-auto">
                    <h2 class="text-xl font-semibold mb-4 text-gray-800 border-b border-gray-200 pb-2">Order Items</h2>
                    <table class="min-w-full divide-y divide-gray-200">
                        <thead class="bg-gray-100">
                            <tr>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Product</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Quantity</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Price</th>
                                <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 uppercase tracking-wider">Status</th>
                            </tr>
                        </thead>
                       <tbody class="bg-white divide-y divide-gray-200">
    <% if (order.products) { %>
        <% order.products.forEach(item => { %>
            <%
                // Define the product and its color/size variants to access data
                const product = item.product_id;
                const colorVariant = product?.colorVariants?.find(c => c.colorName === item.color);
                const sizeVariant = colorVariant?.variants?.find(s => s.size === item.size);

                // Build the image path
                const imageUrl = colorVariant?.images?.[0] ? `/uploads/products/${colorVariant.images[0]}` : 'https://via.placeholder.com/96';
                
                // Get the status
                const itemStatus = item.status || order.status;
            %>
            <tr>
                <td class="px-6 py-4 whitespace-nowrap">
                    <div class="flex items-center">
                        <div class="flex-shrink-0 h-16 w-16">
                            <img class="h-16 w-16 rounded-md" src="<%= imageUrl %>" >
                        </div>
                        <div class="ml-4">
                            <div class="text-sm font-medium text-gray-900"><%= product?.title %></div>
                            <div class="text-sm text-gray-500">Size: <%= item.size %></div>
                            <div class="text-sm text-gray-500">Color: <%= item.color %></div>
                        </div>
                    </div>
                </td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-gray-500"><%= item.quantity %></td>
                <td class="px-6 py-4 whitespace-nowrap text-sm font-medium text-gray-900">₹<%= item.price %></td>
                <td class="px-6 py-4 whitespace-nowrap">
                    <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full
                        <%= itemStatus === 'DELIVERED' ? 'bg-green-100 text-green-800' :
                           itemStatus === 'SHIPPED' ? 'bg-blue-100 text-blue-800' :
                           itemStatus === 'PACKED' ? 'bg-purple-100 text-purple-800' :
                           itemStatus === 'RETURN REQUESTED' ? 'bg-yellow-100 text-yellow-800' :
                           itemStatus === 'RETURNED' ? 'bg-gray-100 text-gray-800' :
                           itemStatus === 'CANCELLED' ? 'bg-red-100 text-red-800' :
                           'bg-gray-100 text-gray-800' %>
                        ">
                        <%= itemStatus %>
                    </span>
                </td>
            </tr>
        <% }); %>
    <% } %>
</tbody>
                    </table>
                </div>
            </div>

            <!-- Right Column: Address and Summary -->
            <div class="lg:col-span-1 space-y-6">
                <!-- Delivery Address -->
                <div class="bg-gray-50 rounded-lg shadow-sm p-6">
                    <h2 class="text-xl font-semibold mb-4 text-gray-800 border-b border-gray-200 pb-2">Delivery Address</h2>
                    <% if (order.address_id) { %>
                        <div class="text-gray-700 space-y-1">
                            <p class="font-semibold text-lg text-black"><%= order.address_id?.name %></p>
                            <p class="text-gray-600"><%= order.address_id?.address1 %><% if (order.address_id?.address2) { %>, <%= order.address_id.address2 %><% } %></p>
                            <p class="text-gray-600"><%= order.address_id?.city %>, <%= order.address_id?.state %> - <%= order.address_id?.pincode %></p>
                            <p class="text-gray-600">Mobile: <%= order.address_id?.mobile %></p>
                        </div>
                    <% } else { %>
                        <p class="text-gray-500">No address provided.</p>
                    <% } %>
                </div>

                <!-- Order Summary -->
                <div class="bg-gray-50 rounded-lg shadow-sm p-6">
                    <h2 class="text-xl font-semibold mb-4 text-gray-800 border-b border-gray-200 pb-2">Order Summary</h2>
                    <div class="space-y-3 text-sm">
                        <div class="flex justify-between">
                            <span class="text-gray-600">Subtotal</span>
                            <span class="font-medium">₹<%= order.subtotal || '0.00' %></span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Tax</span>
                            <span class="font-medium">₹<%= order.taxAmount|| '0.00' %></span>
                        </div>
                        <div class="flex justify-between">
                            <span class="text-gray-600">Shipping</span>
                            <span class="font-medium">₹<%= order.shippingCost || '0.00' %></span>
                        </div>
                        <div class="flex justify-between font-bold text-lg pt-3 border-t border-gray-200 mt-4">
                            <span class="text-black">Total</span>
                            <span class="text-black">₹<%= order.total || '0.00' %></span>
                        </div>
                    </div>
                </div>

                <!-- Actions Section -->
                <div class="bg-gray-50 rounded-lg shadow-sm p-6">
                    <h2 class="text-xl font-semibold mb-4 text-gray-800 border-b border-gray-200 pb-2">Order Actions</h2>
                    <div class="flex flex-col space-y-3">
                        <!-- Conditional buttons for Cancel or Return -->
                        <% if (order.status === 'RETURN REQUESTED') { %>
                            <div class="p-4 bg-yellow-50 rounded-lg border border-yellow-300">
                                <p class="text-yellow-800 font-semibold mb-2">Return Request Reason:</p>
                                <p class="text-sm text-yellow-700"><%= order.request_reason %></p>
                            </div>
                            <div class="flex gap-2">
                                <button id="approve-return-btn" class="flex-1 px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 transition-colors">
                                    Approve Return
                                </button>
                                <button id="reject-return-btn" class="flex-1 px-4 py-2 text-sm font-medium text-red-600 border border-red-600 bg-white rounded-lg hover:bg-red-50 transition-colors">
                                    Reject Return
                                </button>
                            </div>
                        <% } else if (order.status === 'PENDING') { %>
                            <button id="cancel-order-btn" class="w-full px-4 py-2 text-sm font-medium text-white bg-red-600 rounded-lg shadow-lg hover:bg-red-700 transition duration-300">
                                Cancel Order
                            </button>
                        <% } %>
                        <button id="generate-invoice-btn" class="w-full px-4 py-2 text-sm font-medium text-white bg-purple-900 rounded-lg hover:bg-purple-700 transition-colors">
                            Generate Invoice
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

    </div>

    <!-- Modals would go here -->
    <script>


        document.addEventListener('DOMContentLoaded', () => {
            const orderId = "<%= order._id %>";
            
            const cancelBtn = document.getElementById('cancel-order-btn');
            if (cancelBtn) {
                cancelBtn.addEventListener('click', () => {
                    const confirmCancel = confirm("Are you sure you want to cancel this order?");
                    if (confirmCancel) {
                        fetch(`/admin/api/orders/${orderId}/status`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ status: 'CANCELLED' })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.message) {
                                alert(data.message);
                                window.location.reload();
                            }
                        });
                    }
                });
            }

            /////sweetalert/////
            const showSwal = (icon, title, text) => {
        Swal.fire({
            icon: icon,
            title: title,
            text: text,
            confirmButtonText: 'OK',
            customClass: {
                popup: 'swal-dark-bg',
                title: 'swal-dark-title',
                content: 'swal-dark-content',
                confirmButton: 'swal-dark-button'
            }
        });
    };

            const approveReturnBtn = document.getElementById('approve-return-btn');
            if (approveReturnBtn) {
                approveReturnBtn.addEventListener('click', () => {
                    const confirmApprove = confirm("Are you sure you want to approve this return?");
                    if (confirmApprove) {
                        fetch(`/admin/api/orders/${orderId}/status`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ status: 'RETURNED' })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.message) {
                                alert(data.message);
                                window.location.reload();
                            }
                        });
                    }
                });
            }

            const rejectReturnBtn = document.getElementById('reject-return-btn');
            if (rejectReturnBtn) {
                rejectReturnBtn.addEventListener('click', () => {
                    const confirmReject = confirm("Are you sure you want to reject this return?");
                    if (confirmReject) {
                        fetch(`/admin/api/orders/${orderId}/status`, {
                            method: 'PATCH',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ status: 'REJECTED' })
                        })
                        .then(res => res.json())
                        .then(data => {
                            if (data.message) {
                                alert(data.message);
                                window.location.reload();
                            }
                        });
                    }
                });
            }
        });
    </script>
</body>
</html>