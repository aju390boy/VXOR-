<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard - Orders</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
   <link rel="stylesheet" href="/styles/admin/adminnavbar.css">
  <link rel="stylesheet" href="/styles/admin/adminsidebar.css">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');
        body {
            font-family: 'Inter', sans-serif;
        }
        /* Custom scrollbar styles for a clean theme */
        ::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        ::-webkit-scrollbar-track {
            background: #f1f5f9; /* Light background */
        }
        ::-webkit-scrollbar-thumb {
            background: #94a3b8; /* Gray thumb */
            border-radius: 4px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #64748b;
        }
        .main-content-div{
          margin-left: 240px;
          margin-top: 50px;
        }
        .status-PROCESSING {
    background-color: #e2e8f0; /* Light gray */
    color: #475569; /* Slate gray */
    font-weight: 500;
}

.status-PACKED {
    background-color: #fde68a; /* Light yellow */
    color: #92400e; /* Dark orange */
    font-weight: 500;
}

.status-SHIPPED {
    background-color: #a5b4fc; /* Light indigo */
    color: #4338ca; /* Dark indigo */
    font-weight: 500;
}

.status-DELIVERED {
    background-color: #a7f3d0; /* Light green */
    color: #065f46; /* Dark green */
    font-weight: 500;
}

.status-RETURNED {
    background-color: #fca5a5; /* Light red */
    color: #b91c1c; /* Dark red */
    font-weight: 500;
}

.status-CANCELLED {
    background-color: #fee2e2; /* Light red */
    color: #b91c1c; /* Dark red */
    font-weight: 500;
}

.status-RETURN-REQUESTED {
    background-color: #fef08a; /* Light yellow */
    color: #854d0e; /* Dark yellow */
    font-weight: 500;
}
.status-PROCESSING{
  background-color: #717473;
  color: white;
  font-weight: 500;
}


    </style>
</head>
<body class="flex flex-col min-h-screen bg-gray-100">

    <!-- Navbar - Fixed on top -->
    <%- include('../partials/admin/adminnavbar') %>

    <!-- Main container for sidebar and content -->
<div class="flex flex-grow">
    
    <%- include('../partials/admin/adminsidebar', { current: 'orders' }) %>

   <main class="main-content-div flex-1 w-[85%] overflow-x-hidden overflow-y-auto bg-slate-50 p-4 md:p-8">
    <div class="max-w-7xl mx-auto">
        <header class="mb-4">
            <a href="/admin/orders" class="text-sm font-medium text-slate-500 hover:text-purple-600 transition-colors mb-4 inline-flex items-center">
                <i class="fas fa-arrow-left mr-2"></i>
                Back to All Orders
            </a>
            <h1 class="text-3xl font-bold text-slate-800">Order #<%= order.order_id %></h1>
        </header>

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
            <div class="bg-white rounded-xl shadow-lg p-6">
                <h2 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                    <i class="fas fa-user-circle mr-3 text-purple-500"></i>
                    Customer Details
                </h2>
                <% if (order.user_id) { %>
                    <div class="space-y-1">
                        <p class="font-medium text-slate-700"><%= order.user_id.firstname %> <%= order.user_id.lastname %></p>
                        <p class="text-sm text-slate-500"><%= order.user_id.email %></p>
                    </div>
                <% } else { %>
                    <p class="text-sm text-slate-500">Customer details not available.</p>
                <% } %>
            </div>

            <div class="bg-white rounded-xl shadow-lg p-6">
                <h2 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                    <i class="fas fa-truck mr-3 text-purple-500"></i>
                    Shipping Address
                </h2>
                <% if (order.address_id) { %>
                    <div class="space-y-1 text-sm text-slate-600 leading-relaxed">
                        <p class="font-medium text-slate-800"><%= order.address_id.name %></p>
                        <p><%= order.address_id.address1 %></p>
                        <p><%= order.address_id.city %>, <%= order.address_id.state %> - <%= order.address_id.pincode %></p>
                        <p class="font-medium text-slate-800 pt-1"><i class="fas fa-phone-alt mr-2 text-xs"></i><%= order.address_id.mobile %></p>
                    </div>
                <% } else { %>
                    <p class="text-sm text-slate-500">No address provided.</p>
                <% } %>
            </div>

            <div class="bg-white rounded-xl shadow-lg p-6">
                <h2 class="text-lg font-semibold text-slate-800 mb-4 flex items-center">
                    <i class="fas fa-receipt mr-3 text-purple-500"></i>
                    Order Summary
                </h2>
                <div class="space-y-3">
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">Order Date</span>
                        <span class="font-medium text-slate-700"><%= new Date(order.createdAt).toLocaleDateString('en-GB') %></span>
                    </div>
                    <div class="flex justify-between text-sm">
                        <span class="text-slate-500">Payment Status</span>
                        <span class="px-2 py-0.5 text-xs font-bold rounded-full 
                        <%= order.payment_status === 'COMPLETED' ? 'bg-green-100 text-green-800' :
                            order.payment_status === 'PENDING' || order.payment_status === 'PROCESSING' ? 'bg-yellow-100 text-yellow-800' :
                            'bg-red-100 text-red-800' %>">
                           <%= order.payment_status %>
                        </span>
                    </div>
                     <div class="pt-2 mt-2 border-t border-slate-200 flex justify-between items-baseline">
                        <span class="text-slate-500">Tax</span>
                        <span class="font-bold text-s text-purple-700">₹<%=  order.tax %></span>
                    </div>
                    <div class="pt-2 mt-2 border-t border-slate-200 flex justify-between items-baseline">
                        <span class="font-bold text-slate-800">Total</span>
                        <span class="font-bold text-xl text-purple-700">₹<%= order.total_amount.toFixed(2) %></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="bg-white rounded-xl shadow-lg p-6 md:p-8">
            <h2 class="text-xl font-semibold text-slate-800 mb-6 flex items-center">
                <i class="fas fa-stream mr-3 text-slate-400"></i>
                Order Timeline
            </h2>
            <div class="space-y-8">
                <% if (order.products && order.products.length > 0) { %>
                    <% order.products.forEach((item, index) => { %>
                        <% const product = item.product_id; %>
                        <div class="flex gap-4">
                            <div class="flex flex-col items-center">
                                <div class="w-8 h-8 rounded-full flex items-center justify-center 
                                    <%= item.status.includes('REQUESTED') ? 'bg-yellow-500' : (item.status === 'DELIVERED' || item.status === 'RETURNED' ? 'bg-green-600' : 'bg-purple-600') %>">
                                    <i class="fas <%= item.status.includes('REQUESTED') ? 'fa-exclamation' : (item.status === 'DELIVERED' ? 'fa-check' : 'fa-box') %> text-white text-sm"></i>
                                </div>
                                <% if (index < order.products.length - 1) { %>
                                    <div class="w-px h-full bg-slate-200 mt-2"></div>
                                <% } %>
                            </div>

                            <div class="flex-1 pb-4">
                                <div class="border border-slate-200 rounded-lg p-4 transition-all hover:shadow-md">
                                    <div class="flex items-start justify-between">
                                        <div class="flex items-center gap-4">
                                             <img class="h-16 w-12 rounded-lg object-cover" src="<%= item.image %>" alt="<%= item.title %>">
                                           <div>
                                            <div class="mt-2">
                                                <h3 class="font-semibold text-slate-800"><%= product?.title || 'Product Not Found' %></h3>
                                                <p class="text-sm text-slate-500 mt-2">Qty: <%= item.quantity %> • Price: ₹<%= item.price.toFixed(2)  %> • Color:<%= item.colorName %> • Size:<%= item.size %></p>
                                            </div>
                                             <p class="font-bold text-slate-900 mt-2"> Status :
                                            <span class="px-3 py-1 text-xs font-bold rounded-full 
                                            <%= item.status === 'DELIVERED' ? 'bg-green-100 text-green-800' :
                                                item.status === 'SHIPPED' ? 'bg-blue-100 text-blue-800' :
                                                item.status.includes('REQUESTED') ? 'bg-yellow-100 text-yellow-800' :
                                                item.status === 'CANCELLED' ? 'bg-red-100 text-red-800' :
                                                'bg-slate-100 text-slate-700' %>">
                                           <%= item.status %>
                                        </span>
                                        </p>
                                        </div>
                                        
                                    </div>

                                    <%# ACTION SECTION: Appears for pending requests %>
                                    <% if (item.status === 'RETURN REQUESTED' || item.status === 'CANCELLATION REQUESTED') { %>
                                        <div class="mt-4 pt-4 border-t border-dashed border-slate-200 bg-yellow-50/70 rounded-b-lg -m-4 p-4">
                                            <div class="flex justify-between items-center">
                                                <div>
                                                    <h4 class="font-semibold text-yellow-900 text-sm">Action Required</h4>
                                                    <p class="text-sm text-yellow-800 italic mt-1">
                                                        Reason: "<%= item.status === 'RETURN REQUESTED' ? item.return_reason : item.cancellation_reason %>"
                                                    </p>
                                                </div>
                                                <div class="flex gap-2">
                                                    <button data-order-id="<%= order._id %>" data-product-id="<%= item._id %>" data-action="approve" class="action-btn px-4 py-2 text-sm font-medium text-white bg-green-600 rounded-lg hover:bg-green-700 shadow-sm">Approve</button>
                                                    <button data-order-id="<%= order._id %>" data-product-id="<%= item._id %>" data-action="reject" class="action-btn px-4 py-2 text-sm font-medium text-red-700 bg-white border border-red-300 rounded-lg hover:bg-red-50">Reject</button>
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } %>
            </div>
        </div>
    </div>
</main>
</div>
    <!-- Modals would go here -->
    <script>
document.addEventListener('DOMContentLoaded', () => {
    // Select ALL action buttons, not just one by ID
    const actionButtons = document.querySelectorAll('.action-btn');

    // Attach a click event listener to each button
    actionButtons.forEach(button => {
        button.addEventListener('click', (e) => {
            const { orderId, productId, action } = e.currentTarget.dataset;
            
            // Determine the text for the confirmation modal
            const isApprove = action === 'approve';
            const title = `Confirm ${isApprove ? 'Approval' : 'Rejection'}`;
            const text = `Are you sure you want to ${action} this request?`;
            const confirmButtonText = `Yes, ${action} it!`;

            // Use SweetAlert2 for a better UX
            Swal.fire({
                title: title,
                text: text,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: isApprove ? '#16a34a' : '#dc2626',
                cancelButtonColor: '#6b7280',
                confirmButtonText: confirmButtonText
            }).then((result) => {
                if (result.isConfirmed) {
                    // If confirmed, call the function to perform the fetch request
                    handleStatusUpdate(orderId, productId, action);
                }
            });
        });
    });

    const handleStatusUpdate = async (orderId, productId, action) => {
        try {
            const response = await fetch(`/admin/api/orders/${orderId}/products/${productId}/status`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: action })
            });

            const data = await response.json();

            if (!response.ok) {
                throw new Error(data.message || 'An unknown error occurred.');
            }

            // Show success message and then reload the page
            await Swal.fire({
                title: 'Success!',
                text: data.message,
                icon: 'success',
                timer: 2000,
                showConfirmButton: false
            });
            window.location.reload();

        } catch (error) {
            console.error('Failed to update status:', error);
            Swal.fire({
                title: 'Error!',
                text: error.message,
                icon: 'error'
            });
        }
    };
});
</script>
</body>
</html>